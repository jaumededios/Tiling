import Tiling.AxisParallel.Core

set_option linter.style.header false

/-!
# Continuous vertical-plate definitions

This module contains only the definitions underlying the continuous earthquake-plate API.  The
plate relation uses proper horizontal boundary contact and is intentionally distinct from the
existing vertex-contact plate construction.
-/

open Set
open scoped Pointwise

namespace Tiling.AxisParallel.Continuous

/-- Two translated copies of `K` have a proper horizontal boundary contact. -/
def HorizontalProperContact
    (K : Region) (s t : Tiling.Plane) : Prop :=
  ∃ a b : Tiling.Plane,
    a ≠ b ∧ a.im = b.im ∧
      openSegment ℝ a b ⊆
        (frontier (s +ᵥ K.support) ∩ frontier (t +ᵥ K.support)) \
          ((s +ᵥ K.vertices) ∪ (t +ᵥ K.vertices))

/-- The graph on translation centres generated by proper horizontal contacts. -/
def verticalPlateGraph
    (K : Region) (T : Set Tiling.Plane) : SimpleGraph T :=
  SimpleGraph.fromRel fun s t ↦ HorizontalProperContact K s.1 t.1

/-- A vertical plate is a connected component of the proper-horizontal-contact graph. -/
def VerticalPlate
    (K : Region) (T : Set Tiling.Plane) : Type :=
  (verticalPlateGraph K T).ConnectedComponent

/-- The planar translation centres belonging to a vertical plate. -/
def VerticalPlate.centres
    {K : Region} {T : Set Tiling.Plane}
    (P : VerticalPlate K T) : Set Tiling.Plane :=
  Subtype.val '' P.supp

/-- The vertical plate containing a specified translation centre. -/
def VerticalPlate.ofCentre
    {K : Region} {T : Set Tiling.Plane}
    (t : T) : VerticalPlate K T :=
  (verticalPlateGraph K T).connectedComponentMk t

/-- The regular support of all tile copies in a vertical plate. -/
def VerticalPlate.support
    {K : Region} {T : Set Tiling.Plane}
    (P : VerticalPlate K T) : Set Tiling.Plane :=
  regularSupport K P.centres

/-- The first-coordinate projection of a vertical plate's regular support. -/
def VerticalPlate.base
    {K : Region} {T : Set Tiling.Plane}
    (P : VerticalPlate K T) : Set ℝ :=
  Complex.re '' P.support

/-- A vertical plate is a column when all its centres have one first coordinate. -/
def IsVerticalColumn
    {K : Region} {T : Set Tiling.Plane}
    (P : VerticalPlate K T) : Prop :=
  ∃ x : ℝ, P.centres ⊆ {z : Tiling.Plane | z.re = x}

/-- The union of the centre sets of all vertical-column plates. -/
def verticalColumnCentres
    (K : Region) (T : Set Tiling.Plane) : Set Tiling.Plane :=
  ⋃ P : {P : VerticalPlate K T // IsVerticalColumn P}, P.1.centres

/-- The vertical plates which are not columns. -/
def nonColumnVerticalPlates
    (K : Region) (T : Set Tiling.Plane) : Set (VerticalPlate K T) :=
  {P : VerticalPlate K T | ¬ IsVerticalColumn P}

/-- A nonempty subfamily is minimal among subfamilies having regular vertical-slab support. -/
def IsMinimalVerticalSlabSubfamily
    (K : Region) (T S : Set Tiling.Plane) : Prop :=
  S.Nonempty ∧ S ⊆ T ∧
    (∃ X : Set ℝ,
      X = interior (closure X) ∧ regularSupport K S = Complex.re ⁻¹' X) ∧
    ∀ Q : Set Tiling.Plane,
      Q.Nonempty → Q ⊆ S →
        (∃ X : Set ℝ,
          X = interior (closure X) ∧ regularSupport K Q = Complex.re ⁻¹' X) →
        Q = S

/-- Shift each vertical plate independently in the imaginary direction. -/
def shiftVerticalPlates
    (K : Region) (T : Set Tiling.Plane)
    (shift : VerticalPlate K T → ℝ) : Set Tiling.Plane :=
  ⋃ P : VerticalPlate K T,
    ((((shift P : ℝ) : ℂ) * Complex.I) +ᵥ P.centres)

end Tiling.AxisParallel.Continuous
