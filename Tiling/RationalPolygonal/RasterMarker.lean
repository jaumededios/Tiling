import Tiling.RationalPolygonal.Raster

set_option linter.style.header false

/-!
# Rigid raster markers

This file implements the finite marker geometry from Section 3 of
de Dios Pont--Grebík--Greenfeld--Madrid.  Nonzero colors are represented by disjoint eight-point
rings on a grid of spacing three.  Color zero fills the rest of the square and carries the two
asymmetric protrusions and holes which force tiling translations into one coarse-lattice coset.
-/

open Filter MeasureTheory Set
open TranslationalTilings
open scoped Pointwise

namespace Tiling.RationalPolygonal

/-- Integer-plane point with the displayed coordinates. -/
def latticePoint (x y : ℤ) : IntegerPlane := ![x, y]

@[simp]
theorem latticePoint_apply_zero (x y : ℤ) : latticePoint x y 0 = x :=
  rfl

@[simp]
theorem latticePoint_apply_one (x y : ℤ) : latticePoint x y 1 = y :=
  rfl

/-- Positive horizontal unit step in the integer plane. -/
def horizontalUnit : IntegerPlane := latticePoint 1 0

/-- Positive vertical unit step in the integer plane. -/
def verticalUnit : IntegerPlane := latticePoint 0 1

/-- The transfer graph generated by moving represented lattice points one horizontal or vertical
unit.  Its vertices are the translation vectors of an exact tiling. -/
def planeTransferGraph (F : Finset IntegerPlane) (T : Set IntegerPlane) :
    SimpleGraph T :=
  SimpleGraph.fromRel fun t t' ↦
    quakeTransfer F T horizontalUnit t t' ∨
      quakeTransfer F T verticalUnit t t'

/-- Translation vectors belonging to one component of the two-direction transfer graph. -/
def planeTransferComponentTranslations {F : Finset IntegerPlane} {T : Set IntegerPlane}
    (C : (planeTransferGraph F T).ConnectedComponent) : Set IntegerPlane :=
  {t | ∃ ht : t ∈ T,
    (planeTransferGraph F T).connectedComponentMk ⟨t, ht⟩ = C}

@[simp]
theorem mem_planeTransferComponentTranslations_iff
    {F : Finset IntegerPlane} {T : Set IntegerPlane} {t : IntegerPlane}
    {C : (planeTransferGraph F T).ConnectedComponent} :
    t ∈ planeTransferComponentTranslations C ↔
      ∃ ht : t ∈ T,
        (planeTransferGraph F T).connectedComponentMk ⟨t, ht⟩ = C :=
  Iff.rfl

private theorem planeTransfer_component_eq_of_transfer
    {F : Finset IntegerPlane} {T : Set IntegerPlane} {v : IntegerPlane}
    {t t' : T} (hv : v = horizontalUnit ∨ v = verticalUnit)
    (h : quakeTransfer F T v t t') :
    (planeTransferGraph F T).connectedComponentMk t =
      (planeTransferGraph F T).connectedComponentMk t' := by
  by_cases htt : t = t'
  · exact congrArg _ htt
  apply SimpleGraph.ConnectedComponent.connectedComponentMk_eq_of_adj
  rw [planeTransferGraph, SimpleGraph.fromRel_adj]
  refine ⟨htt, Or.inl ?_⟩
  rcases hv with rfl | rfl
  · exact Or.inl h
  · exact Or.inr h

/-- A transfer-graph component carrier is invariant under either coordinate unit direction. -/
theorem planeTransferComponentCarrier_periodic
    {F : Finset IntegerPlane} {T : Set IntegerPlane}
    (hT : TilesUniverse F T)
    (C : (planeTransferGraph F T).ConnectedComponent) {v : IntegerPlane}
    (hv : v = horizontalUnit ∨ v = verticalUnit) :
    DiscretePeriodicBy
      (discreteCarrier F (planeTransferComponentTranslations C)) v := by
  intro x
  constructor
  · rintro ⟨f, hf, t, htC, hxt⟩
    obtain ⟨htT, htcomp⟩ := htC
    obtain ⟨f', hf'T, -⟩ := existsUnique_tile_representation hT x
    let t' : IntegerPlane := x - f'
    have ht'T : t' ∈ T := hf'T.2
    have hrepresentation : x = f' + t' := by
      dsimp only [t']
      abel
    let ts : T := ⟨t, htT⟩
    let ts' : T := ⟨t', ht'T⟩
    have htransfer : quakeTransfer F T v ts' ts := by
      refine ⟨f', hf'T.1, f, hf, ?_⟩
      rw [← hxt, hrepresentation]
    have hcomp' : (planeTransferGraph F T).connectedComponentMk ts' = C := by
      rw [← htcomp]
      exact planeTransfer_component_eq_of_transfer hv htransfer
    exact ⟨f', hf'T.1, t', ⟨ht'T, hcomp'⟩, hrepresentation⟩
  · rintro ⟨f, hf, t, htC, hxt⟩
    obtain ⟨htT, htcomp⟩ := htC
    obtain ⟨f', hf'T, -⟩ := existsUnique_tile_representation hT (x + v)
    let t' : IntegerPlane := x + v - f'
    have ht'T : t' ∈ T := hf'T.2
    have hrepresentation : x + v = f' + t' := by
      dsimp only [t']
      abel
    let ts : T := ⟨t, htT⟩
    let ts' : T := ⟨t', ht'T⟩
    have htransfer : quakeTransfer F T v ts ts' := by
      refine ⟨f, hf, f', hf'T.1, ?_⟩
      rw [← hrepresentation, hxt]
    have hcomp' : (planeTransferGraph F T).connectedComponentMk ts' = C := by
      rw [← htcomp]
      exact (planeTransfer_component_eq_of_transfer hv htransfer).symm
    exact ⟨f', hf'T.1, t', ⟨ht'T, hcomp'⟩, hrepresentation⟩

/-- The horizontal and vertical transfer graph of any exact nonempty lattice tiling is connected.
Indeed, each component carrier is invariant under both coordinate directions and hence, once
nonempty, equals the whole integer plane. -/
theorem planeTransferGraph_connected {F : Finset IntegerPlane}
    {T : Set IntegerPlane} (hT : TilesUniverse F T) :
    (planeTransferGraph F T).Connected := by
  obtain ⟨f₀, hf₀, hf₀Unique⟩ := existsUnique_tile_representation hT 0
  let t₀ : T := ⟨-f₀, by simpa only [zero_sub] using hf₀.2⟩
  have hF : f₀ ∈ F := hf₀.1
  rw [SimpleGraph.connected_iff]
  refine ⟨?_, ⟨t₀⟩⟩
  intro a b
  let C := (planeTransferGraph F T).connectedComponentMk a
  have hbase : f₀ + (a : IntegerPlane) ∈
      discreteCarrier F (planeTransferComponentTranslations C) := by
    refine ⟨f₀, hF, a, ⟨a.2, rfl⟩, rfl⟩
  have hh := planeTransferComponentCarrier_periodic hT C
    (v := horizontalUnit) (Or.inl rfl)
  have hv := planeTransferComponentCarrier_periodic hT C
    (v := verticalUnit) (Or.inr rfl)
  let dx : ℤ := (f₀ + (b : IntegerPlane)) 0 - (f₀ + (a : IntegerPlane)) 0
  let dy : ℤ := (f₀ + (b : IntegerPlane)) 1 - (f₀ + (a : IntegerPlane)) 1
  have hhorizontal := (hh.zsmul dx (f₀ + (a : IntegerPlane))).2 hbase
  have hboth := (hv.zsmul dy
    (f₀ + (a : IntegerPlane) + dx • horizontalUnit)).2 hhorizontal
  have hpoint : f₀ + (a : IntegerPlane) + dx • horizontalUnit + dy • verticalUnit =
      f₀ + (b : IntegerPlane) := by
    funext i
    fin_cases i
    · change f₀ 0 + (a : IntegerPlane) 0 + dx * 1 + dy * 0 =
        f₀ 0 + (b : IntegerPlane) 0
      dsimp only [dx, dy]
      simp only [Pi.add_apply]
      ring
    · change f₀ 1 + (a : IntegerPlane) 1 + dx * 0 + dy * 1 =
        f₀ 1 + (b : IntegerPlane) 1
      dsimp only [dx, dy]
      simp only [Pi.add_apply]
      ring
  rw [hpoint] at hboth
  obtain ⟨g, hg, s, hsC, heq⟩ := mem_discreteCarrier_iff.mp hboth
  obtain ⟨hsT, hscomp⟩ := hsC
  have hbs : (b : IntegerPlane) = s := by
    exact translation_eq_of_eq_representations hT hF b.2 hg hsT heq
  have hcomp : (planeTransferGraph F T).connectedComponentMk b = C := by
    have hbsSubtype : b = (⟨s, hsT⟩ : T) := Subtype.ext hbs
    rw [hbsSubtype]
    exact hscomp
  exact SimpleGraph.ConnectedComponent.eq.mp hcomp.symm

private theorem planeTransfer_walk_sub_mem_addSubgroup
    (H : AddSubgroup IntegerPlane)
    {F : Finset IntegerPlane} {T : Set IntegerPlane}
    (hedge : ∀ {v : IntegerPlane} (_hv : v = horizontalUnit ∨ v = verticalUnit)
      {t t' : T}, quakeTransfer F T v t t' →
        (t' : IntegerPlane) - (t : IntegerPlane) ∈ H)
    {t t' : T} (p : (planeTransferGraph F T).Walk t t') :
    (t' : IntegerPlane) - (t : IntegerPlane) ∈ H := by
  induction p with
  | nil => simp
  | @cons u v w huv p ih =>
      rw [planeTransferGraph, SimpleGraph.fromRel_adj] at huv
      rcases huv.2 with hforward | hbackward
      · rcases hforward with hh | hv
        · have huvMem := hedge (Or.inl rfl) hh
          have hsum := AddSubgroup.add_mem H huvMem ih
          convert hsum using 1
          abel
        · have huvMem := hedge (Or.inr rfl) hv
          have hsum := AddSubgroup.add_mem H huvMem ih
          convert hsum using 1
          abel
      · rcases hbackward with hh | hv
        · have huvMem := AddSubgroup.neg_mem H
            (hedge (Or.inl rfl) hh)
          have hsum := AddSubgroup.add_mem H huvMem ih
          convert hsum using 1
          abel
        · have huvMem := AddSubgroup.neg_mem H
            (hedge (Or.inr rfl) hv)
          have hsum := AddSubgroup.add_mem H huvMem ih
          convert hsum using 1
          abel

/-- If every unit owner transfer in an exact planar tiling preserves residue modulo the marker
lattice, then all translation vectors lie in the coarse-lattice coset of any chosen base vector. -/
theorem translations_mem_coset_of_transfer
    (H : AddSubgroup IntegerPlane)
    {F : Finset IntegerPlane} {T : Set IntegerPlane}
    (hT : TilesUniverse F T) {base : IntegerPlane} (hbase : base ∈ T)
    (hedge : ∀ {v : IntegerPlane} (_hv : v = horizontalUnit ∨ v = verticalUnit)
      {t t' : T}, quakeTransfer F T v t t' →
        (t' : IntegerPlane) - (t : IntegerPlane) ∈ H) :
    ∀ t ∈ T, t - base ∈ H := by
  intro t ht
  let b : T := ⟨base, hbase⟩
  let s : T := ⟨t, ht⟩
  have hconnected := planeTransferGraph_connected hT
  obtain ⟨p⟩ := hconnected b s
  exact planeTransfer_walk_sub_mem_addSubgroup H hedge p

/-- A closed integer-coordinate rectangle. -/
noncomputable def gridBox (x₀ x₁ y₀ y₁ : ℤ) : Finset IntegerPlane :=
  (Finset.Icc x₀ x₁ ×ˢ Finset.Icc y₀ y₁).image
    (fun p ↦ latticePoint p.1 p.2)

@[simp]
theorem mem_gridBox_iff {x₀ x₁ y₀ y₁ : ℤ} {z : IntegerPlane} :
    z ∈ gridBox x₀ x₁ y₀ y₁ ↔
      x₀ ≤ z 0 ∧ z 0 ≤ x₁ ∧ y₀ ≤ z 1 ∧ z 1 ≤ y₁ := by
  classical
  constructor
  · intro hz
    rw [gridBox, Finset.mem_image] at hz
    obtain ⟨p, hp, hpz⟩ := hz
    have hp' : p.1 ∈ Finset.Icc x₀ x₁ ∧ p.2 ∈ Finset.Icc y₀ y₁ := by
      exact Finset.mem_product.mp hp
    rw [Finset.mem_Icc, Finset.mem_Icc] at hp'
    obtain ⟨hp₀, hp₁⟩ := hp'
    subst z
    simpa only [latticePoint_apply_zero, latticePoint_apply_one] using
      ⟨hp₀.1, hp₀.2, hp₁.1, hp₁.2⟩
  · rintro ⟨hx₀, hx₁, hy₀, hy₁⟩
    rw [gridBox, Finset.mem_image]
    refine ⟨(z 0, z 1), Finset.mem_product.mpr
      ⟨Finset.mem_Icc.mpr ⟨hx₀, hx₁⟩,
        Finset.mem_Icc.mpr ⟨hy₀, hy₁⟩⟩, ?_⟩
    funext i
    fin_cases i <;> rfl

/-- Marker square side length.  Taking `k = M` is the paper's construction with a valid (though
not size-minimal) choice satisfying `M ≤ k²`. -/
def markerSide (M : ℕ) : ℕ := 3 * M + 4

/-- Center of the eight-point marker assigned to a nonzero color. -/
def markerCenter {M : ℕ} (i : Fin M) : IntegerPlane :=
  latticePoint (3 * (i : ℤ)) 3

/-- The eight-point ring around a nonzero color center. -/
noncomputable def markerRing {M : ℕ} (i : Fin M) : Finset IntegerPlane :=
  (gridBox (3 * (i : ℤ) - 1) (3 * (i : ℤ) + 1) 2 4).erase
    (markerCenter i)

/-- The unmodified `N × N` marker square. -/
noncomputable def markerSquare (M : ℕ) : Finset IntegerPlane :=
  gridBox 0 (markerSide M - 1) 0 (markerSide M - 1)

/-- The union of all nonzero-color marker rings. -/
noncomputable def nonzeroMarkerRings (M : ℕ) : Finset IntegerPlane :=
  Finset.univ.biUnion fun i : Fin M ↦
    if i.val = 0 then ∅ else markerRing i

/-- Horizontal protrusion in the distinguished color-zero marker. -/
def markerEast (M : ℕ) : IntegerPlane :=
  latticePoint (markerSide M) 1

/-- Vertical protrusion in the distinguished color-zero marker. -/
def markerNorth (M : ℕ) : IntegerPlane :=
  latticePoint 1 (markerSide M)

/-- First color-zero marker hole. -/
def markerWestHole : IntegerPlane := latticePoint 0 1

/-- Second color-zero marker hole. -/
def markerSouthHole : IntegerPlane := latticePoint 1 0

/-- Distinguished marker: square complement of all rings, with two protrusions and two holes. -/
noncomputable def markerZero (M : ℕ) : Finset IntegerPlane :=
  ((insert (markerNorth M)
    (insert (markerEast M) (markerSquare M \ nonzeroMarkerRings M))).erase
      markerWestHole).erase markerSouthHole

/-- The square after making the two asymmetric boundary holes and protrusions. -/
noncomputable def modifiedMarkerSquare (M : ℕ) : Finset IntegerPlane :=
  ((insert (markerNorth M) (insert (markerEast M) (markerSquare M))).erase
    markerWestHole).erase markerSouthHole

/-- Marker block assigned to a color. -/
noncomputable def markerBlock {M : ℕ} (i : Fin M) : Finset IntegerPlane :=
  if i.val = 0 then markerZero M else markerRing i

/-- Union of all color blocks in the marker family. -/
noncomputable def markerUnion (M : ℕ) : Finset IntegerPlane :=
  Finset.univ.biUnion fun i : Fin M ↦ markerBlock i

@[simp]
theorem markerBlock_zero {M : ℕ} (hM : 0 < M) :
    markerBlock ⟨0, hM⟩ = markerZero M := by
  simp [markerBlock]

theorem markerBlock_of_ne_zero {M : ℕ} {i : Fin M} (hi : i.val ≠ 0) :
    markerBlock i = markerRing i := by
  simp [markerBlock, hi]

/-- A nonzero-color center lies strictly inside the marker square. -/
theorem markerCenter_mem_markerSquare {M : ℕ} {i : Fin M} (hi : i.val ≠ 0) :
    markerCenter i ∈ markerSquare M := by
  rw [markerSquare, mem_gridBox_iff]
  simp only [markerCenter, latticePoint_apply_zero, latticePoint_apply_one,
    markerSide, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat]
  have hiLower : (1 : ℤ) ≤ i := by
    omega
  have hiUpper : (i : ℤ) < M := by
    exact_mod_cast i.isLt
  constructor
  · omega
  constructor
  · omega
  constructor <;> omega

/-- Each nonzero marker is exactly an eight-point ring. -/
theorem markerRing_card {M : ℕ} (i : Fin M) :
    (markerRing i).card = 8 := by
  rw [markerRing, Finset.card_erase_of_mem]
  · rw [gridBox]
    rw [Finset.card_image_of_injective]
    · have hproduct := Finset.card_product
        (Finset.Icc (3 * (i : ℤ) - 1) (3 * (i : ℤ) + 1))
        (Finset.Icc (2 : ℤ) 4)
      rw [hproduct, Int.card_Icc, Int.card_Icc]
      have hx : 3 * (i : ℤ) + 1 + 1 - (3 * (i : ℤ) - 1) = 3 := by
        ring
      rw [hx]
      decide
    · intro p q hpq
      apply Prod.ext
      · exact congrFun hpq 0
      · exact congrFun hpq 1
  · rw [mem_gridBox_iff]
    simp [markerCenter]

/-- Coordinate bounds for a point in a nonzero marker ring. -/
theorem markerRing_bounds {M : ℕ} {i : Fin M} {z : IntegerPlane}
    (hz : z ∈ markerRing i) :
    3 * (i : ℤ) - 1 ≤ z 0 ∧ z 0 ≤ 3 * (i : ℤ) + 1 ∧
      2 ≤ z 1 ∧ z 1 ≤ 4 := by
  exact mem_gridBox_iff.mp (Finset.mem_of_mem_erase hz)

/-- Rings belonging to distinct colors are disjoint. -/
theorem markerRing_disjoint {M : ℕ} {i j : Fin M} (hij : i ≠ j) :
    Disjoint (markerRing i) (markerRing j) := by
  rw [Finset.disjoint_left]
  intro z hzi hzj
  have hi := markerRing_bounds hzi
  have hj := markerRing_bounds hzj
  have hval : i.val ≠ j.val := by
    intro h
    exact hij (Fin.ext h)
  omega

/-- A nonzero-color ring is contained in the unmodified marker square. -/
theorem markerRing_subset_markerSquare {M : ℕ} {i : Fin M}
    (hi : i.val ≠ 0) :
    markerRing i ⊆ markerSquare M := by
  intro z hz
  rw [markerSquare, mem_gridBox_iff]
  have hb := markerRing_bounds hz
  have hiLower : (1 : ℤ) ≤ i := by omega
  have hiUpper : (i : ℤ) < M := by exact_mod_cast i.isLt
  simp only [markerSide, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat]
  omega

/-- A nonzero-color ring occurs in the union removed from the color-zero block. -/
theorem markerRing_subset_nonzeroMarkerRings {M : ℕ} {i : Fin M}
    (hi : i.val ≠ 0) :
    markerRing i ⊆ nonzeroMarkerRings M := by
  intro z hz
  rw [nonzeroMarkerRings, Finset.mem_biUnion]
  exact ⟨i, Finset.mem_univ i, by simp [hi, hz]⟩

/-- The two protrusions lie outside every nonzero marker ring. -/
theorem protrusions_not_mem_markerRing {M : ℕ} {i : Fin M}
    (hi : i.val ≠ 0) :
    markerEast M ∉ markerRing i ∧ markerNorth M ∉ markerRing i := by
  constructor
  · intro h
    have hb := markerRing_bounds h
    simp only [markerEast, latticePoint_apply_one] at hb
    omega
  · intro h
    have hb := markerRing_bounds h
    have hiLower : (1 : ℤ) ≤ i := by omega
    simp only [markerNorth, latticePoint_apply_zero] at hb
    omega

/-- The distinguished color-zero block is disjoint from every nonzero ring. -/
theorem markerZero_disjoint_markerRing {M : ℕ} {i : Fin M}
    (hi : i.val ≠ 0) :
    Disjoint (markerZero M) (markerRing i) := by
  rw [Finset.disjoint_left]
  intro z hz0 hzi
  have hz0' := (Finset.mem_erase.mp hz0).2
  have hz0'' := (Finset.mem_erase.mp hz0').2
  simp only [Finset.mem_insert] at hz0''
  rcases hz0'' with hNorth | hEast | hbase
  · subst z
    exact (protrusions_not_mem_markerRing hi).2 hzi
  · subst z
    exact (protrusions_not_mem_markerRing hi).1 hzi
  · have hznot : z ∉ nonzeroMarkerRings M := (Finset.mem_sdiff.mp hbase).2
    exact hznot (markerRing_subset_nonzeroMarkerRings hi hzi)

/-- Distinct color markers are pairwise disjoint. -/
theorem markerBlock_disjoint {M : ℕ} {i j : Fin M} (hij : i ≠ j) :
    Disjoint (markerBlock i) (markerBlock j) := by
  by_cases hi : i.val = 0
  · have hj : j.val ≠ 0 := by
      intro hj0
      apply hij
      apply Fin.ext
      omega
    rw [markerBlock, if_pos hi, markerBlock_of_ne_zero hj]
    exact markerZero_disjoint_markerRing hj
  · by_cases hj : j.val = 0
    · rw [markerBlock_of_ne_zero hi, markerBlock, if_pos hj]
      exact (markerZero_disjoint_markerRing hi).symm
    · rw [markerBlock_of_ne_zero hi, markerBlock_of_ne_zero hj]
      exact markerRing_disjoint hij

private theorem markerZero_subset_modifiedMarkerSquare (M : ℕ) :
    markerZero M ⊆ modifiedMarkerSquare M := by
  classical
  intro z hz
  rw [markerZero, Finset.mem_erase, Finset.mem_erase] at hz
  obtain ⟨hsouth, hwest, hbase⟩ := hz
  rw [modifiedMarkerSquare, Finset.mem_erase, Finset.mem_erase]
  refine ⟨hsouth, hwest, ?_⟩
  rcases Finset.mem_insert.mp hbase with hNorth | hrest
  · exact Finset.mem_insert.mpr (Or.inl hNorth)
  · rcases Finset.mem_insert.mp hrest with hEast | hbase'
    · exact Finset.mem_insert.mpr
        (Or.inr (Finset.mem_insert.mpr (Or.inl hEast)))
    · have hsquare : z ∈ markerSquare M := (Finset.mem_sdiff.mp hbase').1
      have hinner : z ∈ insert (markerEast M) (markerSquare M) :=
        Finset.mem_insert.mpr (Or.inr hsquare)
      exact Finset.mem_insert.mpr (Or.inr hinner)

private theorem markerRing_subset_modifiedMarkerSquare {M : ℕ} {i : Fin M}
    (hi : i.val ≠ 0) : markerRing i ⊆ modifiedMarkerSquare M := by
  classical
  intro z hz
  have hsquare := markerRing_subset_markerSquare hi hz
  have hsouth : z ≠ markerSouthHole := by
    intro hzSouth
    subst z
    have hb := markerRing_bounds hz
    simp only [markerSouthHole, latticePoint_apply_one] at hb
    omega
  have hwest : z ≠ markerWestHole := by
    intro hzWest
    subst z
    have hb := markerRing_bounds hz
    simp only [markerWestHole, latticePoint_apply_one] at hb
    omega
  rw [modifiedMarkerSquare, Finset.mem_erase, Finset.mem_erase]
  exact ⟨hsouth, hwest, Finset.mem_insert.mpr <|
    Or.inr <| Finset.mem_insert.mpr <| Or.inr hsquare⟩

private theorem markerUnion_subset_modifiedMarkerSquare {M : ℕ} :
    markerUnion M ⊆ modifiedMarkerSquare M := by
  classical
  intro z hz
  rw [markerUnion, Finset.mem_biUnion] at hz
  obtain ⟨i, -, hzi⟩ := hz
  by_cases hi : i.val = 0
  · rw [markerBlock, if_pos hi] at hzi
    exact markerZero_subset_modifiedMarkerSquare M hzi
  · rw [markerBlock_of_ne_zero hi] at hzi
    exact markerRing_subset_modifiedMarkerSquare hi hzi

private theorem modifiedMarkerSquare_subset_markerUnion {M : ℕ} (hM : 0 < M) :
    modifiedMarkerSquare M ⊆ markerUnion M := by
  classical
  intro z hz
  rw [modifiedMarkerSquare, Finset.mem_erase, Finset.mem_erase] at hz
  obtain ⟨hsouth, hwest, hmodified⟩ := hz
  rw [markerUnion, Finset.mem_biUnion]
  by_cases hrings : z ∈ nonzeroMarkerRings M
  · rw [nonzeroMarkerRings, Finset.mem_biUnion] at hrings
    obtain ⟨i, -, hi⟩ := hrings
    split at hi
    · simp at hi
    · refine ⟨i, Finset.mem_univ i, ?_⟩
      rw [markerBlock_of_ne_zero (by assumption)]
      exact hi
  · let zero : Fin M := ⟨0, hM⟩
    refine ⟨zero, Finset.mem_univ zero, ?_⟩
    rw [markerBlock_zero hM, markerZero, Finset.mem_erase, Finset.mem_erase]
    refine ⟨hsouth, hwest, ?_⟩
    rcases Finset.mem_insert.mp hmodified with hNorth | hrest
    · exact Finset.mem_insert.mpr (Or.inl hNorth)
    · rcases Finset.mem_insert.mp hrest with hEast | hsquare
      · exact Finset.mem_insert.mpr (Or.inr <| Finset.mem_insert.mpr <| Or.inl hEast)
      · exact Finset.mem_insert.mpr (Or.inr <| Finset.mem_insert.mpr <|
          Or.inr (Finset.mem_sdiff.mpr ⟨hsquare, hrings⟩))

/-- The marker blocks partition exactly the modified square used in the raster construction. -/
theorem markerUnion_eq_modifiedMarkerSquare {M : ℕ} (hM : 0 < M) :
    markerUnion M = modifiedMarkerSquare M := by
  apply Finset.Subset.antisymm
  · exact markerUnion_subset_modifiedMarkerSquare
  · exact modifiedMarkerSquare_subset_markerUnion hM

/-- The coarse lattice with step equal to the marker side length. -/
def markerLattice (M : ℕ) : AddSubgroup IntegerPlane where
  carrier := {x | ∃ q : IntegerPlane, (markerSide M : ℤ) • q = x}
  zero_mem' := ⟨0, by simp⟩
  add_mem' := by
    rintro x y ⟨qx, rfl⟩ ⟨qy, rfl⟩
    exact ⟨qx + qy, by simp only [smul_add]⟩
  neg_mem' := by
    rintro x ⟨q, rfl⟩
    exact ⟨-q, by simp only [smul_neg]⟩

@[simp]
theorem mem_markerLattice_iff {M : ℕ} {x : IntegerPlane} :
    x ∈ markerLattice M ↔
      ∃ q : IntegerPlane, (markerSide M : ℤ) • q = x :=
  Iff.rfl

/-- The ordinary marker square is a fundamental domain for the coarse lattice. -/
theorem markerSquare_tiles_markerLattice (M : ℕ) :
    TilesUniverse (markerSquare M) (markerLattice M : Set IntegerPlane) := by
  apply tilesUniverse_of_existsUnique
  intro x
  let n : ℤ := markerSide M
  have hn : 0 < n := by
    dsimp only [n, markerSide]
    omega
  let q : IntegerPlane := ![x 0 / n, x 1 / n]
  let f : IntegerPlane := latticePoint (x 0 % n) (x 1 % n)
  have hfBounds : ∀ i, 0 ≤ f i ∧ f i < n := by
    intro i
    fin_cases i
    · exact ⟨Int.emod_nonneg _ hn.ne', Int.emod_lt_of_pos _ hn⟩
    · exact ⟨Int.emod_nonneg _ hn.ne', Int.emod_lt_of_pos _ hn⟩
  refine ⟨f, ?_, ?_⟩
  · constructor
    · rw [markerSquare, mem_gridBox_iff]
      have h0 := hfBounds 0
      have h1 := hfBounds 1
      dsimp only [n] at h0 h1
      constructor
      · exact h0.1
      constructor
      · omega
      constructor
      · exact h1.1
      · omega
    · change x - f ∈ markerLattice M
      rw [mem_markerLattice_iff]
      refine ⟨q, ?_⟩
      funext i
      fin_cases i
      · change (markerSide M : ℤ) * (x 0 / (markerSide M : ℤ)) =
          x 0 - x 0 % (markerSide M : ℤ)
        linarith [Int.emod_add_mul_ediv (x 0) (markerSide M : ℤ)]
      · change (markerSide M : ℤ) * (x 1 / (markerSide M : ℤ)) =
          x 1 - x 1 % (markerSide M : ℤ)
        linarith [Int.emod_add_mul_ediv (x 1) (markerSide M : ℤ)]
  · intro g hg
    rw [markerSquare, mem_gridBox_iff] at hg
    obtain ⟨q', hq'⟩ := mem_markerLattice_iff.mp hg.2
    have hcoord : ∀ i, x i % n = g i := by
      intro i
      have hbounds : 0 ≤ g i ∧ g i < n := by
        fin_cases i
        · change 0 ≤ g 0 ∧ g 0 < n
          dsimp only [n]
          omega
        · change 0 ≤ g 1 ∧ g 1 < n
          dsimp only [n]
          omega
      have heq : g i + n * q' i = x i := by
        have h := congrFun hq' i
        simp only [Pi.smul_apply, smul_eq_mul] at h
        change (markerSide M : ℤ) * q' i = x i - g i at h
        dsimp only [n]
        linarith
      exact ((Int.ediv_emod_unique hn).mpr
        ⟨heq, hbounds.1, hbounds.2⟩).2
    funext i
    fin_cases i
    · exact (hcoord 0).symm
    · exact (hcoord 1).symm

/-- Replace the two boundary holes of the ordinary square by the corresponding protrusions. -/
def markerSquareReplacement (M : ℕ) (z : IntegerPlane) : IntegerPlane :=
  if z = markerWestHole then markerEast M
  else if z = markerSouthHole then markerNorth M
  else z

private theorem markerWestHole_mem_markerSquare (M : ℕ) :
    markerWestHole ∈ markerSquare M := by
  rw [markerSquare, mem_gridBox_iff]
  simp only [markerWestHole, latticePoint_apply_zero, latticePoint_apply_one, markerSide]
  omega

private theorem markerSouthHole_mem_markerSquare (M : ℕ) :
    markerSouthHole ∈ markerSquare M := by
  rw [markerSquare, mem_gridBox_iff]
  simp only [markerSouthHole, latticePoint_apply_zero, latticePoint_apply_one, markerSide]
  omega

private theorem markerEast_not_mem_markerSquare (M : ℕ) :
    markerEast M ∉ markerSquare M := by
  rw [markerSquare, mem_gridBox_iff]
  simp only [markerEast, latticePoint_apply_zero, latticePoint_apply_one, markerSide]
  omega

private theorem markerNorth_not_mem_markerSquare (M : ℕ) :
    markerNorth M ∉ markerSquare M := by
  rw [markerSquare, mem_gridBox_iff]
  simp only [markerNorth, latticePoint_apply_zero, latticePoint_apply_one, markerSide]
  omega

private theorem markerEast_ne_markerNorth (M : ℕ) :
    markerEast M ≠ markerNorth M := by
  intro h
  have h0 := congrFun h 0
  simp only [markerEast, markerNorth, latticePoint_apply_zero, markerSide] at h0
  omega

private theorem markerWestHole_ne_markerSouthHole :
    markerWestHole ≠ markerSouthHole := by
  intro h
  have h0 := congrFun h 0
  simp only [markerWestHole, markerSouthHole, latticePoint_apply_zero] at h0
  omega

private theorem markerEast_ne_markerWestHole (M : ℕ) :
    markerEast M ≠ markerWestHole := by
  intro h
  have h0 := congrFun h 0
  simp only [markerEast, markerWestHole, latticePoint_apply_zero, markerSide] at h0
  omega

private theorem markerEast_ne_markerSouthHole (M : ℕ) :
    markerEast M ≠ markerSouthHole := by
  intro h
  have h0 := congrFun h 0
  simp only [markerEast, markerSouthHole, latticePoint_apply_zero, markerSide] at h0
  omega

private theorem markerNorth_ne_markerWestHole (M : ℕ) :
    markerNorth M ≠ markerWestHole := by
  intro h
  have h1 := congrFun h 1
  simp only [markerNorth, markerWestHole, latticePoint_apply_one, markerSide] at h1
  omega

private theorem markerNorth_ne_markerSouthHole (M : ℕ) :
    markerNorth M ≠ markerSouthHole := by
  intro h
  have h1 := congrFun h 1
  simp only [markerNorth, markerSouthHole, latticePoint_apply_one, markerSide] at h1
  omega

private theorem markerSquareReplacement_west (M : ℕ) :
    markerSquareReplacement M markerWestHole = markerEast M := by
  rw [markerSquareReplacement, if_pos rfl]

private theorem markerSquareReplacement_south (M : ℕ) :
    markerSquareReplacement M markerSouthHole = markerNorth M := by
  rw [markerSquareReplacement, if_neg markerWestHole_ne_markerSouthHole.symm, if_pos rfl]

private theorem markerSquareReplacement_of_ne (M : ℕ) {z : IntegerPlane}
    (hwest : z ≠ markerWestHole) (hsouth : z ≠ markerSouthHole) :
    markerSquareReplacement M z = z := by
  rw [markerSquareReplacement, if_neg hwest, if_neg hsouth]

private theorem markerEast_mem_modifiedMarkerSquare (M : ℕ) :
    markerEast M ∈ modifiedMarkerSquare M := by
  rw [modifiedMarkerSquare, Finset.mem_erase, Finset.mem_erase]
  exact ⟨markerEast_ne_markerSouthHole M, markerEast_ne_markerWestHole M,
    Finset.mem_insert.mpr (Or.inr (Finset.mem_insert_self ..))⟩

private theorem markerNorth_mem_modifiedMarkerSquare (M : ℕ) :
    markerNorth M ∈ modifiedMarkerSquare M := by
  rw [modifiedMarkerSquare, Finset.mem_erase, Finset.mem_erase]
  exact ⟨markerNorth_ne_markerSouthHole M, markerNorth_ne_markerWestHole M,
    Finset.mem_insert_self ..⟩

private theorem markerSquareReplacement_injectiveOn (M : ℕ) :
    Set.InjOn (markerSquareReplacement M) (markerSquare M) := by
  intro x hx y hy hxy
  by_cases hxWest : x = markerWestHole
  · subst x
    by_cases hyWest : y = markerWestHole
    · exact hyWest.symm
    · by_cases hySouth : y = markerSouthHole
      · subst y
        rw [markerSquareReplacement_west, markerSquareReplacement_south] at hxy
        exact (markerEast_ne_markerNorth M hxy).elim
      · rw [markerSquareReplacement_west,
          markerSquareReplacement_of_ne M hyWest hySouth] at hxy
        exfalso
        apply markerEast_not_mem_markerSquare M
        rw [hxy]
        exact hy
  · by_cases hxSouth : x = markerSouthHole
    · subst x
      by_cases hyWest : y = markerWestHole
      · subst y
        rw [markerSquareReplacement_south, markerSquareReplacement_west] at hxy
        exact (markerEast_ne_markerNorth M hxy.symm).elim
      · by_cases hySouth : y = markerSouthHole
        · exact hySouth.symm
        · rw [markerSquareReplacement_south,
            markerSquareReplacement_of_ne M hyWest hySouth] at hxy
          exfalso
          apply markerNorth_not_mem_markerSquare M
          rw [hxy]
          exact hy
    · by_cases hyWest : y = markerWestHole
      · subst y
        rw [markerSquareReplacement_of_ne M hxWest hxSouth,
          markerSquareReplacement_west] at hxy
        exfalso
        apply markerEast_not_mem_markerSquare M
        rw [← hxy]
        exact hx
      · by_cases hySouth : y = markerSouthHole
        · subst y
          rw [markerSquareReplacement_of_ne M hxWest hxSouth,
            markerSquareReplacement_south] at hxy
          exfalso
          apply markerNorth_not_mem_markerSquare M
          rw [← hxy]
          exact hx
        · rw [markerSquareReplacement_of_ne M hxWest hxSouth,
            markerSquareReplacement_of_ne M hyWest hySouth] at hxy
          exact hxy

private theorem image_markerSquareReplacement (M : ℕ) :
    (markerSquare M).image (markerSquareReplacement M) = modifiedMarkerSquare M := by
  classical
  ext z
  constructor
  · intro hz
    rw [Finset.mem_image] at hz
    obtain ⟨x, hx, rfl⟩ := hz
    by_cases hxWest : x = markerWestHole
    · subst x
      rw [markerSquareReplacement_west]
      exact markerEast_mem_modifiedMarkerSquare M
    · by_cases hxSouth : x = markerSouthHole
      · subst x
        rw [markerSquareReplacement_south]
        exact markerNorth_mem_modifiedMarkerSquare M
      · rw [markerSquareReplacement_of_ne M hxWest hxSouth]
        rw [modifiedMarkerSquare, Finset.mem_erase, Finset.mem_erase]
        exact ⟨hxSouth, hxWest, Finset.mem_insert.mpr <|
          Or.inr <| Finset.mem_insert.mpr <| Or.inr hx⟩
  · intro hz
    rw [modifiedMarkerSquare, Finset.mem_erase, Finset.mem_erase] at hz
    obtain ⟨hzSouth, hzWest, hz⟩ := hz
    rw [Finset.mem_image]
    rcases Finset.mem_insert.mp hz with hNorth | hz
    · refine ⟨markerSouthHole, markerSouthHole_mem_markerSquare M, ?_⟩
      rw [markerSquareReplacement_south, hNorth]
    · rcases Finset.mem_insert.mp hz with hEast | hzSquare
      · refine ⟨markerWestHole, markerWestHole_mem_markerSquare M, ?_⟩
        rw [markerSquareReplacement_west, hEast]
      · refine ⟨z, hzSquare, ?_⟩
        exact markerSquareReplacement_of_ne M hzWest hzSouth

private theorem markerSquareReplacement_sub_mem_markerLattice
    (M : ℕ) {z : IntegerPlane} (hz : z ∈ markerSquare M) :
    markerSquareReplacement M z - z ∈ markerLattice M := by
  rw [mem_markerLattice_iff]
  by_cases hzWest : z = markerWestHole
  · subst z
    refine ⟨latticePoint 1 0, ?_⟩
    rw [markerSquareReplacement_west]
    funext i
    fin_cases i <;>
      simp [markerWestHole, markerEast, markerSide, latticePoint, Pi.smul_apply]
  · by_cases hzSouth : z = markerSouthHole
    · subst z
      refine ⟨latticePoint 0 1, ?_⟩
      rw [markerSquareReplacement_south]
      funext i
      fin_cases i <;>
        simp [markerSouthHole, markerNorth, markerSide, latticePoint, Pi.smul_apply]
    · refine ⟨0, ?_⟩
      rw [markerSquareReplacement_of_ne M hzWest hzSouth]
      simp only [smul_zero, sub_self]

private theorem tilesUniverse_image_of_sub_mem_periods
    {G : Type*} [AddCommGroup G] [DecidableEq G] (H : AddSubgroup G)
    (F : Finset G) (e : G → G)
    (hdiff : ∀ f ∈ F, e f - f ∈ H)
    (hF : TilesUniverse F (H : Set G)) :
    TilesUniverse (F.image e) (H : Set G) := by
  classical
  apply tilesUniverse_of_existsUnique
  intro x
  obtain ⟨f, hf, hfunique⟩ := existsUnique_tile_representation hF x
  refine ⟨e f, ?_, ?_⟩
  · constructor
    · exact Finset.mem_image.mpr ⟨f, hf.1, rfl⟩
    · have hneg : f - e f ∈ H := by
        simpa only [neg_sub] using (H.neg_mem (hdiff f hf.1))
      have hadd := H.add_mem hf.2 hneg
      change x - e f ∈ H
      convert hadd using 1
      abel
  · intro g hg
    obtain ⟨g₀, hg₀F, hg₀g⟩ := Finset.mem_image.mp hg.1
    have hsourceTranslation : x - g₀ ∈ H := by
      have hadd := H.add_mem hg.2 (hdiff g₀ hg₀F)
      rw [← hg₀g] at hadd
      convert hadd using 1
      abel
    have hg₀f := hfunique g₀ ⟨hg₀F, hsourceTranslation⟩
    rw [← hg₀g, hg₀f]

/-- The paper's modified square also tiles by the coarse marker lattice. -/
theorem modifiedMarkerSquare_tiles_markerLattice (M : ℕ) :
    TilesUniverse (modifiedMarkerSquare M) (markerLattice M : Set IntegerPlane) := by
  rw [← image_markerSquareReplacement M]
  exact tilesUniverse_image_of_sub_mem_periods (markerLattice M) (markerSquare M)
    (markerSquareReplacement M)
    (fun f hf ↦ markerSquareReplacement_sub_mem_markerLattice M hf)
    (markerSquare_tiles_markerLattice M)

/-- Scale a lattice vector by the marker side length. -/
def markerScale (M : ℕ) (x : IntegerPlane) : IntegerPlane :=
  (markerSide M : ℤ) • x

@[simp]
theorem markerScale_zero (M : ℕ) : markerScale M 0 = 0 := by
  simp [markerScale]

@[simp]
theorem markerScale_add (M : ℕ) (x y : IntegerPlane) :
    markerScale M (x + y) = markerScale M x + markerScale M y := by
  simp only [markerScale, smul_add]

@[simp]
theorem markerScale_sub (M : ℕ) (x y : IntegerPlane) :
    markerScale M (x - y) = markerScale M x - markerScale M y := by
  simp only [markerScale, smul_sub]

/-- Scaling by a marker side length is injective. -/
theorem markerScale_injective (M : ℕ) : Function.Injective (markerScale M) := by
  intro x y hxy
  funext i
  have hi := congrFun hxy i
  simp only [markerScale, Pi.smul_apply, smul_eq_mul] at hi
  apply mul_left_cancel₀ (show (markerSide M : ℤ) ≠ 0 by
    simp only [markerSide]
    omega)
  exact hi

/-- Scale a translation set to the coarse marker lattice. -/
def markerTranslationSet (M : ℕ) (T : Set IntegerPlane) : Set IntegerPlane :=
  markerScale M '' T

/-- Pull a translation set on the fine lattice back through marker scaling. -/
def markerPreimage (M : ℕ) (U : Set IntegerPlane) : Set IntegerPlane :=
  {q | markerScale M q ∈ U}

@[simp]
theorem mem_markerTranslationSet_iff {M : ℕ} {T : Set IntegerPlane}
    {x : IntegerPlane} :
    x ∈ markerTranslationSet M T ↔ ∃ t ∈ T, markerScale M t = x :=
  Iff.rfl

@[simp]
theorem mem_markerPreimage_iff {M : ℕ} {U : Set IntegerPlane}
    {q : IntegerPlane} :
    q ∈ markerPreimage M U ↔ markerScale M q ∈ U :=
  Iff.rfl

/-- Scaling the pullback recovers any translation set contained in the coarse marker lattice. -/
theorem markerTranslationSet_markerPreimage_eq_of_subset {M : ℕ}
    {U : Set IntegerPlane} (hU : U ⊆ markerLattice M) :
    markerTranslationSet M (markerPreimage M U) = U := by
  ext x
  constructor
  · rintro ⟨q, hq, rfl⟩
    exact hq
  · intro hx
    obtain ⟨q, hq⟩ := mem_markerLattice_iff.mp (hU hx)
    have hq' : markerScale M q = x := hq
    refine ⟨q, ?_, hq'⟩
    change markerScale M q ∈ U
    rw [hq']
    exact hx

/-- Replace each point of color tile `i` by a scaled copy of its marker block. -/
noncomputable def planarRasterTile {M : ℕ}
    (tile : Fin M → Finset IntegerPlane) : Finset IntegerPlane :=
  Finset.univ.biUnion fun i ↦
    (tile i).biUnion fun f ↦
      (markerBlock i).image fun s ↦ markerScale M f + s

@[simp]
theorem mem_planarRasterTile_iff {M : ℕ}
    {tile : Fin M → Finset IntegerPlane} {x : IntegerPlane} :
    x ∈ planarRasterTile tile ↔
      ∃ i : Fin M, ∃ f ∈ tile i, ∃ s ∈ markerBlock i,
        markerScale M f + s = x := by
  classical
  simp only [planarRasterTile, Finset.mem_biUnion, Finset.mem_univ, true_and,
    Finset.mem_image]

private theorem existsUnique_markerBlock {M : ℕ} (hM : 0 < M)
    {s : IntegerPlane} (hs : s ∈ modifiedMarkerSquare M) :
    ∃! i : Fin M, s ∈ markerBlock i := by
  have hsUnion : s ∈ markerUnion M := by
    rw [markerUnion_eq_modifiedMarkerSquare hM]
    exact hs
  rw [markerUnion, Finset.mem_biUnion] at hsUnion
  obtain ⟨i, -, hsi⟩ := hsUnion
  refine ⟨i, hsi, ?_⟩
  intro j hsj
  by_contra hij
  have hij' : i ≠ j := Ne.symm hij
  have hnot : s ∉ markerBlock j :=
    (Finset.disjoint_left.mp (markerBlock_disjoint hij')) hsi
  exact hnot hsj

/-- Every color marker contains at least one lattice point. -/
theorem markerBlock_nonempty {M : ℕ} (_hM : 0 < M) (i : Fin M) :
    (markerBlock i).Nonempty := by
  by_cases hi : i.val = 0
  · refine ⟨markerEast M, ?_⟩
    rw [markerBlock, if_pos hi, markerZero, Finset.mem_erase, Finset.mem_erase]
    exact ⟨markerEast_ne_markerSouthHole M, markerEast_ne_markerWestHole M,
      Finset.mem_insert.mpr (Or.inr (Finset.mem_insert_self ..))⟩
  · rw [markerBlock_of_ne_zero hi, Finset.nonempty_iff_ne_empty]
    intro hempty
    have hcard := markerRing_card i
    rw [hempty] at hcard
    simp at hcard

/-- A common tiling by all colors produces a tiling by the single planar raster tile, with the
translation set scaled to the coarse marker lattice. -/
theorem planarRasterTile_tilesUniverse_of_family {M : ℕ} (hM : 0 < M)
    (tile : Fin M → Finset IntegerPlane) (T : Set IntegerPlane)
    (hfamily : ∀ i, TilesUniverse (tile i) T) :
    TilesUniverse (planarRasterTile tile) (markerTranslationSet M T) := by
  apply tilesUniverse_of_existsUnique
  intro x
  obtain ⟨s, hs, hsUnique⟩ :=
    existsUnique_tile_representation (modifiedMarkerSquare_tiles_markerLattice M) x
  obtain ⟨q, hq⟩ := mem_markerLattice_iff.mp hs.2
  change markerScale M q = x - s at hq
  obtain ⟨i, hsi, hiUnique⟩ := existsUnique_markerBlock hM hs.1
  obtain ⟨f, hf, hfUnique⟩ := existsUnique_tile_representation (hfamily i) q
  let r : IntegerPlane := markerScale M f + s
  refine ⟨r, ?_, ?_⟩
  · constructor
    · exact mem_planarRasterTile_iff.mpr ⟨i, f, hf.1, s, hsi, rfl⟩
    · rw [mem_markerTranslationSet_iff]
      refine ⟨q - f, hf.2, ?_⟩
      rw [markerScale_sub, hq]
      dsimp only [r]
      abel
  · intro r' hr'
    obtain ⟨j, g, hgj, s', hs'j, hr'Eq⟩ := mem_planarRasterTile_iff.mp hr'.1
    obtain ⟨t, htT, htEq⟩ := mem_markerTranslationSet_iff.mp hr'.2
    have hs'Modified : s' ∈ modifiedMarkerSquare M := by
      rw [← markerUnion_eq_modifiedMarkerSquare hM, markerUnion,
        Finset.mem_biUnion]
      exact ⟨j, Finset.mem_univ j, hs'j⟩
    have hxSubS' : x - s' ∈ markerLattice M := by
      rw [mem_markerLattice_iff]
      refine ⟨g + t, ?_⟩
      change markerScale M (g + t) = x - s'
      rw [markerScale_add, htEq, ← hr'Eq]
      abel
    have hs's : s' = s := hsUnique s' ⟨hs'Modified, hxSubS'⟩
    have hji : j = i := by
      apply hiUnique j
      rwa [hs's] at hs'j
    subst j
    have hqg : q - g ∈ T := by
      have hscaled : markerScale M (q - g) = markerScale M t := by
        rw [markerScale_sub, hq, htEq, ← hr'Eq, hs's]
        abel
      have : q - g = t := markerScale_injective M hscaled
      rwa [this]
    have hgf : g = f := hfUnique g ⟨hgj, hqg⟩
    rw [← hr'Eq, hgf, hs's]

/-- A tiling by the planar raster tile whose translations lie in the coarse marker lattice
decodes to one common translation set tiling every color tile. -/
theorem family_tilesUniverse_of_planarRasterTile {M : ℕ} (hM : 0 < M)
    (tile : Fin M → Finset IntegerPlane) (T : Set IntegerPlane)
    (hraster : TilesUniverse (planarRasterTile tile) (markerTranslationSet M T)) :
    ∀ i, TilesUniverse (tile i) T := by
  intro i
  apply tilesUniverse_of_existsUnique
  intro x
  obtain ⟨s, hsi⟩ := markerBlock_nonempty hM i
  let X : IntegerPlane := markerScale M x + s
  obtain ⟨r, hr, hrUnique⟩ := existsUnique_tile_representation hraster X
  obtain ⟨j, g, hgj, s', hs'j, hrEq⟩ := mem_planarRasterTile_iff.mp hr.1
  obtain ⟨t, htT, htEq⟩ := mem_markerTranslationSet_iff.mp hr.2
  have hsModified : s ∈ modifiedMarkerSquare M := by
    rw [← markerUnion_eq_modifiedMarkerSquare hM, markerUnion, Finset.mem_biUnion]
    exact ⟨i, Finset.mem_univ i, hsi⟩
  have hs'Modified : s' ∈ modifiedMarkerSquare M := by
    rw [← markerUnion_eq_modifiedMarkerSquare hM, markerUnion, Finset.mem_biUnion]
    exact ⟨j, Finset.mem_univ j, hs'j⟩
  have hXSubS : X - s ∈ markerLattice M := by
    rw [mem_markerLattice_iff]
    refine ⟨x, ?_⟩
    dsimp only [X]
    abel
  have hXSubS' : X - s' ∈ markerLattice M := by
    rw [mem_markerLattice_iff]
    refine ⟨g + t, ?_⟩
    change markerScale M (g + t) = X - s'
    rw [markerScale_add, htEq, ← hrEq]
    abel
  obtain ⟨chosen, hchosen, hchosenUnique⟩ :=
    existsUnique_tile_representation (modifiedMarkerSquare_tiles_markerLattice M) X
  have hss' : s = s' :=
    (hchosenUnique s ⟨hsModified, hXSubS⟩).trans
      (hchosenUnique s' ⟨hs'Modified, hXSubS'⟩).symm
  have hij : i = j := by
    by_contra hij
    have hnot : s ∉ markerBlock j :=
      Finset.disjoint_left.mp (markerBlock_disjoint hij) hsi
    exact hnot (hss' ▸ hs'j)
  subst j
  have hxgt : x - g = t := by
    apply markerScale_injective M
    rw [markerScale_sub]
    calc
      markerScale M x - markerScale M g =
          (markerScale M x + s) - (markerScale M g + s') := by
            rw [hss']
            abel
      _ = X - r := by rw [hrEq]
      _ = markerScale M t := htEq.symm
  refine ⟨g, ⟨hgj, hxgt ▸ htT⟩, ?_⟩
  intro g' hg'
  let r' : IntegerPlane := markerScale M g' + s
  have hr'Tile : r' ∈ planarRasterTile tile := by
    exact mem_planarRasterTile_iff.mpr ⟨i, g', hg'.1, s, hsi, rfl⟩
  have hr'Translation : X - r' ∈ markerTranslationSet M T := by
    rw [mem_markerTranslationSet_iff]
    refine ⟨x - g', hg'.2, ?_⟩
    rw [markerScale_sub]
    dsimp only [X, r']
    abel
  have hr'r : r' = r := hrUnique r' ⟨hr'Tile, hr'Translation⟩
  apply markerScale_injective M
  dsimp only [r'] at hr'r
  have hrbase : r = markerScale M g + s := by
    rw [← hrEq, hss']
  rw [hrbase] at hr'r
  exact add_right_cancel hr'r

/-- On coarse-lattice translations, the planar raster tile is an exact one-tile encoding of a
simultaneous tiling by the finite color family. -/
theorem planarRasterTile_tilesUniverse_iff_family {M : ℕ} (hM : 0 < M)
    (tile : Fin M → Finset IntegerPlane) (T : Set IntegerPlane) :
    TilesUniverse (planarRasterTile tile) (markerTranslationSet M T) ↔
      ∀ i, TilesUniverse (tile i) T :=
  ⟨family_tilesUniverse_of_planarRasterTile hM tile T,
    planarRasterTile_tilesUniverse_of_family hM tile T⟩

/-- If the translations of a planar raster tiling lie in one coarse-lattice coset, translating
that coset to the origin and dividing by the marker scale decodes a common tiling by every color.
This packages the formal output needed from marker rigidity. -/
theorem exists_family_tiling_of_planarRasterTile_coset {M : ℕ} (hM : 0 < M)
    (tile : Fin M → Finset IntegerPlane) (U : Set IntegerPlane)
    (hraster : TilesUniverse (planarRasterTile tile) U)
    (base : IntegerPlane)
    (hcoset : ∀ u ∈ U, u - base ∈ markerLattice M) :
    ∃ T : Set IntegerPlane, ∀ i, TilesUniverse (tile i) T := by
  let U₀ : Set IntegerPlane := -base +ᵥ U
  have hU₀ : U₀ ⊆ markerLattice M := by
    intro x hx
    have hxU : base + x ∈ U := by
      simpa only [U₀, Set.mem_vadd_set_iff_neg_vadd_mem, neg_neg,
        vadd_eq_add] using hx
    have hmem := hcoset (base + x) hxU
    have heq : base + x - base = x := by abel
    rw [heq] at hmem
    exact hmem
  let T : Set IntegerPlane := markerPreimage M U₀
  have hscaled : markerTranslationSet M T = U₀ :=
    markerTranslationSet_markerPreimage_eq_of_subset hU₀
  have hraster₀ : TilesUniverse (planarRasterTile tile) U₀ := by
    exact (tilesUniverse_vadd_translationSet_iff
      (-base) (planarRasterTile tile) U).mpr hraster
  rw [← hscaled] at hraster₀
  exact ⟨T, family_tilesUniverse_of_planarRasterTile hM tile T hraster₀⟩

/-- On coarse translations, equality of carriers for the one planar raster tile is equivalent to
equality of carriers for every member of the encoded color family.  This is the discrete carrier
content of paper Lemma 3.1(iii). -/
theorem discreteCarrier_planarRaster_eq_iff {M : ℕ} (hM : 0 < M)
    (tile : Fin M → Finset IntegerPlane) (T₀ T₁ : Set IntegerPlane) :
    discreteCarrier (planarRasterTile tile) (markerTranslationSet M T₀) =
        discreteCarrier (planarRasterTile tile) (markerTranslationSet M T₁) ↔
      ∀ i, discreteCarrier (tile i) T₀ = discreteCarrier (tile i) T₁ := by
  have decode (A B : Set IntegerPlane)
      (hcarrier : discreteCarrier (planarRasterTile tile) (markerTranslationSet M A) ⊆
        discreteCarrier (planarRasterTile tile) (markerTranslationSet M B)) :
      ∀ i, discreteCarrier (tile i) A ⊆ discreteCarrier (tile i) B := by
    intro i x hx
    obtain ⟨g, hg, t, ht, hxEq⟩ := mem_discreteCarrier_iff.mp hx
    obtain ⟨s, hsi⟩ := markerBlock_nonempty hM i
    let X : IntegerPlane := markerScale M x + s
    have hX₀ : X ∈
        discreteCarrier (planarRasterTile tile) (markerTranslationSet M A) := by
      refine ⟨markerScale M g + s,
        mem_planarRasterTile_iff.mpr ⟨i, g, hg, s, hsi, rfl⟩,
        markerScale M t, ⟨t, ht, rfl⟩, ?_⟩
      dsimp only [X]
      rw [hxEq, markerScale_add]
      abel
    obtain ⟨r, hr, u, hu, hXEq⟩ :=
      mem_discreteCarrier_iff.mp (hcarrier hX₀)
    obtain ⟨j, g', hg', s', hs'j, hrEq⟩ :=
      mem_planarRasterTile_iff.mp hr
    obtain ⟨t', ht', ht'Eq⟩ := mem_markerTranslationSet_iff.mp hu
    have hsModified : s ∈ modifiedMarkerSquare M := by
      rw [← markerUnion_eq_modifiedMarkerSquare hM, markerUnion,
        Finset.mem_biUnion]
      exact ⟨i, Finset.mem_univ i, hsi⟩
    have hs'Modified : s' ∈ modifiedMarkerSquare M := by
      rw [← markerUnion_eq_modifiedMarkerSquare hM, markerUnion,
        Finset.mem_biUnion]
      exact ⟨j, Finset.mem_univ j, hs'j⟩
    have hXSubS : X - s ∈ markerLattice M := by
      rw [mem_markerLattice_iff]
      exact ⟨x, by dsimp only [X]; abel⟩
    have hXSubS' : X - s' ∈ markerLattice M := by
      rw [mem_markerLattice_iff]
      refine ⟨g' + t', ?_⟩
      change markerScale M (g' + t') = X - s'
      rw [markerScale_add, ht'Eq]
      calc
        markerScale M g' + u = (markerScale M g' + s') + u - s' := by abel
        _ = r + u - s' := by rw [hrEq]
        _ = X - s' := by rw [← hXEq]
    obtain ⟨chosen, hchosen, hchosenUnique⟩ :=
      existsUnique_tile_representation (modifiedMarkerSquare_tiles_markerLattice M) X
    have hss' : s = s' :=
      (hchosenUnique s ⟨hsModified, hXSubS⟩).trans
        (hchosenUnique s' ⟨hs'Modified, hXSubS'⟩).symm
    have hij : i = j := by
      by_contra hij
      have hnot : s ∉ markerBlock j :=
        Finset.disjoint_left.mp (markerBlock_disjoint hij) hsi
      exact hnot (hss' ▸ hs'j)
    subst j
    have hxEq' : x = g' + t' := by
      apply markerScale_injective M
      calc
        markerScale M x = X - s := by dsimp only [X]; abel
        _ = X - s' := by rw [hss']
        _ = markerScale M (g' + t') := by
          rw [markerScale_add, ht'Eq]
          calc
            X - s' = r + u - s' := by rw [hXEq]
            _ = (markerScale M g' + s') + u - s' := by rw [hrEq]
            _ = markerScale M g' + u := by abel
    exact mem_discreteCarrier_iff.mpr ⟨g', hg', t', ht', hxEq'⟩
  have encode (A B : Set IntegerPlane)
      (hfamily : ∀ i, discreteCarrier (tile i) A ⊆ discreteCarrier (tile i) B) :
      discreteCarrier (planarRasterTile tile) (markerTranslationSet M A) ⊆
        discreteCarrier (planarRasterTile tile) (markerTranslationSet M B) := by
    intro X hX
    obtain ⟨r, hr, u, hu, hXEq⟩ := mem_discreteCarrier_iff.mp hX
    obtain ⟨i, g, hg, s, hsi, hrEq⟩ := mem_planarRasterTile_iff.mp hr
    obtain ⟨t, ht, htEq⟩ := mem_markerTranslationSet_iff.mp hu
    have hgt₀ : g + t ∈ discreteCarrier (tile i) A :=
      ⟨g, hg, t, ht, rfl⟩
    obtain ⟨g', hg', t', ht', hgtEq⟩ :=
      mem_discreteCarrier_iff.mp (hfamily i hgt₀)
    refine ⟨markerScale M g' + s,
      mem_planarRasterTile_iff.mpr ⟨i, g', hg', s, hsi, rfl⟩,
      markerScale M t', ⟨t', ht', rfl⟩, ?_⟩
    calc
      X = r + u := hXEq
      _ = (markerScale M g + s) + markerScale M t := by rw [hrEq, htEq]
      _ = markerScale M (g + t) + s := by rw [markerScale_add]; abel
      _ = markerScale M (g' + t') + s := by rw [hgtEq]
      _ = (markerScale M g' + s) + markerScale M t' := by
        rw [markerScale_add]
        abel
  constructor
  · intro hcarrier i
    apply Set.Subset.antisymm
    · exact decode T₀ T₁ (by rw [hcarrier]) i
    · exact decode T₁ T₀ (by rw [hcarrier]) i
  · intro hfamily
    apply Set.Subset.antisymm
    · exact encode T₀ T₁ (fun i ↦ by rw [hfamily i])
    · exact encode T₁ T₀ (fun i ↦ by rw [hfamily i])

section ColoredRaster

/-- Package a finite family of lattice tiles as one tile in `ℤ² × ZMod M`, with the second
coordinate recording the color. -/
noncomputable def coloredRasterTile {M : ℕ}
    (tile : Fin M → Finset IntegerPlane) :
    Finset (IntegerPlane × ZMod M) :=
  Finset.univ.biUnion fun i ↦
    (tile i).image fun z ↦ (z, (i : ZMod M))

@[simp]
theorem mem_coloredRasterTile_iff {M : ℕ}
    {tile : Fin M → Finset IntegerPlane} {p : IntegerPlane × ZMod M} :
    p ∈ coloredRasterTile tile ↔
      ∃ i : Fin M, p.1 ∈ tile i ∧ (i : ZMod M) = p.2 := by
  classical
  simp only [coloredRasterTile, Finset.mem_biUnion, Finset.mem_univ, true_and,
    Finset.mem_image]
  constructor
  · rintro ⟨i, z, hz, hzp⟩
    exact ⟨i, hzp ▸ hz, congrArg Prod.snd hzp⟩
  · rintro ⟨i, hi, hcolor⟩
    exact ⟨i, p.1, hi, Prod.ext rfl hcolor⟩

/-- Embed one common translation set in the zero-color layer. -/
def coloredTranslations {M : ℕ} (T : Set IntegerPlane) :
    Set (IntegerPlane × ZMod M) :=
  (fun t ↦ (t, 0)) '' T

@[simp]
theorem mem_coloredTranslations_iff {M : ℕ} {T : Set IntegerPlane}
    {p : IntegerPlane × ZMod M} :
    p ∈ coloredTranslations (M := M) T ↔
      ∃ t ∈ T, (t, 0) = p :=
  Iff.rfl

/-- Distinct standard representatives give distinct elements of `ZMod M`. -/
theorem fin_cast_zmod_injective {M : ℕ} [NeZero M] :
    Function.Injective (fun i : Fin M ↦ (i : ZMod M)) := by
  intro i j hij
  apply Fin.ext
  have hval := congrArg ZMod.val hij
  simpa [ZMod.val_natCast, Nat.mod_eq_of_lt i.isLt,
    Nat.mod_eq_of_lt j.isLt] using hval

/-- A simultaneous tiling by a finite tile family is exactly a one-tile tiling in the product
group whose finite coordinate records the family member. -/
theorem coloredRasterTile_tilesUniverse_iff {M : ℕ} [NeZero M]
    (tile : Fin M → Finset IntegerPlane) (T : Set IntegerPlane) :
    TilesUniverse (coloredRasterTile tile) (coloredTranslations (M := M) T) ↔
      ∀ i, TilesUniverse (tile i) T := by
  constructor
  · intro hcolored i
    apply tilesUniverse_of_existsUnique
    intro x
    obtain ⟨f, hf, hfunique⟩ :=
      existsUnique_tile_representation hcolored (x, (i : ZMod M))
    obtain ⟨j, hjtile, hjcolor⟩ := mem_coloredRasterTile_iff.mp hf.1
    obtain ⟨t, htT, htEq⟩ := hf.2
    have hsecond : (i : ZMod M) - f.2 = 0 := by
      have h := congrArg Prod.snd htEq.symm
      change (i : ZMod M) - f.2 = 0 at h
      exact h
    have hfcolor : f.2 = (i : ZMod M) := (sub_eq_zero.mp hsecond).symm
    have hji : j = i := fin_cast_zmod_injective (hjcolor.trans hfcolor)
    subst j
    refine ⟨f.1, ?_, ?_⟩
    · refine ⟨hjtile, ?_⟩
      have hfirst : x - f.1 = t := by
        have h := congrArg Prod.fst htEq.symm
        change x - f.1 = t at h
        exact h
      rwa [hfirst]
    · intro g hg
      let candidate : IntegerPlane × ZMod M := (g, (i : ZMod M))
      have hcTile : candidate ∈ coloredRasterTile tile := by
        exact mem_coloredRasterTile_iff.mpr ⟨i, hg.1, rfl⟩
      have hcTranslation : (x, (i : ZMod M)) - candidate ∈
          coloredTranslations (M := M) T := by
        refine ⟨x - g, hg.2, ?_⟩
        ext
        · rfl
        · simp [candidate]
      have hcf : candidate = f := hfunique candidate ⟨hcTile, hcTranslation⟩
      exact congrArg Prod.fst hcf
  · intro hfamily
    apply tilesUniverse_of_existsUnique
    rintro ⟨x, c⟩
    let i : Fin M := ⟨c.val, ZMod.val_lt c⟩
    have hic : (i : ZMod M) = c := by
      simpa only [i] using ZMod.natCast_zmod_val c
    obtain ⟨z, hz, hzunique⟩ :=
      existsUnique_tile_representation (hfamily i) x
    let f : IntegerPlane × ZMod M := (z, c)
    refine ⟨f, ?_, ?_⟩
    · constructor
      · exact mem_coloredRasterTile_iff.mpr ⟨i, hz.1, hic⟩
      · refine ⟨x - z, hz.2, ?_⟩
        ext
        · rfl
        · simp [f]
    · intro g hg
      obtain ⟨j, hgtile, hjcolor⟩ := mem_coloredRasterTile_iff.mp hg.1
      obtain ⟨t, htT, htEq⟩ := hg.2
      have hgcolor : g.2 = c := by
        have : c - g.2 = 0 := by
          have h := congrArg Prod.snd htEq.symm
          change c - g.2 = 0 at h
          exact h
        exact (sub_eq_zero.mp this).symm
      have hji : j = i := by
        apply fin_cast_zmod_injective
        exact hjcolor.trans (hgcolor.trans hic.symm)
      subst j
      have hfirst : x - g.1 = t := by
        have h := congrArg Prod.fst htEq.symm
        change x - g.1 = t at h
        exact h
      have hgz : g.1 = z := by
        apply hzunique g.1
        exact ⟨hgtile, hfirst ▸ htT⟩
      apply Prod.ext
      · exact hgz
      · exact hgcolor

end ColoredRaster

namespace PolygonalRegion

/-- Number of positive-measure signatures of the polygonal region. -/
noncomputable def relevantSignatureCount (K : PolygonalRegion) : ℕ :=
  K.relevantSignatures.card

/-- Canonical enumeration of the positive-measure signatures. -/
noncomputable def relevantSignatureAt (K : PolygonalRegion)
    (i : Fin K.relevantSignatureCount) : Finset IntegerPlane :=
  ((K.relevantSignatures.equivFin).symm i).1

/-- Every enumerated signature belongs to the relevant finite family. -/
theorem relevantSignatureAt_mem (K : PolygonalRegion)
    (i : Fin K.relevantSignatureCount) :
    K.relevantSignatureAt i ∈ K.relevantSignatures :=
  ((K.relevantSignatures.equivFin).symm i).2

/-- Every relevant signature occurs in the canonical enumeration. -/
theorem exists_relevantSignatureAt_eq (K : PolygonalRegion)
    {F : Finset IntegerPlane} (hF : F ∈ K.relevantSignatures) :
    ∃ i, K.relevantSignatureAt i = F := by
  let s : K.relevantSignatures := ⟨F, hF⟩
  refine ⟨K.relevantSignatures.equivFin s, ?_⟩
  change ((K.relevantSignatures.equivFin).symm
    (K.relevantSignatures.equivFin s)).1 = F
  rw [Equiv.symm_apply_apply]

/-- The relevant signature family is nonempty, so its color group has positive order. -/
theorem relevantSignatureCount_pos (K : PolygonalRegion) :
    0 < K.relevantSignatureCount := by
  rw [relevantSignatureCount, Finset.card_pos]
  exact K.relevantSignatures_nonempty

/-- One finite tile in the product group encoding all positive-measure signatures. -/
noncomputable def relevantColoredRasterTile (K : PolygonalRegion) :
    Finset (IntegerPlane × ZMod K.relevantSignatureCount) :=
  coloredRasterTile K.relevantSignatureAt

/-- A canonical positive-measure signature containing a lattice point. -/
noncomputable def distinguishedRelevantSignature (K : PolygonalRegion) :
    {F // F ∈ K.relevantSignatures} :=
  ⟨Classical.choose K.exists_nonempty_relevantSignature,
    (Classical.choose_spec K.exists_nonempty_relevantSignature).1⟩

/-- The distinguished signature is nonempty. -/
theorem distinguishedRelevantSignature_nonempty (K : PolygonalRegion) :
    (K.distinguishedRelevantSignature : Finset IntegerPlane).Nonempty :=
  (Classical.choose_spec K.exists_nonempty_relevantSignature).2

/-- The zero index in the nonempty relevant-signature enumeration. -/
def relevantSignatureZero (K : PolygonalRegion) : Fin K.relevantSignatureCount :=
  ⟨0, K.relevantSignatureCount_pos⟩

/-- Index of the distinguished nonempty signature in the original enumeration. -/
noncomputable def distinguishedRelevantIndex (K : PolygonalRegion) :
    Fin K.relevantSignatureCount :=
  Classical.choose
    (K.exists_relevantSignatureAt_eq K.distinguishedRelevantSignature.property)

/-- The distinguished index enumerates the distinguished signature. -/
theorem relevantSignatureAt_distinguishedRelevantIndex (K : PolygonalRegion) :
    K.relevantSignatureAt K.distinguishedRelevantIndex =
      K.distinguishedRelevantSignature :=
  Classical.choose_spec
    (K.exists_relevantSignatureAt_eq K.distinguishedRelevantSignature.property)

/-- Reorder the arbitrary finite enumeration so that the distinguished nonempty signature has
color zero. -/
noncomputable def relevantPlanarSignaturePermutation (K : PolygonalRegion) :
    Equiv.Perm (Fin K.relevantSignatureCount) :=
  Equiv.swap K.relevantSignatureZero K.distinguishedRelevantIndex

/-- Canonical signature enumeration used by the planar rigid marker, with a nonempty zero layer. -/
noncomputable def relevantPlanarSignatureAt (K : PolygonalRegion)
    (i : Fin K.relevantSignatureCount) : Finset IntegerPlane :=
  K.relevantSignatureAt (K.relevantPlanarSignaturePermutation i)

/-- The zero color of the planar signature enumeration is nonempty. -/
theorem relevantPlanarSignatureAt_zero_nonempty (K : PolygonalRegion) :
    (K.relevantPlanarSignatureAt K.relevantSignatureZero).Nonempty := by
  rw [relevantPlanarSignatureAt, relevantPlanarSignaturePermutation]
  simp only [Equiv.swap_apply_left]
  rw [K.relevantSignatureAt_distinguishedRelevantIndex]
  exact K.distinguishedRelevantSignature_nonempty

/-- The reordered planar enumeration still lists exactly the relevant signatures. -/
theorem relevantPlanarSignatureAt_tilesUniverse_iff
    (K : PolygonalRegion) (T : Set IntegerPlane) :
    (∀ i, TilesUniverse (K.relevantPlanarSignatureAt i) T) ↔
      ∀ F ∈ K.relevantSignatures, TilesUniverse F T := by
  constructor
  · intro h F hF
    obtain ⟨j, hj⟩ := K.exists_relevantSignatureAt_eq hF
    let i := K.relevantPlanarSignaturePermutation.symm j
    have hperm : K.relevantPlanarSignaturePermutation i = j := by
      exact K.relevantPlanarSignaturePermutation.apply_symm_apply j
    rw [← hj, ← hperm]
    exact h i
  · intro h i
    exact h (K.relevantPlanarSignatureAt i)
      (K.relevantSignatureAt_mem (K.relevantPlanarSignaturePermutation i))

/-- Equality of carriers over the reordered planar enumeration is equality over the underlying
finite family of relevant signatures. -/
theorem relevantPlanarSignatureAt_discreteCarrier_eq_iff
    (K : PolygonalRegion) (T₀ T₁ : Set IntegerPlane) :
    (∀ i, discreteCarrier (K.relevantPlanarSignatureAt i) T₀ =
        discreteCarrier (K.relevantPlanarSignatureAt i) T₁) ↔
      ∀ F ∈ K.relevantSignatures,
        discreteCarrier F T₀ = discreteCarrier F T₁ := by
  constructor
  · intro h F hF
    obtain ⟨j, hj⟩ := K.exists_relevantSignatureAt_eq hF
    let i := K.relevantPlanarSignaturePermutation.symm j
    have hperm : K.relevantPlanarSignaturePermutation i = j :=
      K.relevantPlanarSignaturePermutation.apply_symm_apply j
    rw [← hj, ← hperm]
    exact h i
  · intro h i
    exact h (K.relevantPlanarSignatureAt i)
      (K.relevantSignatureAt_mem (K.relevantPlanarSignaturePermutation i))

/-- The single planar lattice tile obtained by replacing each relevant signature point with its
color marker. -/
noncomputable def relevantPlanarRasterTile (K : PolygonalRegion) :
    Finset IntegerPlane :=
  planarRasterTile K.relevantPlanarSignatureAt

/-- Simultaneous tiling by the canonical signature enumeration is the same as simultaneous tiling
by the underlying finite set of relevant signatures. -/
theorem relevantSignatureAt_tilesUniverse_iff
    (K : PolygonalRegion) (T : Set IntegerPlane) :
    (∀ i, TilesUniverse (K.relevantSignatureAt i) T) ↔
      ∀ F ∈ K.relevantSignatures, TilesUniverse F T := by
  constructor
  · intro h F hF
    obtain ⟨i, hi⟩ := K.exists_relevantSignatureAt_eq hF
    rw [← hi]
    exact h i
  · intro h i
    exact h (K.relevantSignatureAt i) (K.relevantSignatureAt_mem i)

/-- The product-group tile tiles exactly when one translation set tiles every relevant
signature. -/
theorem relevantColoredRasterTile_tilesUniverse_iff
    (K : PolygonalRegion) (T : Set IntegerPlane) :
    TilesUniverse K.relevantColoredRasterTile
        (coloredTranslations (M := K.relevantSignatureCount) T) ↔
      ∀ F ∈ K.relevantSignatures, TilesUniverse F T := by
  let _ : NeZero K.relevantSignatureCount :=
    ⟨(K.relevantSignatureCount_pos).ne'⟩
  rw [relevantColoredRasterTile, coloredRasterTile_tilesUniverse_iff]
  exact K.relevantSignatureAt_tilesUniverse_iff T

/-- The planar marker tile is an exact encoding of all relevant signatures when translations are
restricted to the coarse marker lattice. -/
theorem relevantPlanarRasterTile_tilesUniverse_iff
    (K : PolygonalRegion) (T : Set IntegerPlane) :
    TilesUniverse K.relevantPlanarRasterTile
        (markerTranslationSet K.relevantSignatureCount T) ↔
      ∀ F ∈ K.relevantSignatures, TilesUniverse F T := by
  rw [relevantPlanarRasterTile,
    planarRasterTile_tilesUniverse_iff_family K.relevantSignatureCount_pos]
  exact K.relevantPlanarSignatureAt_tilesUniverse_iff T

/-- Equality of two coarse-translated planar raster carriers is exactly equality of every relevant
signature carrier. -/
theorem relevantPlanarRasterTile_discreteCarrier_eq_iff
    (K : PolygonalRegion) (T₀ T₁ : Set IntegerPlane) :
    discreteCarrier K.relevantPlanarRasterTile
        (markerTranslationSet K.relevantSignatureCount T₀) =
      discreteCarrier K.relevantPlanarRasterTile
        (markerTranslationSet K.relevantSignatureCount T₁) ↔
      ∀ F ∈ K.relevantSignatures,
        discreteCarrier F T₀ = discreteCarrier F T₁ := by
  rw [relevantPlanarRasterTile,
    discreteCarrier_planarRaster_eq_iff K.relevantSignatureCount_pos]
  exact K.relevantPlanarSignatureAt_discreteCarrier_eq_iff T₀ T₁

/-- Continuous integer-translation tiling is equivalent to tiling by the single colored raster
tile in the product group. -/
theorem tiles_integerPoint_image_iff_relevantColoredRasterTile
    (K : PolygonalRegion) (T : Set IntegerPlane) :
    K.Tiles (integerPoint '' T) ↔
      TilesUniverse K.relevantColoredRasterTile
        (coloredTranslations (M := K.relevantSignatureCount) T) := by
  rw [K.tiles_integerPoint_image_iff_relevantSignatures,
    K.relevantColoredRasterTile_tilesUniverse_iff]

/-- Continuous tiling by integer translations is equivalent to tiling by the single planar marker
tile along the scaled copy of the same translation set. -/
theorem tiles_integerPoint_image_iff_relevantPlanarRasterTile
    (K : PolygonalRegion) (T : Set IntegerPlane) :
    K.Tiles (integerPoint '' T) ↔
      TilesUniverse K.relevantPlanarRasterTile
        (markerTranslationSet K.relevantSignatureCount T) := by
  rw [K.tiles_integerPoint_image_iff_relevantSignatures,
    K.relevantPlanarRasterTile_tilesUniverse_iff]

/-- Equality of coarse-translated planar raster carriers implies almost-everywhere equality of the
encoded polygonal carriers. -/
theorem integerTranslationCarrier_ae_eq_of_relevantPlanarRasterTile
    (K : PolygonalRegion) {T₀ T₁ : Set IntegerPlane}
    (hcarrier :
      discreteCarrier K.relevantPlanarRasterTile
          (markerTranslationSet K.relevantSignatureCount T₀) =
        discreteCarrier K.relevantPlanarRasterTile
          (markerTranslationSet K.relevantSignatureCount T₁)) :
    K.integerTranslationCarrier T₀ =ᵐ[volume]
      K.integerTranslationCarrier T₁ := by
  apply K.integerTranslationCarrier_ae_eq_of_relevantSignatures
  exact (K.relevantPlanarRasterTile_discreteCarrier_eq_iff T₀ T₁).mp hcarrier

/-- **Paper Lemma 3.1(iii).** Equality of the two planar raster carriers along coarse marker
translations is equivalent to literal equality of the corresponding continuous polygonal
carriers.  The forward implication first gives almost-everywhere equality and then uses local
finiteness and regular closedness of arbitrary integer-translation carriers. -/
theorem relevantPlanarRasterTile_carrier_eq_iff
    (K : PolygonalRegion) (T₀ T₁ : Set IntegerPlane) :
    discreteCarrier K.relevantPlanarRasterTile
        (markerTranslationSet K.relevantSignatureCount T₀) =
      discreteCarrier K.relevantPlanarRasterTile
        (markerTranslationSet K.relevantSignatureCount T₁) ↔
      K.integerTranslationCarrier T₀ = K.integerTranslationCarrier T₁ := by
  constructor
  · intro hraster
    apply K.integerTranslationCarrier_eq_of_ae_eq
    exact K.integerTranslationCarrier_ae_eq_of_relevantPlanarRasterTile hraster
  · intro hcontinuous
    apply (K.relevantPlanarRasterTile_discreteCarrier_eq_iff T₀ T₁).mpr
    intro F hF
    have hmeasure : volume (K.signatureFiber F) ≠ 0 :=
      (K.mem_relevantSignatures_iff.mp hF).2
    obtain ⟨u, hu⟩ := nonempty_of_measure_ne_zero hmeasure
    have husignature : K.signature u = F :=
      (K.mem_signatureFiber_iff.mp hu).2
    rw [← husignature]
    ext q
    rw [← K.mem_integerTranslationCarrier_iff_mem_discreteCarrier_signature
          T₀ (x := u + integerPoint q) (q := q) rfl,
      ← K.mem_integerTranslationCarrier_iff_mem_discreteCarrier_signature
          T₁ (x := u + integerPoint q) (q := q) rfl,
      hcontinuous]

end PolygonalRegion

end Tiling.RationalPolygonal
