import Mathlib.Combinatorics.SimpleGraph.Connectivity.Connected
import Tiling.RationalPolygonal.Basic

set_option linter.style.header false

/-!
# Canonical discrete earthquake plates

For an exact tiling `F + T = G` and a direction `v`, translating a represented point by `v`
transfers it to one uniquely determined tile placement.  The connected components generated by all
such transfers are exactly the minimal subsets whose tile carriers are `v`-periodic.  This gives a
canonical construction of the earthquake decomposition in Definition 4.1 of
de Dios Pont--Grebík--Greenfeld--Madrid.
-/

open Set
open TranslationalTilings

namespace Tiling.RationalPolygonal

universe u

section DiscreteCarrier

variable {G : Type u} [AddCommGroup G]

/-- The set covered by translating a finite discrete tile along `T`. -/
def discreteCarrier (F : Finset G) (T : Set G) : Set G :=
  {x | ∃ f ∈ F, ∃ t ∈ T, x = f + t}

@[simp]
theorem mem_discreteCarrier_iff {F : Finset G} {T : Set G} {x : G} :
    x ∈ discreteCarrier F T ↔ ∃ f ∈ F, ∃ t ∈ T, x = f + t :=
  Iff.rfl

/-- Exact discrete tiling gives a unique tile element, and hence a unique translation, at every
ambient point. -/
theorem existsUnique_tile_representation {F : Finset G} {T : Set G}
    (hT : TilesUniverse F T) (x : G) :
    ∃! f : G, f ∈ F ∧ x - f ∈ T := by
  classical
  have hcard : (F.filter fun f ↦ x - f ∈ T).card = 1 := by
    have hcount :=
      (tilesAtLevel_iff_representation_count F T Set.univ 1).mp hT x
    simpa using hcount
  obtain ⟨f, hf⟩ := Finset.card_eq_one.mp hcard
  refine ⟨f, ?_, ?_⟩
  · have : f ∈ F.filter fun g ↦ x - g ∈ T := by simp [hf]
    simpa using this
  · intro g hg
    have hgm : g ∈ F.filter fun f ↦ x - f ∈ T := by simpa using hg
    simpa [hf] using hgm

/-- Two representations of a point in an exact discrete tiling use the same translation vector. -/
theorem translation_eq_of_eq_representations {F : Finset G} {T : Set G}
    (hT : TilesUniverse F T) {f g t s : G}
    (hf : f ∈ F) (ht : t ∈ T) (hg : g ∈ F) (hs : s ∈ T)
    (heq : f + t = g + s) : t = s := by
  obtain ⟨chosen, hchosen, hunique⟩ := existsUnique_tile_representation hT (f + t)
  have hfrep : f ∈ F ∧ f + t - f ∈ T := by
    refine ⟨hf, ?_⟩
    simpa only [add_sub_cancel_left] using ht
  have hgrep : g ∈ F ∧ f + t - g ∈ T := by
    refine ⟨hg, ?_⟩
    rw [heq]
    simpa only [add_sub_cancel_left] using hs
  have hfg : f = g := (hunique f hfrep).trans (hunique g hgrep).symm
  rw [hfg] at heq
  exact add_left_cancel heq

/-- Discrete membership invariance under one specified period. -/
def DiscretePeriodicBy (A : Set G) (v : G) : Prop :=
  ∀ x, x + v ∈ A ↔ x ∈ A

end DiscreteCarrier

section QuakeGraph

variable {G : Type u} [AddCommGroup G]

/-- A one-step transfer between tile placements after translating a represented point by `v`. -/
def quakeTransfer (F : Finset G) (T : Set G) (v : G) (t t' : T) : Prop :=
  ∃ f ∈ F, ∃ f' ∈ F, f + (t : G) + v = f' + (t' : G)

/-- The undirected graph generated by one-step earthquake transfers. -/
def quakeGraph (F : Finset G) (T : Set G) (v : G) : SimpleGraph T :=
  SimpleGraph.fromRel (quakeTransfer F T v)

/-- A canonical tectonic plate is a connected component of the quake graph. -/
abbrev QuakePlate (F : Finset G) (T : Set G) (v : G) :=
  (quakeGraph F T v).ConnectedComponent

/-- The translation vectors belonging to one canonical tectonic plate. -/
def quakePlateTranslations {F : Finset G} {T : Set G} {v : G}
    (C : QuakePlate F T v) : Set G :=
  {t | ∃ ht : t ∈ T,
    (quakeGraph F T v).connectedComponentMk ⟨t, ht⟩ = C}

@[simp]
theorem mem_quakePlateTranslations_iff {F : Finset G} {T : Set G} {v t : G}
    {C : QuakePlate F T v} :
    t ∈ quakePlateTranslations C ↔
      ∃ ht : t ∈ T, (quakeGraph F T v).connectedComponentMk ⟨t, ht⟩ = C :=
  Iff.rfl

/-- Every quake-graph vertex belongs to the translation set of its connected component. -/
theorem mem_quakePlateTranslations_mk {F : Finset G} {T : Set G} {v : G}
    (t : T) :
    (t : G) ∈ quakePlateTranslations
      ((quakeGraph F T v).connectedComponentMk t) :=
  ⟨t.2, rfl⟩

private theorem connectedComponentMk_eq_of_transfer
    {F : Finset G} {T : Set G} {v : G} {t t' : T}
    (h : quakeTransfer F T v t t') :
    (quakeGraph F T v).connectedComponentMk t =
      (quakeGraph F T v).connectedComponentMk t' := by
  by_cases htt : t = t'
  · exact congrArg _ htt
  apply SimpleGraph.ConnectedComponent.connectedComponentMk_eq_of_adj
  rw [quakeGraph, SimpleGraph.fromRel_adj]
  exact ⟨htt, Or.inl h⟩

/-- The carrier of one canonical earthquake plate is invariant under the earthquake direction. -/
theorem quakePlateCarrier_periodic {F : Finset G} {T : Set G} {v : G}
    (hT : TilesUniverse F T) (C : QuakePlate F T v) :
    DiscretePeriodicBy (discreteCarrier F (quakePlateTranslations C)) v := by
  intro x
  constructor
  · rintro ⟨f, hf, t, htC, hxt⟩
    obtain ⟨htT, htcomp⟩ := htC
    obtain ⟨f', hf'T, -⟩ := existsUnique_tile_representation hT x
    let t' : G := x - f'
    have ht'T : t' ∈ T := hf'T.2
    have hrepresentation : x = f' + t' := by
      dsimp only [t']
      abel
    let ts : T := ⟨t, htT⟩
    let ts' : T := ⟨t', ht'T⟩
    have htransfer : quakeTransfer F T v ts' ts := by
      refine ⟨f', hf'T.1, f, hf, ?_⟩
      rw [← hxt, hrepresentation]
    have hcomp' : (quakeGraph F T v).connectedComponentMk ts' = C := by
      rw [← htcomp]
      exact connectedComponentMk_eq_of_transfer htransfer
    exact ⟨f', hf'T.1, t', ⟨ht'T, hcomp'⟩, hrepresentation⟩
  · rintro ⟨f, hf, t, htC, hxt⟩
    obtain ⟨htT, htcomp⟩ := htC
    obtain ⟨f', hf'T, -⟩ := existsUnique_tile_representation hT (x + v)
    let t' : G := x + v - f'
    have ht'T : t' ∈ T := hf'T.2
    have hrepresentation : x + v = f' + t' := by
      dsimp only [t']
      abel
    let ts : T := ⟨t, htT⟩
    let ts' : T := ⟨t', ht'T⟩
    have htransfer : quakeTransfer F T v ts ts' := by
      refine ⟨f, hf, f', hf'T.1, ?_⟩
      rw [← hrepresentation, hxt]
    have hcomp' : (quakeGraph F T v).connectedComponentMk ts' = C := by
      rw [← htcomp]
      exact (connectedComponentMk_eq_of_transfer htransfer).symm
    exact ⟨f', hf'T.1, t', ⟨ht'T, hcomp'⟩, hrepresentation⟩

private theorem quake_subset_closed_under_adj
    {F : Finset G} {T P : Set G} {v : G}
    (hT : TilesUniverse F T) (hPT : P ⊆ T)
    (hperiod : DiscretePeriodicBy (discreteCarrier F P) v)
    {t t' : T} (htP : (t : G) ∈ P)
    (htt' : (quakeGraph F T v).Adj t t') : (t' : G) ∈ P := by
  rw [quakeGraph, SimpleGraph.fromRel_adj] at htt'
  rcases htt'.2 with hforward | hbackward
  · obtain ⟨f, hf, f', hf', heq⟩ := hforward
    have hx : f + (t : G) ∈ discreteCarrier F P :=
      ⟨f, hf, t, htP, rfl⟩
    have hxv := (hperiod (f + (t : G))).2 hx
    obtain ⟨g, hg, s, hsP, hgs⟩ := hxv
    have heq' : f' + (t' : G) = g + s := heq.symm.trans hgs
    have ht's := translation_eq_of_eq_representations hT hf' t'.2 hg (hPT hsP) heq'
    rw [ht's]
    exact hsP
  · obtain ⟨f, hf, f', hf', heq⟩ := hbackward
    have hxv : f' + (t : G) ∈ discreteCarrier F P :=
      ⟨f', hf', t, htP, rfl⟩
    have hx : f + (t' : G) ∈ discreteCarrier F P := by
      apply (hperiod (f + (t' : G))).mp
      rwa [heq]
    obtain ⟨g, hg, s, hsP, hgs⟩ := hx
    have ht's := translation_eq_of_eq_representations hT hf t'.2 hg (hPT hsP) hgs
    rw [ht's]
    exact hsP

private theorem quake_subset_closed_under_walk
    {F : Finset G} {T P : Set G} {v : G}
    (hT : TilesUniverse F T) (hPT : P ⊆ T)
    (hperiod : DiscretePeriodicBy (discreteCarrier F P) v)
    {t t' : T} (walk : (quakeGraph F T v).Walk t t')
    (htP : (t : G) ∈ P) : (t' : G) ∈ P := by
  induction walk with
  | nil => exact htP
  | cons htt' walk ih =>
      apply ih
      exact quake_subset_closed_under_adj hT hPT hperiod htP htt'

/-- A nonempty periodic subset of a canonical tectonic plate is the whole plate.  This proves the
minimality clause in paper Definition 4.1. -/
theorem quakePlate_minimal {F : Finset G} {T P : Set G} {v : G}
    (hT : TilesUniverse F T) (C : QuakePlate F T v)
    (hsub : P ⊆ quakePlateTranslations C) (hne : P.Nonempty)
    (hperiod : DiscretePeriodicBy (discreteCarrier F P) v) :
    P = quakePlateTranslations C := by
  apply Set.Subset.antisymm hsub
  obtain ⟨p, hpP⟩ := hne
  obtain ⟨hpT, hpcomp⟩ := hsub hpP
  intro t htC
  obtain ⟨htT, htcomp⟩ := htC
  let ps : T := ⟨p, hpT⟩
  let ts : T := ⟨t, htT⟩
  have hreach : (quakeGraph F T v).Reachable ps ts := by
    apply SimpleGraph.ConnectedComponent.exact
    exact hpcomp.trans htcomp.symm
  obtain ⟨walk⟩ := hreach
  have hPT : P ⊆ T := hsub.trans fun x hx ↦ Classical.choose hx
  exact quake_subset_closed_under_walk hT hPT hperiod walk hpP

/-- Canonical quake-plate translation sets partition the original tiling set. -/
theorem iUnion_quakePlateTranslations {F : Finset G} {T : Set G} {v : G} :
    (⋃ C : QuakePlate F T v, quakePlateTranslations C) = T := by
  ext t
  constructor
  · rintro ht
    obtain ⟨C, htC⟩ := Set.mem_iUnion.mp ht
    exact Classical.choose htC
  · intro ht
    apply Set.mem_iUnion.mpr
    exact ⟨(quakeGraph F T v).connectedComponentMk ⟨t, ht⟩,
      mem_quakePlateTranslations_mk ⟨t, ht⟩⟩

/-- Distinct canonical quake plates have disjoint translation sets. -/
theorem quakePlateTranslations_pairwiseDisjoint {F : Finset G} {T : Set G} {v : G} :
    Set.PairwiseDisjoint Set.univ
      (fun C : QuakePlate F T v ↦ quakePlateTranslations C) := by
  intro C _ D _ hCD
  change Disjoint (quakePlateTranslations C) (quakePlateTranslations D)
  rw [Set.disjoint_left]
  intro t htC htD
  obtain ⟨_, htCcomp⟩ := htC
  obtain ⟨_, htDcomp⟩ := htD
  exact hCD (htCcomp.symm.trans htDcomp)

end QuakeGraph

end Tiling.RationalPolygonal
