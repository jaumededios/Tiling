import Mathlib.Combinatorics.SimpleGraph.Connectivity.Connected
import Tiling.RationalPolygonal.Basic
import TranslationalTilings.WeakPeriodicity

set_option linter.style.header false

/-!
# Canonical discrete earthquake plates

For an exact tiling `F + T = G` and a direction `v`, translating a represented point by `v`
transfers it to one uniquely determined tile placement.  The connected components generated by all
such transfers are exactly the minimal subsets whose tile carriers are `v`-periodic.  This gives a
canonical construction of the earthquake decomposition in Definition 4.1 of
de Dios Pont--Grebík--Greenfeld--Madrid.
-/

open Set
open TranslationalTilings

namespace Tiling.RationalPolygonal

universe u

/-- **Greenfeld--Tao weak periodicity (paper Theorem 4.1).** Every exact planar lattice tiling by
a nonempty finite tile has a finite periodic decomposition of its translation set. -/
theorem tilesUniverse_weaklyPeriodic {F : Finset IntegerPlane}
    {T : Set IntegerPlane} (hF : F.Nonempty) (hT : TilesUniverse F T) :
    TranslationalTilings.WeaklyPeriodic T := by
  apply TranslationalTilings.level_one_plane_weaklyPeriodic hF
  · refine ⟨(⊤ : AddSubgroup IntegerPlane), inferInstance, ?_⟩
    change SetPeriodicOn (⊤ : AddSubgroup IntegerPlane)
      (Set.univ : Set IntegerPlane)
    intro h hh x
    simp only [Set.mem_univ]
  · exact hT

section DiscreteCarrier

variable {G : Type u} [AddCommGroup G]

/-- The set covered by translating a finite discrete tile along `T`. -/
def discreteCarrier (F : Finset G) (T : Set G) : Set G :=
  {x | ∃ f ∈ F, ∃ t ∈ T, x = f + t}

@[simp]
theorem mem_discreteCarrier_iff {F : Finset G} {T : Set G} {x : G} :
    x ∈ discreteCarrier F T ↔ ∃ f ∈ F, ∃ t ∈ T, x = f + t :=
  Iff.rfl

/-- Exact discrete tiling gives a unique tile element, and hence a unique translation, at every
ambient point. -/
theorem existsUnique_tile_representation {F : Finset G} {T : Set G}
    (hT : TilesUniverse F T) (x : G) :
    ∃! f : G, f ∈ F ∧ x - f ∈ T := by
  classical
  have hcard : (F.filter fun f ↦ x - f ∈ T).card = 1 := by
    have hcount :=
      (tilesAtLevel_iff_representation_count F T Set.univ 1).mp hT x
    simpa using hcount
  obtain ⟨f, hf⟩ := Finset.card_eq_one.mp hcard
  refine ⟨f, ?_, ?_⟩
  · have : f ∈ F.filter fun g ↦ x - g ∈ T := by simp [hf]
    simpa using this
  · intro g hg
    have hgm : g ∈ F.filter fun f ↦ x - f ∈ T := by simpa using hg
    simpa [hf] using hgm

/-- A unique tile-element representation at every point is exactly a level-one tiling of the
ambient group. -/
theorem tilesUniverse_of_existsUnique {F : Finset G} {T : Set G}
    (hrep : ∀ x : G, ∃! f : G, f ∈ F ∧ x - f ∈ T) :
    TilesUniverse F T := by
  classical
  apply (tilesAtLevel_iff_representation_count F T Set.univ 1).mpr
  intro x
  obtain ⟨f, hf, hunique⟩ := hrep x
  have hfilter : (F.filter fun g ↦ x - g ∈ T) = {f} := by
    ext g
    constructor
    · intro hg
      have hg' : g ∈ F ∧ x - g ∈ T := by simpa using hg
      simpa only [Finset.mem_singleton] using hunique g hg'
    · intro hg
      have hgf : g = f := by simpa only [Finset.mem_singleton] using hg
      subst g
      simpa using hf
  rw [hfilter]
  simp

/-- Two representations of a point in an exact discrete tiling use the same translation vector. -/
theorem translation_eq_of_eq_representations {F : Finset G} {T : Set G}
    (hT : TilesUniverse F T) {f g t s : G}
    (hf : f ∈ F) (ht : t ∈ T) (hg : g ∈ F) (hs : s ∈ T)
    (heq : f + t = g + s) : t = s := by
  obtain ⟨chosen, hchosen, hunique⟩ := existsUnique_tile_representation hT (f + t)
  have hfrep : f ∈ F ∧ f + t - f ∈ T := by
    refine ⟨hf, ?_⟩
    simpa only [add_sub_cancel_left] using ht
  have hgrep : g ∈ F ∧ f + t - g ∈ T := by
    refine ⟨hg, ?_⟩
    rw [heq]
    simpa only [add_sub_cancel_left] using hs
  have hfg : f = g := (hunique f hfrep).trans (hunique g hgrep).symm
  rw [hfg] at heq
  exact add_left_cancel heq

/-- Discrete membership invariance under one specified period. -/
def DiscretePeriodicBy (A : Set G) (v : G) : Prop :=
  ∀ x, x + v ∈ A ↔ x ∈ A

/-- Integer multiples of a discrete period remain periods. -/
theorem DiscretePeriodicBy.zsmul {A : Set G} {v : G}
    (hA : DiscretePeriodicBy A v) (n : ℤ) :
    DiscretePeriodicBy A (n • v) := by
  have hperiodic : Function.Periodic (fun x ↦ x ∈ A) v :=
    fun x ↦ propext (hA x)
  exact fun x ↦ eq_iff_iff.mp (hperiodic.zsmul n x)

end DiscreteCarrier

section QuakeGraph

variable {G : Type u} [AddCommGroup G]

/-- A one-step transfer between tile placements after translating a represented point by `v`. -/
def quakeTransfer (F : Finset G) (T : Set G) (v : G) (t t' : T) : Prop :=
  ∃ f ∈ F, ∃ f' ∈ F, f + (t : G) + v = f' + (t' : G)

/-- The undirected graph generated by one-step earthquake transfers. -/
def quakeGraph (F : Finset G) (T : Set G) (v : G) : SimpleGraph T :=
  SimpleGraph.fromRel (quakeTransfer F T v)

/-- A canonical tectonic plate is a connected component of the quake graph. -/
abbrev QuakePlate (F : Finset G) (T : Set G) (v : G) :=
  (quakeGraph F T v).ConnectedComponent

/-- The translation vectors belonging to one canonical tectonic plate. -/
def quakePlateTranslations {F : Finset G} {T : Set G} {v : G}
    (C : QuakePlate F T v) : Set G :=
  {t | ∃ ht : t ∈ T,
    (quakeGraph F T v).connectedComponentMk ⟨t, ht⟩ = C}

@[simp]
theorem mem_quakePlateTranslations_iff {F : Finset G} {T : Set G} {v t : G}
    {C : QuakePlate F T v} :
    t ∈ quakePlateTranslations C ↔
      ∃ ht : t ∈ T, (quakeGraph F T v).connectedComponentMk ⟨t, ht⟩ = C :=
  Iff.rfl

/-- Every quake-graph vertex belongs to the translation set of its connected component. -/
theorem mem_quakePlateTranslations_mk {F : Finset G} {T : Set G} {v : G}
    (t : T) :
    (t : G) ∈ quakePlateTranslations
      ((quakeGraph F T v).connectedComponentMk t) :=
  ⟨t.2, rfl⟩

private theorem connectedComponentMk_eq_of_transfer
    {F : Finset G} {T : Set G} {v : G} {t t' : T}
    (h : quakeTransfer F T v t t') :
    (quakeGraph F T v).connectedComponentMk t =
      (quakeGraph F T v).connectedComponentMk t' := by
  by_cases htt : t = t'
  · exact congrArg _ htt
  apply SimpleGraph.ConnectedComponent.connectedComponentMk_eq_of_adj
  rw [quakeGraph, SimpleGraph.fromRel_adj]
  exact ⟨htt, Or.inl h⟩

/-- The carrier of one canonical earthquake plate is invariant under the earthquake direction. -/
theorem quakePlateCarrier_periodic {F : Finset G} {T : Set G} {v : G}
    (hT : TilesUniverse F T) (C : QuakePlate F T v) :
    DiscretePeriodicBy (discreteCarrier F (quakePlateTranslations C)) v := by
  intro x
  constructor
  · rintro ⟨f, hf, t, htC, hxt⟩
    obtain ⟨htT, htcomp⟩ := htC
    obtain ⟨f', hf'T, -⟩ := existsUnique_tile_representation hT x
    let t' : G := x - f'
    have ht'T : t' ∈ T := hf'T.2
    have hrepresentation : x = f' + t' := by
      dsimp only [t']
      abel
    let ts : T := ⟨t, htT⟩
    let ts' : T := ⟨t', ht'T⟩
    have htransfer : quakeTransfer F T v ts' ts := by
      refine ⟨f', hf'T.1, f, hf, ?_⟩
      rw [← hxt, hrepresentation]
    have hcomp' : (quakeGraph F T v).connectedComponentMk ts' = C := by
      rw [← htcomp]
      exact connectedComponentMk_eq_of_transfer htransfer
    exact ⟨f', hf'T.1, t', ⟨ht'T, hcomp'⟩, hrepresentation⟩
  · rintro ⟨f, hf, t, htC, hxt⟩
    obtain ⟨htT, htcomp⟩ := htC
    obtain ⟨f', hf'T, -⟩ := existsUnique_tile_representation hT (x + v)
    let t' : G := x + v - f'
    have ht'T : t' ∈ T := hf'T.2
    have hrepresentation : x + v = f' + t' := by
      dsimp only [t']
      abel
    let ts : T := ⟨t, htT⟩
    let ts' : T := ⟨t', ht'T⟩
    have htransfer : quakeTransfer F T v ts ts' := by
      refine ⟨f, hf, f', hf'T.1, ?_⟩
      rw [← hrepresentation, hxt]
    have hcomp' : (quakeGraph F T v).connectedComponentMk ts' = C := by
      rw [← htcomp]
      exact (connectedComponentMk_eq_of_transfer htransfer).symm
    exact ⟨f', hf'T.1, t', ⟨ht'T, hcomp'⟩, hrepresentation⟩

private theorem quake_subset_closed_under_adj
    {F : Finset G} {T P : Set G} {v : G}
    (hT : TilesUniverse F T) (hPT : P ⊆ T)
    (hperiod : DiscretePeriodicBy (discreteCarrier F P) v)
    {t t' : T} (htP : (t : G) ∈ P)
    (htt' : (quakeGraph F T v).Adj t t') : (t' : G) ∈ P := by
  rw [quakeGraph, SimpleGraph.fromRel_adj] at htt'
  rcases htt'.2 with hforward | hbackward
  · obtain ⟨f, hf, f', hf', heq⟩ := hforward
    have hx : f + (t : G) ∈ discreteCarrier F P :=
      ⟨f, hf, t, htP, rfl⟩
    have hxv := (hperiod (f + (t : G))).2 hx
    obtain ⟨g, hg, s, hsP, hgs⟩ := hxv
    have heq' : f' + (t' : G) = g + s := heq.symm.trans hgs
    have ht's := translation_eq_of_eq_representations hT hf' t'.2 hg (hPT hsP) heq'
    rw [ht's]
    exact hsP
  · obtain ⟨f, hf, f', hf', heq⟩ := hbackward
    have hxv : f' + (t : G) ∈ discreteCarrier F P :=
      ⟨f', hf', t, htP, rfl⟩
    have hx : f + (t' : G) ∈ discreteCarrier F P := by
      apply (hperiod (f + (t' : G))).mp
      rwa [heq]
    obtain ⟨g, hg, s, hsP, hgs⟩ := hx
    have ht's := translation_eq_of_eq_representations hT hf t'.2 hg (hPT hsP) hgs
    rw [ht's]
    exact hsP

private theorem quake_subset_closed_under_walk
    {F : Finset G} {T P : Set G} {v : G}
    (hT : TilesUniverse F T) (hPT : P ⊆ T)
    (hperiod : DiscretePeriodicBy (discreteCarrier F P) v)
    {t t' : T} (walk : (quakeGraph F T v).Walk t t')
    (htP : (t : G) ∈ P) : (t' : G) ∈ P := by
  induction walk with
  | nil => exact htP
  | cons htt' walk ih =>
      apply ih
      exact quake_subset_closed_under_adj hT hPT hperiod htP htt'

/-- A nonempty periodic subset of a canonical tectonic plate is the whole plate.  This proves the
minimality clause in paper Definition 4.1. -/
theorem quakePlate_minimal {F : Finset G} {T P : Set G} {v : G}
    (hT : TilesUniverse F T) (C : QuakePlate F T v)
    (hsub : P ⊆ quakePlateTranslations C) (hne : P.Nonempty)
    (hperiod : DiscretePeriodicBy (discreteCarrier F P) v) :
    P = quakePlateTranslations C := by
  apply Set.Subset.antisymm hsub
  obtain ⟨p, hpP⟩ := hne
  obtain ⟨hpT, hpcomp⟩ := hsub hpP
  intro t htC
  obtain ⟨htT, htcomp⟩ := htC
  let ps : T := ⟨p, hpT⟩
  let ts : T := ⟨t, htT⟩
  have hreach : (quakeGraph F T v).Reachable ps ts := by
    apply SimpleGraph.ConnectedComponent.exact
    exact hpcomp.trans htcomp.symm
  obtain ⟨walk⟩ := hreach
  have hPT : P ⊆ T := hsub.trans fun x hx ↦ Classical.choose hx
  exact quake_subset_closed_under_walk hT hPT hperiod walk hpP

/-- Canonical quake-plate translation sets partition the original tiling set. -/
theorem iUnion_quakePlateTranslations {F : Finset G} {T : Set G} {v : G} :
    (⋃ C : QuakePlate F T v, quakePlateTranslations C) = T := by
  ext t
  constructor
  · rintro ht
    obtain ⟨C, htC⟩ := Set.mem_iUnion.mp ht
    exact Classical.choose htC
  · intro ht
    apply Set.mem_iUnion.mpr
    exact ⟨(quakeGraph F T v).connectedComponentMk ⟨t, ht⟩,
      mem_quakePlateTranslations_mk ⟨t, ht⟩⟩

/-- Distinct canonical quake plates have disjoint translation sets. -/
theorem quakePlateTranslations_pairwiseDisjoint {F : Finset G} {T : Set G} {v : G} :
    Set.PairwiseDisjoint Set.univ
      (fun C : QuakePlate F T v ↦ quakePlateTranslations C) := by
  intro C _ D _ hCD
  change Disjoint (quakePlateTranslations C) (quakePlateTranslations D)
  rw [Set.disjoint_left]
  intro t htC htD
  obtain ⟨_, htCcomp⟩ := htC
  obtain ⟨_, htDcomp⟩ := htD
  exact hCD (htCcomp.symm.trans htDcomp)

/-- Distinct canonical quake plates have disjoint tile carriers. -/
theorem quakePlateCarriers_disjoint {F : Finset G} {T : Set G} {v : G}
    (hT : TilesUniverse F T) {C D : QuakePlate F T v} (hCD : C ≠ D) :
    Disjoint (discreteCarrier F (quakePlateTranslations C))
      (discreteCarrier F (quakePlateTranslations D)) := by
  rw [Set.disjoint_left]
  intro x hxC hxD
  obtain ⟨f, hf, t, htC, hft⟩ := hxC
  obtain ⟨g, hg, s, hsD, hgs⟩ := hxD
  obtain ⟨htT, htcomp⟩ := htC
  obtain ⟨hsT, hscomp⟩ := hsD
  have hts : t = s :=
    translation_eq_of_eq_representations hT hf htT hg hsT (hft.symm.trans hgs)
  subst s
  exact hCD (htcomp.symm.trans hscomp)

/-- Translate every canonical quake plate by an independently chosen integer multiple of the
quake direction. -/
def quakeShiftedTranslations {F : Finset G} {T : Set G} {v : G}
    (shift : QuakePlate F T v → ℤ) : Set G :=
  Set.range fun t : T ↦
    shift ((quakeGraph F T v).connectedComponentMk t) • v + (t : G)

@[simp]
theorem mem_quakeShiftedTranslations_iff {F : Finset G} {T : Set G} {v x : G}
    {shift : QuakePlate F T v → ℤ} :
    x ∈ quakeShiftedTranslations shift ↔
      ∃ t : T, shift ((quakeGraph F T v).connectedComponentMk t) • v + (t : G) = x :=
  Iff.rfl

private theorem shifted_representation_mem_plateCarrier
    {F : Finset G} {T : Set G} {v f : G}
    (hT : TilesUniverse F T) (hf : f ∈ F) (t : T)
    (shift : QuakePlate F T v → ℤ) :
    f + (shift ((quakeGraph F T v).connectedComponentMk t) • v + (t : G)) ∈
      discreteCarrier F
        (quakePlateTranslations ((quakeGraph F T v).connectedComponentMk t)) := by
  let C := (quakeGraph F T v).connectedComponentMk t
  have hbase : f + (t : G) ∈ discreteCarrier F (quakePlateTranslations C) :=
    ⟨f, hf, t, mem_quakePlateTranslations_mk t, rfl⟩
  have hperiod := (quakePlateCarrier_periodic hT C).zsmul (shift C)
  have hshifted := (hperiod (f + (t : G))).2 hbase
  convert hshifted using 1
  dsimp only [C]
  abel

/-- Independently shifting all canonical earthquake plates preserves the exact discrete tiling. -/
theorem tilesUniverse_quakeShiftedTranslations
    {F : Finset G} {T : Set G} {v : G}
    (hT : TilesUniverse F T) (shift : QuakePlate F T v → ℤ) :
    TilesUniverse F (quakeShiftedTranslations shift) := by
  apply tilesUniverse_of_existsUnique
  intro x
  obtain ⟨f₀, hf₀, -⟩ := existsUnique_tile_representation hT x
  let t₀ : T := ⟨x - f₀, hf₀.2⟩
  let C₀ : QuakePlate F T v := (quakeGraph F T v).connectedComponentMk t₀
  have hxC₀ : x ∈ discreteCarrier F (quakePlateTranslations C₀) := by
    refine ⟨f₀, hf₀.1, t₀, mem_quakePlateTranslations_mk t₀, ?_⟩
    dsimp only [t₀]
    abel
  have hperiod₀ := (quakePlateCarrier_periodic hT C₀).zsmul (-(shift C₀))
  have hback : x + (-(shift C₀)) • v ∈
      discreteCarrier F (quakePlateTranslations C₀) :=
    (hperiod₀ x).2 hxC₀
  obtain ⟨f, hf, t, htC₀, hrep⟩ := hback
  obtain ⟨htT, htcomp⟩ := htC₀
  let ts : T := ⟨t, htT⟩
  have hnewTranslation : shift C₀ • v + t ∈ quakeShiftedTranslations shift := by
    refine ⟨ts, ?_⟩
    simp only [ts, htcomp]
  have hxrep : x - f = shift C₀ • v + t := by
    have hx : x = f + t + shift C₀ • v := by
      rw [← hrep]
      simp only [neg_smul]
      abel
    rw [hx]
    abel
  refine ⟨f, ⟨hf, hxrep ▸ hnewTranslation⟩, ?_⟩
  intro g hg
  obtain ⟨s, hsnew⟩ := hg.2
  let D : QuakePlate F T v := (quakeGraph F T v).connectedComponentMk s
  have hxD : x ∈ discreteCarrier F (quakePlateTranslations D) := by
    have hcarrier := shifted_representation_mem_plateCarrier hT hg.1 s shift
    have hxeq : x = g +
        (shift ((quakeGraph F T v).connectedComponentMk s) • v + (s : G)) := by
      have hxsub : x = g + (x - g) := by abel
      rw [hxsub, ← hsnew]
    rwa [← hxeq] at hcarrier
  have hDC : D = C₀ := by
    by_contra hne
    exact (Set.disjoint_left.mp (quakePlateCarriers_disjoint hT hne)) hxD hxC₀
  have hsameShift : shift D = shift C₀ := congrArg shift hDC
  have hgOriginal : g + (s : G) = f + t := by
    have hxg : x = g + (shift D • v + (s : G)) := by
      have hxsub : x = g + (x - g) := by abel
      rw [hxsub, ← hsnew]
    rw [hsameShift] at hxg
    have hxf : x = f + (shift C₀ • v + t) := by
      calc
        x = f + (x - f) := by abel
        _ = f + (shift C₀ • v + t) := by rw [hxrep]
    rw [hxg] at hxf
    apply add_left_cancel (a := shift C₀ • v)
    simpa only [add_assoc, add_left_comm, add_comm] using hxf
  have hgf : g = f := by
    obtain ⟨chosen, hchosen, hunique⟩ := existsUnique_tile_representation hT (f + t)
    have hfrep : f ∈ F ∧ f + t - f ∈ T := by
      refine ⟨hf, ?_⟩
      simpa only [add_sub_cancel_left] using htT
    have hgrep : g ∈ F ∧ f + t - g ∈ T := by
      refine ⟨hg.1, ?_⟩
      rw [← hgOriginal]
      simpa only [add_sub_cancel_left] using s.2
    exact (hunique g hgrep).trans (hunique f hfrep).symm
  exact hgf

/-- Shift every canonical quake plate except `C` by the same integer multiple of the quake
direction.  This is the paper's auxiliary tiling `T^k`. -/
noncomputable def quakeShiftExcept {F : Finset G} {T : Set G} {v : G}
    (C : QuakePlate F T v) (k : ℤ) : QuakePlate F T v → ℤ :=
  by
    classical
    exact fun D ↦ if D = C then 0 else k

/-- The distinguished plate is unchanged in the auxiliary earthquake tiling. -/
theorem mem_quakeShiftedTranslations_quakeShiftExcept_of_mem
    {F : Finset G} {T : Set G} {v t : G}
    {C : QuakePlate F T v} (ht : t ∈ quakePlateTranslations C) (k : ℤ) :
    t ∈ quakeShiftedTranslations (quakeShiftExcept C k) := by
  classical
  obtain ⟨htT, htC⟩ := ht
  let ts : T := ⟨t, htT⟩
  refine ⟨ts, ?_⟩
  change (if (quakeGraph F T v).connectedComponentMk ts = C then 0 else k) • v +
      (ts : G) = t
  rw [show (quakeGraph F T v).connectedComponentMk ts = C from htC]
  simp [ts]

/-- A translation belonging to a different plate occurs in `T^k` shifted by `k • v`. -/
theorem add_mem_quakeShiftedTranslations_quakeShiftExcept_of_mem
    {F : Finset G} {T : Set G} {v t : G}
    {C D : QuakePlate F T v} (hDC : D ≠ C)
    (ht : t ∈ quakePlateTranslations D) (k : ℤ) :
    k • v + t ∈ quakeShiftedTranslations (quakeShiftExcept C k) := by
  classical
  obtain ⟨htT, htD⟩ := ht
  let ts : T := ⟨t, htT⟩
  refine ⟨ts, ?_⟩
  change (if (quakeGraph F T v).connectedComponentMk ts = C then 0 else k) • v +
      (ts : G) = k • v + t
  rw [show (quakeGraph F T v).connectedComponentMk ts = D from htD]
  simp [hDC, ts]

/-- A point of `T^k` which is not on the fixed plate comes from a unique original translation on
a different plate, shifted by `k • v`. -/
theorem exists_original_of_mem_quakeShiftedTranslations_quakeShiftExcept
    {F : Finset G} {T : Set G} {v x : G}
    {C : QuakePlate F T v} {k : ℤ}
    (hx : x ∈ quakeShiftedTranslations (quakeShiftExcept C k))
    (hxC : x ∉ quakePlateTranslations C) :
    ∃ t : G, t ∈ T ∧ t ∉ quakePlateTranslations C ∧ x = k • v + t := by
  classical
  obtain ⟨t, ht⟩ := hx
  let D : QuakePlate F T v := (quakeGraph F T v).connectedComponentMk t
  have hDC : D ≠ C := by
    intro hDC
    have hxt : x = (t : G) := by
      rw [← ht]
      simp [quakeShiftExcept, D, hDC]
    apply hxC
    rw [hxt]
    exact ⟨t.2, hDC⟩
  refine ⟨t, t.2, ?_, ?_⟩
  · intro htC
    exact hDC (Classical.choose_spec htC)
  · rw [← ht]
    simp [quakeShiftExcept, D, hDC]

/-- If `0 ∈ F`, a translation vector outside a fixed plate cannot lie in that plate's tile
carrier.  Exactness is essential: the two representations would otherwise use different
translations. -/
theorem not_mem_quakePlateCarrier_of_not_mem
    {F : Finset G} {T : Set G} {v t : G}
    (hzero : 0 ∈ F) (hT : TilesUniverse F T)
    {C : QuakePlate F T v} (htT : t ∈ T)
    (htC : t ∉ quakePlateTranslations C) :
    t ∉ discreteCarrier F (quakePlateTranslations C) := by
  intro htCarrier
  obtain ⟨f, hf, s, hsC, hrep⟩ := htCarrier
  obtain ⟨hsT, hsComp⟩ := hsC
  have hsC' : s ∈ quakePlateTranslations C := ⟨hsT, hsComp⟩
  have hts : t = s :=
    translation_eq_of_eq_representations hT hzero htT hf hsT (by simpa using hrep)
  exact htC (hts ▸ hsC')

/-- In an auxiliary tiling which fixes `C`, any translation vector lying in the carrier of `C`
must itself belong to `C`.  This is the exactness step behind the earthquake-period transfer. -/
theorem mem_quakePlateTranslations_of_mem_shiftExcept_of_mem_carrier
    {F : Finset G} {T : Set G} {v x : G}
    (hzero : 0 ∈ F) (hT : TilesUniverse F T)
    {C : QuakePlate F T v} {k : ℤ}
    (hxShift : x ∈ quakeShiftedTranslations (quakeShiftExcept C k))
    (hxCarrier : x ∈ discreteCarrier F (quakePlateTranslations C)) :
    x ∈ quakePlateTranslations C := by
  have hxShift' := hxShift
  obtain ⟨t, htShift⟩ := hxShift'
  obtain ⟨f, hf, s, hsC, hcarrier⟩ := hxCarrier
  obtain ⟨hsT, hsComp⟩ := hsC
  have hsC' : s ∈ quakePlateTranslations C := ⟨hsT, hsComp⟩
  have hsShift : (s : G) ∈
      quakeShiftedTranslations (quakeShiftExcept C k) :=
    mem_quakeShiftedTranslations_quakeShiftExcept_of_mem hsC' k
  have hxs : x = s := by
    apply translation_eq_of_eq_representations
      (tilesUniverse_quakeShiftedTranslations hT (quakeShiftExcept C k))
      hzero hxShift hf hsShift
    simpa using hcarrier
  exact hxs ▸ hsC'

/-- The points of one plate in quotient coset `c` whose full `p`-orbit is not contained in that
plate.  These are the paper's incomplete periodic orbits. -/
def quakeIncompleteOrbit {F : Finset G} {T : Set G} {v : G}
    (C : QuakePlate F T v) (Λ : AddSubgroup G) (c : G ⧸ Λ) (p : G) : Set G :=
  {x | x ∈ quakePlateTranslations C ∧ x ∈ quotientCoset Λ c ∧
    ∃ n : ℤ, x + n • p ∉ quakePlateTranslations C}

private theorem quotientCoset_add_mem_iff
    (Λ : AddSubgroup G) (c : G ⧸ Λ) {p : G} (hp : p ∈ Λ) (x : G) :
    x + p ∈ quotientCoset Λ c ↔ x ∈ quotientCoset Λ c := by
  change QuotientAddGroup.mk' Λ (x + p) = c ↔ QuotientAddGroup.mk' Λ x = c
  have hp0 : QuotientAddGroup.mk' Λ p = 0 :=
    (QuotientAddGroup.eq_zero_iff p).2 hp
  rw [map_add, hp0, add_zero]

private theorem mem_carrier_of_mem_quakePlateTranslations
    {F : Finset G} {T : Set G} {v x : G}
    (hzero : 0 ∈ F) {C : QuakePlate F T v}
    (hx : x ∈ quakePlateTranslations C) :
    x ∈ discreteCarrier F (quakePlateTranslations C) := by
  exact ⟨0, hzero, x, hx, (zero_add x).symm⟩

private theorem quakeIncompleteOrbit_forward
    {F : Finset G} {T : Set G} {v : G}
    (hzero : 0 ∈ F) (hT : TilesUniverse F T)
    (C : QuakePlate F T v) (Λ : AddSubgroup G) (c : G ⧸ Λ)
    (p : G) (hp : p ∈ Λ) (a b : ℤ)
    (hav : a • v ∈ Λ) (hbv : b • v ∈ Λ)
    (hperiodA : DiscretePeriodicBy
      (quakeShiftedTranslations (quakeShiftExcept C a) ∩ quotientCoset Λ c) p)
    (hperiodB : DiscretePeriodicBy
      (quakeShiftedTranslations (quakeShiftExcept C b) ∩ quotientCoset Λ c) p) :
    ∀ {x}, x ∈ quakeIncompleteOrbit C Λ c p →
      x + (b - a) • v ∈ quakeIncompleteOrbit C Λ c p := by
  intro x hx
  rcases hx with ⟨hxC, hxc, n, hynotC⟩
  let y := x + n • p
  have hyc : y ∈ quotientCoset Λ c := by
    have hnp : n • p ∈ Λ := Λ.zsmul_mem hp n
    exact (quotientCoset_add_mem_iff Λ c hnp x).2 hxc
  have hxA : x ∈ quakeShiftedTranslations (quakeShiftExcept C a) :=
    mem_quakeShiftedTranslations_quakeShiftExcept_of_mem hxC a
  have hxB : x ∈ quakeShiftedTranslations (quakeShiftExcept C b) :=
    mem_quakeShiftedTranslations_quakeShiftExcept_of_mem hxC b
  have hyA : y ∈ quakeShiftedTranslations (quakeShiftExcept C a) ∩
      quotientCoset Λ c := by
    have hza := hperiodA.zsmul n x
    exact hza.mpr ⟨hxA, hxc⟩
  have hyB : y ∈ quakeShiftedTranslations (quakeShiftExcept C b) ∩
      quotientCoset Λ c := by
    have hzb := hperiodB.zsmul n x
    exact hzb.mpr ⟨hxB, hxc⟩
  obtain ⟨t, htT, htNotC, hyt⟩ :=
    exists_original_of_mem_quakeShiftedTranslations_quakeShiftExcept
      hyA.1 hynotC
  have htPlate : ∃ D : QuakePlate F T v,
      D ≠ C ∧ t ∈ quakePlateTranslations D := by
    let ts : T := ⟨t, htT⟩
    let D := (quakeGraph F T v).connectedComponentMk ts
    refine ⟨D, ?_, mem_quakePlateTranslations_mk ts⟩
    intro hDC
    exact htNotC ⟨htT, hDC⟩
  obtain ⟨D, hDC, htD⟩ := htPlate
  have hshiftB : b • v + t ∈
      quakeShiftedTranslations (quakeShiftExcept C b) :=
    add_mem_quakeShiftedTranslations_quakeShiftExcept_of_mem hDC htD b
  have hyDeltaShiftB : y + (b - a) • v ∈
      quakeShiftedTranslations (quakeShiftExcept C b) := by
    rw [hyt]
    convert hshiftB using 1
    rw [sub_smul]
    abel
  have hyDeltaCoset : y + (b - a) • v ∈ quotientCoset Λ c := by
    have hdelta : (b - a) • v ∈ Λ := by
      rw [sub_smul]
      exact Λ.sub_mem hbv hav
    exact (quotientCoset_add_mem_iff Λ c hdelta y).2 hyc
  let x' := x + (b - a) • v
  have hx'ShiftB : x' ∈ quakeShiftedTranslations (quakeShiftExcept C b) ∩
      quotientCoset Λ c := by
    have hper := hperiodB.zsmul (-n) (y + (b - a) • v)
    have hmem := hper.mpr ⟨hyDeltaShiftB, hyDeltaCoset⟩
    convert hmem using 1
    dsimp [x', y]
    module
  have hx'Carrier : x' ∈ discreteCarrier F (quakePlateTranslations C) := by
    have hxCarrier := mem_carrier_of_mem_quakePlateTranslations hzero hxC
    have hper := (quakePlateCarrier_periodic hT C).zsmul (b - a)
    exact (hper x).2 hxCarrier
  have hx'C : x' ∈ quakePlateTranslations C :=
    mem_quakePlateTranslations_of_mem_shiftExcept_of_mem_carrier
      hzero hT hx'ShiftB.1 hx'Carrier
  have htNotCarrier : t ∉ discreteCarrier F (quakePlateTranslations C) :=
    not_mem_quakePlateCarrier_of_not_mem hzero hT htT htNotC
  have hyNotCarrier : y ∉ discreteCarrier F (quakePlateTranslations C) := by
    intro hyCarrier
    have hper := (quakePlateCarrier_periodic hT C).zsmul a
    apply htNotCarrier
    apply (hper t).mp
    convert hyCarrier using 1
    rw [hyt]
    abel
  have hyDeltaNotCarrier : y + (b - a) • v ∉
      discreteCarrier F (quakePlateTranslations C) := by
    intro hmem
    have hper := (quakePlateCarrier_periodic hT C).zsmul (b - a)
    exact hyNotCarrier ((hper y).mp hmem)
  have hyDeltaNotC : y + (b - a) • v ∉ quakePlateTranslations C := by
    intro hmem
    exact hyDeltaNotCarrier (mem_carrier_of_mem_quakePlateTranslations hzero hmem)
  refine ⟨hx'C, hx'ShiftB.2, n, ?_⟩
  intro hmem
  apply hyDeltaNotC
  convert hmem using 1
  dsimp [x', y]
  abel

/-- If two auxiliary earthquakes select the same period on a lattice coset, then the incomplete
orbits of the fixed plate acquire the difference of those quake shifts as a period.  This is the
local period-transfer step in paper Lemma 4.2. -/
theorem quakeIncompleteOrbit_periodic_of_repeated_cosetPeriod
    {F : Finset G} {T : Set G} {v : G}
    (hzero : 0 ∈ F) (hT : TilesUniverse F T)
    (C : QuakePlate F T v) (Λ : AddSubgroup G) (c : G ⧸ Λ)
    (p : G) (hp : p ∈ Λ) (a b : ℤ)
    (hav : a • v ∈ Λ) (hbv : b • v ∈ Λ)
    (hperiodA : DiscretePeriodicBy
      (quakeShiftedTranslations (quakeShiftExcept C a) ∩ quotientCoset Λ c) p)
    (hperiodB : DiscretePeriodicBy
      (quakeShiftedTranslations (quakeShiftExcept C b) ∩ quotientCoset Λ c) p) :
    DiscretePeriodicBy (quakeIncompleteOrbit C Λ c p) ((b - a) • v) := by
  intro x
  constructor
  · intro hx
    have hback := quakeIncompleteOrbit_forward hzero hT C Λ c p hp b a
      hbv hav hperiodB hperiodA hx
    have heq : x + (b - a) • v + (a - b) • v = x := by
      rw [sub_smul, sub_smul]
      module
    rwa [heq] at hback
  · exact quakeIncompleteOrbit_forward hzero hT C Λ c p hp a b
      hav hbv hperiodA hperiodB

end QuakeGraph

end Tiling.RationalPolygonal
