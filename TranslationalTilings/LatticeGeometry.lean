import Mathlib.Algebra.GCDMonoid.FinsetLemmas
import Mathlib.Analysis.InnerProductSpace.PiL2
import Mathlib.Data.Fin.VecNotation
import Mathlib.GroupTheory.IndexNSmul
import Mathlib.LinearAlgebra.FreeModule.Finite.CardQuotient
import Mathlib.LinearAlgebra.Matrix.Adjugate
import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup
import Mathlib.NumberTheory.Primorial
import TranslationalTilings.Arithmetic

/-!
# Geometry of the integer lattice

Determinants, primitive vectors, rank-two sublattices, bounded direction
avoidance, and the common pair-determinant modulus used by the tiling proof.

The public API relates planar determinants to commensurability and subgroup
index, gives canonical primitive decompositions in arbitrary dimension,
constructs common multiples of commensurable vectors, and supplies explicit
bounded directions and moduli for finite incommensurable families.
-/

set_option relaxedAutoImplicit false
set_option maxSynthPendingDepth 3

open scoped BigOperators Real

namespace TranslationalTilings

/-- The oriented determinant of two vectors in the integer plane. -/
def wedge (u v : Plane) : ℤ := u 0 * v 1 - u 1 * v 0

/-- Two lattice vectors are commensurable if nonzero integer multiples coincide. -/
def Commensurable {d : ℕ} (u v : Lattice d) : Prop :=
  ∃ a b : ℤ, a ≠ 0 ∧ b ≠ 0 ∧ a • u = b • v

/-- A finite family is pairwise incommensurable when distinct members are not commensurable. -/
def PairwiseIncommensurable {d m : ℕ}
    (h : Fin m → Lattice d) : Prop :=
  ∀ i j, i ≠ j → ¬ Commensurable (h i) (h j)

/-- The additive subgroup of the plane generated by `u` and `v`. -/
def generatedPair (u v : Plane) : AddSubgroup Plane :=
  AddSubgroup.closure ({u, v} : Set Plane)

/-- The scalar sublattice consisting of coordinate vectors divisible by `q`. -/
def scalarLattice {d : ℕ} (q : ℕ) : AddSubgroup (Lattice d) :=
  (nsmulAddMonoidHom q).range

/-- The greatest common divisor of the absolute coordinates of a lattice vector. -/
def vectorContent {d : ℕ} (h : Lattice d) : ℕ :=
  (Finset.univ : Finset (Fin d)).gcd fun i ↦ Int.natAbs (h i)

/-- The vector obtained by dividing a nonzero lattice vector by its content. -/
def primitivePart {d : ℕ} (h : Lattice d) : Lattice d :=
  if h = 0 then 0 else fun i ↦ h i / (vectorContent h : ℤ)

/-- A lattice vector is primitive when it is nonzero and has content one. -/
def IsPrimitive {d : ℕ} (h : Lattice d) : Prop :=
  h ≠ 0 ∧ vectorContent h = 1

/-- The planar vector `(1, t)`, used to enumerate candidate slopes. -/
def slopeVector (t : ℕ) : Plane := ![(1 : ℤ), (t : ℤ)]

/-- Decide whether slope `t` is nonparallel to every vector in `h`. -/
def avoidsDirections {m : ℕ} (h : Fin m → Plane) (t : ℕ) : Bool :=
  decide (∀ i, wedge (slopeVector t) (h i) ≠ 0)

/-- The first slope among `0, …, m` avoiding every direction in `h`, or zero by default. -/
def avoidanceSlope {m : ℕ} (h : Fin m → Plane) : ℕ :=
  ((List.range (m + 1)).find? (avoidsDirections h)).getD 0

/-- The bounded planar slope vector selected to avoid a finite family of directions. -/
def avoidanceVector {m : ℕ} (h : Fin m → Plane) : Plane :=
  slopeVector (avoidanceSlope h)

/-- The finset of pairs `(i, j)` with `i < j` in `Fin m`. -/
def unorderedPairs (m : ℕ) : Finset (Fin m × Fin m) :=
  Finset.univ.offDiag.filter fun ij ↦ ij.1 < ij.2

/-- The least common multiple of absolute pairwise wedges in a planar family. -/
def pairWedgeLCM {m : ℕ} (h : Fin m → Plane) : ℕ :=
  (unorderedPairs m).lcm fun ij ↦
    Int.natAbs (wedge (h ij.1) (h ij.2))

/-- The wedge product is zero when its left argument is zero. -/
theorem wedge_zero_left (v : Plane) : wedge 0 v = 0 := by
  simp [wedge]

/-- The wedge product is zero when its right argument is zero. -/
theorem wedge_zero_right (u : Plane) : wedge u 0 = 0 := by
  simp [wedge]

/-- The wedge product is additive in its left argument. -/
theorem wedge_add_left (u v w : Plane) :
    wedge (u + v) w = wedge u w + wedge v w := by
  simp [wedge]
  ring

/-- The wedge product is additive in its right argument. -/
theorem wedge_add_right (u v w : Plane) :
    wedge u (v + w) = wedge u v + wedge u w := by
  simp [wedge]
  ring

/-- Swapping the arguments negates the wedge product. -/
theorem wedge_swap (u v : Plane) : wedge u v = -wedge v u := by
  simp [wedge]
  ring

/-- Integer scaling in the left argument scales the wedge product. -/
theorem wedge_zsmul_left (n : ℤ) (u v : Plane) :
    wedge (n • u) v = n * wedge u v := by
  simp [wedge]
  ring

/-- Integer scaling in the right argument scales the wedge product. -/
theorem wedge_zsmul_right (n : ℤ) (u v : Plane) :
    wedge u (n • v) = n * wedge u v := by
  simp [wedge]
  ring

private theorem plane_eq_zero_of_coords {u : Plane}
    (h0 : u 0 = 0) (h1 : u 1 = 0) : u = 0 := by
  funext i
  fin_cases i <;> assumption

/-- Nonzero planar vectors are commensurable exactly when their wedge vanishes. -/
theorem commensurable_iff_wedge_eq_zero {u v : Plane}
    (hu : u ≠ 0) (hv : v ≠ 0) :
    Commensurable u v ↔ wedge u v = 0 := by
  constructor
  · rintro ⟨a, b, ha, _hb, hab⟩
    have hw : a * wedge u v = 0 := by
      calc
        a * wedge u v = wedge (a • u) v := (wedge_zsmul_left a u v).symm
        _ = wedge (b • v) v := by rw [hab]
        _ = b * wedge v v := wedge_zsmul_left b v v
        _ = 0 := by
          unfold wedge
          ring
    exact (mul_eq_zero.mp hw).resolve_left ha
  · intro hw
    by_cases hv0 : v 0 = 0
    · have hv1 : v 1 ≠ 0 := by
        intro hv1
        exact hv (plane_eq_zero_of_coords hv0 hv1)
      have hu0 : u 0 = 0 := by
        have huv : u 0 * v 1 = 0 := by
          rw [wedge, hv0, mul_zero, sub_zero] at hw
          exact hw
        exact (mul_eq_zero.mp huv).resolve_right hv1
      have hu1 : u 1 ≠ 0 := by
        intro hu1
        exact hu (plane_eq_zero_of_coords hu0 hu1)
      refine ⟨v 1, u 1, hv1, hu1, ?_⟩
      funext i
      fin_cases i
      · simp [Pi.smul_apply, hv0, hu0]
      · simp [Pi.smul_apply]
        ring
    · have hu0 : u 0 ≠ 0 := by
        intro hu0
        have hu1 : u 1 = 0 := by
          have huv : -(u 1 * v 0) = 0 := by
            rw [wedge, hu0, zero_mul, zero_sub] at hw
            exact hw
          have huv' : u 1 * v 0 = 0 := neg_eq_zero.mp huv
          exact (mul_eq_zero.mp huv').resolve_right hv0
        exact hu (plane_eq_zero_of_coords hu0 hu1)
      refine ⟨v 0, u 0, hv0, hu0, ?_⟩
      funext i
      fin_cases i
      · simp [Pi.smul_apply]
        ring
      · have heq : v 0 * u 1 = u 0 * v 1 := by
          rw [wedge] at hw
          linear_combination -hw
        simpa [Pi.smul_apply] using heq

/-- Cramer's identity expresses a determinant multiple using the generating pair. -/
theorem cramer_identity (u v x : Plane) :
    (wedge u v) • x = wedge x v • u + wedge u x • v := by
  funext i
  fin_cases i <;> simp [wedge] <;> ring

/-- The scalar lattice at the absolute wedge is contained in the subgroup generated by the pair. -/
theorem scalarLattice_natAbs_wedge_le_generatedPair (u v : Plane) :
    scalarLattice (Int.natAbs (wedge u v)) ≤ generatedPair u v := by
  rintro x ⟨y, rfl⟩
  have hu : u ∈ generatedPair u v := by
    exact AddSubgroup.subset_closure (by simp)
  have hv : v ∈ generatedPair u v := by
    exact AddSubgroup.subset_closure (by simp)
  have hdet : (wedge u v) • y ∈ generatedPair u v := by
    rw [cramer_identity]
    exact (generatedPair u v).add_mem
      ((generatedPair u v).zsmul_mem hu _)
      ((generatedPair u v).zsmul_mem hv _)
  change Int.natAbs (wedge u v) • y ∈ generatedPair u v
  rw [show Int.natAbs (wedge u v) • y =
      (Int.natAbs (wedge u v) : ℤ) • y by simp]
  rw [Int.natCast_natAbs]
  by_cases hw : 0 ≤ wedge u v
  · simpa [abs_of_nonneg hw] using hdet
  · have hw' : wedge u v ≤ 0 := le_of_not_ge hw
    simpa [abs_of_nonpos hw'] using (generatedPair u v).neg_mem hdet

/-- The index of a nondegenerate generated pair equals the absolute wedge. -/
theorem index_generatedPair {u v : Plane} (hdet : wedge u v ≠ 0) :
    (generatedPair u v).index = Int.natAbs (wedge u v) := by
  let A : Matrix (Fin 2) (Fin 2) ℤ := fun i j ↦ ![u, v] j i
  have hAdet : A.det = wedge u v := by
    rw [Matrix.det_fin_two]
    simp [A, wedge]
    ring
  have hli : LinearIndependent ℤ (![u, v] : Fin 2 → Plane) := by
    apply Matrix.linearIndependent_cols_of_det_ne_zero (A := A)
    simpa [hAdet] using hdet
  have hspan : Submodule.span ℤ (Set.range (![u, v] : Fin 2 → Plane)) =
      (generatedPair u v).toIntSubmodule := by
    rw [generatedPair, AddSubgroup.toIntSubmodule_closure]
    congr 1
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      fin_cases i <;> simp
    · intro hx
      rcases hx with (rfl | rfl)
      · exact ⟨0, by simp⟩
      · exact ⟨1, by simp⟩
  let bN : Module.Basis (Fin 2) ℤ (generatedPair u v).toIntSubmodule :=
    (Module.Basis.span hli).map (LinearEquiv.ofEq _ _ hspan)
  have hbN (i : Fin 2) :
      ((bN i : (generatedPair u v).toIntSubmodule) : Plane) =
        (![u, v] : Fin 2 → Plane) i := by
    simp [bN]
  calc
    (generatedPair u v).index =
        ((Pi.basisFun ℤ (Fin 2)).det (fun i ↦ (bN i : Plane))).natAbs :=
      AddSubgroup.index_eq_natAbs_det (Pi.basisFun ℤ (Fin 2)) _ bN
    _ = Int.natAbs (wedge u v) := by
      rw [Pi.basisFun_det_apply, Matrix.det_fin_two]
      simp only [hbN]
      change Int.natAbs (u 0 * v 1 - u 1 * v 0) =
        Int.natAbs (wedge u v)
      rfl

/-- The absolute wedge is bounded by the product of the two `ℓ¹` norms. -/
theorem natAbs_wedge_le_l1Norm_mul_l1Norm (u v : Plane) :
    Int.natAbs (wedge u v) ≤ l1Norm u * l1Norm v := by
  have htriangle := Int.natAbs_sub_le (u 0 * v 1) (u 1 * v 0)
  simp only [Int.natAbs_mul] at htriangle
  rw [wedge]
  simp only [l1Norm, Fin.sum_univ_two]
  nlinarith [Nat.zero_le (Int.natAbs (u 0)), Nat.zero_le (Int.natAbs (u 1)),
    Nat.zero_le (Int.natAbs (v 0)), Nat.zero_le (Int.natAbs (v 1))]

/-- The real absolute wedge is bounded by the product of the Euclidean norms. -/
theorem abs_wedge_le_euclideanNorm_mul_euclideanNorm (u v : Plane) :
    |(wedge u v : ℝ)| ≤ euclideanNorm u * euclideanNorm v := by
  let U : EuclideanSpace ℝ (Fin 2) :=
    WithLp.toLp 2 (fun i ↦ (u i : ℝ))
  let Vrot : EuclideanSpace ℝ (Fin 2) :=
    WithLp.toLp 2 ![-(v 1 : ℝ), (v 0 : ℝ)]
  have hinner : inner ℝ U Vrot = -(wedge u v : ℝ) := by
    simp [U, Vrot, PiLp.inner_apply, Fin.sum_univ_two, wedge]
    ring
  have hnormrot : ‖Vrot‖ = euclideanNorm v := by
    apply (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp
    rw [EuclideanSpace.real_norm_sq_eq, EuclideanSpace.real_norm_sq_eq]
    simp [Vrot, Fin.sum_univ_two]
    ring
  simpa [hinner, hnormrot, U, euclideanNorm] using abs_real_inner_le_norm U Vrot

/-- Divisibility reverses inclusion between scalar sublattices. -/
theorem scalarLattice_mono_dvd {d m n : ℕ} (h : m ∣ n) :
    scalarLattice (d := d) n ≤ scalarLattice m := by
  obtain ⟨c, rfl⟩ := h
  rintro _ ⟨x, rfl⟩
  refine ⟨c • x, ?_⟩
  simp [mul_smul]

/-- The index of the scalar sublattice `q · ℤᵈ` is `q ^ d`. -/
theorem scalarLattice_index (d q : ℕ) :
    (scalarLattice (d := d) q).index = q ^ d := by
  simpa [scalarLattice] using
    (AddSubgroup.index_range_nsmul (M := Lattice d) q)

/-- Every nonzero lattice vector has positive content. -/
theorem vectorContent_pos {d : ℕ} {h : Lattice d} (hh : h ≠ 0) :
    0 < vectorContent h := by
  rw [Nat.pos_iff_ne_zero, vectorContent, Finset.gcd_ne_zero_iff]
  by_contra hx
  push Not at hx
  apply hh
  funext i
  exact Int.natAbs_eq_zero.mp (hx i (Finset.mem_univ i))

/-- The content of a lattice vector divides each coordinate. -/
theorem vectorContent_dvd_coord {d : ℕ} (h : Lattice d) (i : Fin d) :
    (vectorContent h : ℤ) ∣ h i := by
  apply Int.dvd_natAbs.mp
  apply Int.natCast_dvd_natCast.mpr
  exact Finset.gcd_dvd (s := (Finset.univ : Finset (Fin d)))
    (f := fun j ↦ Int.natAbs (h j)) (Finset.mem_univ i)

private theorem exists_sum_mul_eq_finset_gcd_natAbs
    {d : ℕ} (s : Finset (Fin d)) (v : Lattice d) :
    ∃ a : Lattice d,
      ∑ i ∈ s, a i * v i =
        ((s.gcd (fun i ↦ Int.natAbs (v i)) : ℕ) : ℤ) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      exact ⟨0, by simp⟩
  | @insert i s hi ih =>
      obtain ⟨a, ha⟩ := ih
      let g : ℕ := s.gcd (fun j ↦ Int.natAbs (v j))
      let b : Lattice d := fun j ↦
        if j = i then Int.gcdA (v i) (g : ℤ)
        else Int.gcdB (v i) (g : ℤ) * a j
      refine ⟨b, ?_⟩
      rw [Finset.sum_insert hi]
      have hb : ∑ j ∈ s, b j * v j =
          Int.gcdB (v i) (g : ℤ) * (g : ℤ) := by
        calc
          ∑ j ∈ s, b j * v j =
              ∑ j ∈ s, (Int.gcdB (v i) (g : ℤ) * a j) * v j := by
            apply Finset.sum_congr rfl
            intro j hj
            simp [b, ne_of_mem_of_not_mem hj hi]
          _ = Int.gcdB (v i) (g : ℤ) * (∑ j ∈ s, a j * v j) := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro j _
            ring
          _ = Int.gcdB (v i) (g : ℤ) * (g : ℤ) := by
            rw [ha]
      rw [hb]
      simp only [b, if_pos, Finset.gcd_insert]
      change Int.gcdA (v i) (g : ℤ) * v i +
          Int.gcdB (v i) (g : ℤ) * (g : ℤ) =
        (Int.gcd (v i) (g : ℤ) : ℤ)
      rw [Int.gcd_eq_gcd_ab]
      ring

/-- Every nonzero lattice vector is its positive content times a primitive vector. -/
theorem primitive_decomposition {d : ℕ} {h : Lattice d} (hh : h ≠ 0) :
    (vectorContent h : ℤ) • primitivePart h = h ∧
      IsPrimitive (primitivePart h) := by
  have hdecomp : (vectorContent h : ℤ) • primitivePart h = h := by
    funext i
    simp only [primitivePart, if_neg hh, Pi.smul_apply, smul_eq_mul]
    exact Int.mul_ediv_cancel_of_dvd (vectorContent_dvd_coord h i)
  refine ⟨hdecomp, ?_, ?_⟩
  · intro hp
    apply hh
    rw [← hdecomp, hp]
    simp
  · obtain ⟨i, hi⟩ : ∃ i, h i ≠ 0 := by
      apply not_forall.mp
      intro hall
      exact hh (funext hall)
    rw [vectorContent]
    simp_rw [primitivePart, if_neg hh,
      Int.natAbs_ediv_of_dvd (vectorContent_dvd_coord h _),
      Int.natAbs_natCast]
    exact Finset.gcd_div_eq_one (s := (Finset.univ : Finset (Fin d)))
      (f := fun j ↦ Int.natAbs (h j)) (Finset.mem_univ i)
      (Int.natAbs_ne_zero.mpr hi)

/-- A decomposition into a positive natural multiple of a primitive vector is canonical. -/
theorem primitive_decomposition_unique {d : ℕ}
    {h v : Lattice d} {k : ℕ}
    (hh : h ≠ 0) (hk : 0 < k) (hv : IsPrimitive v)
    (hdecomp : h = (k : ℤ) • v) :
    k = vectorContent h ∧ v = primitivePart h := by
  have hkcontent : vectorContent h = k := by
    calc
      vectorContent h = (Finset.univ : Finset (Fin d)).gcd
          (fun i ↦ Int.natAbs (((k : ℤ) • v) i)) := by rw [hdecomp]; rfl
      _ = k * vectorContent v := by
        simp [vectorContent, Int.natAbs_mul, Finset.gcd_mul_left]
      _ = k := by rw [hv.2, mul_one]
  refine ⟨hkcontent.symm, ?_⟩
  funext i
  rw [primitivePart, if_neg hh, hkcontent, hdecomp]
  simp [Nat.ne_of_gt hk]

/-- The coordinates of a primitive vector have an integer Bézout combination equal to one. -/
theorem primitive_bezout {d : ℕ} {v : Lattice d}
    (hv : IsPrimitive v) :
  ∃ a : Lattice d, ∑ i, a i * v i = 1 := by
  obtain ⟨a, ha⟩ := exists_sum_mul_eq_finset_gcd_natAbs
    (Finset.univ : Finset (Fin d)) v
  refine ⟨a, ?_⟩
  have ha' : ∑ i, a i * v i = (vectorContent v : ℤ) := by
    simpa [vectorContent] using ha
  simpa [hv.2] using ha'

/-- A vector commensurable with a primitive vector is a nonzero integer multiple of it. -/
theorem integer_multiple_of_primitive_of_commensurable
    {d : ℕ} {u v : Lattice d} (_hu : u ≠ 0)
    (hv : IsPrimitive v) (huv : Commensurable u v) :
  ∃ z : ℤ, z ≠ 0 ∧ u = z • v := by
  obtain ⟨a, b, ha, hb, hab⟩ := huv
  obtain ⟨c, hc⟩ := primitive_bezout hv
  have hab_coord (i : Fin d) : a * u i = b * v i := by
    simpa [Pi.smul_apply] using congr_fun hab i
  have hab_dvd : a ∣ b := by
    rw [← mul_one b, ← hc, Finset.mul_sum]
    apply Finset.dvd_sum
    intro i _
    have hi : a ∣ b * v i := ⟨u i, (hab_coord i).symm⟩
    convert hi.mul_left (c i) using 1
    ring
  obtain ⟨z, hz⟩ := hab_dvd
  have hz0 : z ≠ 0 := by
    intro hz0
    apply hb
    rw [hz, hz0, mul_zero]
  refine ⟨z, hz0, ?_⟩
  funext i
  have hi := hab_coord i
  rw [hz] at hi
  simp only [Pi.smul_apply, smul_eq_mul]
  apply mul_left_cancel₀ ha
  linear_combination hi

/--
A nonempty finite pairwise-commensurable family of nonzero vectors has a
nonzero common multiple bounded by the products of its `ℓ¹` and Euclidean
norms.
-/
theorem exists_commonMultiple_of_pairwise_commensurable
    {d : ℕ} {C : Finset (Lattice d)} (hC : C.Nonempty)
    (hne : ∀ f ∈ C, f ≠ 0)
    (hcomm : ∀ u ∈ C, ∀ v ∈ C, Commensurable u v) :
  ∃ h : Lattice d,
    h ≠ 0 ∧
    (∀ f ∈ C, ∃ z : ℤ, z ≠ 0 ∧ h = z • f) ∧
    l1Norm h ≤ ∏ f ∈ C, l1Norm f ∧
    euclideanNorm h ≤ ∏ f ∈ C, euclideanNorm f := by
  classical
  obtain ⟨f0, hf0⟩ := hC
  have hf0_ne : f0 ≠ 0 := hne f0 hf0
  let v : Lattice d := primitivePart f0
  have hf0_decomp : (vectorContent f0 : ℤ) • v = f0 :=
    (primitive_decomposition hf0_ne).1
  have hv : IsPrimitive v := (primitive_decomposition hf0_ne).2
  have hcontent_ne : (vectorContent f0 : ℤ) ≠ 0 := by
    exact_mod_cast (ne_of_gt (vectorContent_pos hf0_ne))
  have hf_comm_v (f : Lattice d) (hf : f ∈ C) : Commensurable f v := by
    obtain ⟨a, b, ha, hb, hab⟩ := hcomm f hf f0 hf0
    refine ⟨a, b * (vectorContent f0 : ℤ), ha,
      mul_ne_zero hb hcontent_ne, ?_⟩
    calc
      a • f = b • f0 := hab
      _ = b • ((vectorContent f0 : ℤ) • v) := by rw [hf0_decomp]
      _ = (b * (vectorContent f0 : ℤ)) • v := by rw [mul_smul]
  let z : {f // f ∈ C} → ℤ := fun f ↦ Classical.choose
    (integer_multiple_of_primitive_of_commensurable
      (hne f f.property) hv (hf_comm_v f f.property))
  have hz_ne (f : {f // f ∈ C}) : z f ≠ 0 :=
    (Classical.choose_spec
      (integer_multiple_of_primitive_of_commensurable
        (hne f f.property) hv (hf_comm_v f f.property))).1
  have hz_decomp (f : {f // f ∈ C}) : (f : Lattice d) = z f • v :=
    (Classical.choose_spec
      (integer_multiple_of_primitive_of_commensurable
        (hne f f.property) hv (hf_comm_v f f.property))).2
  let L : ℕ := (Finset.univ : Finset {f // f ∈ C}).lcm fun f ↦
    Int.natAbs (z f)
  have hL_ne : L ≠ 0 := by
    intro hL
    change (Finset.univ : Finset {f // f ∈ C}).lcm
      (fun f ↦ Int.natAbs (z f)) = 0 at hL
    rw [Finset.lcm_eq_zero_iff] at hL
    obtain ⟨f, _, hf⟩ := hL
    exact Int.natAbs_ne_zero.mpr (hz_ne f) hf
  have hprod_pos : 0 < ∏ f : {f // f ∈ C}, Int.natAbs (z f) := by
    apply Finset.prod_pos
    intro f _
    exact Int.natAbs_pos.mpr (hz_ne f)
  have hL_le : L ≤ ∏ f : {f // f ∈ C}, Int.natAbs (z f) := by
    apply Nat.le_of_dvd hprod_pos
    exact Finset.lcm_dvd_prod (Finset.univ : Finset {f // f ∈ C})
      (fun f ↦ Int.natAbs (z f))
  let f0sub : {f // f ∈ C} := ⟨f0, hf0⟩
  have htype_nonempty : Nonempty {f // f ∈ C} := ⟨f0sub⟩
  obtain ⟨k, hcard⟩ := Nat.exists_eq_succ_of_ne_zero
    (ne_of_gt (Fintype.card_pos_iff.mpr htype_nonempty))
  have hl1v : 1 ≤ l1Norm v := by
    apply Nat.one_le_iff_ne_zero.mpr
    intro hvnorm
    exact hv.1 (l1Norm_eq_zero.mp hvnorm)
  have heuv : (1 : ℝ) ≤ euclideanNorm v := one_le_euclideanNorm hv.1
  have hl1pow : l1Norm v ≤ l1Norm v ^ Fintype.card {f // f ∈ C} := by
    rw [hcard]
    calc
      l1Norm v = 1 * l1Norm v := by simp
      _ ≤ l1Norm v ^ k * l1Norm v :=
        Nat.mul_le_mul_right _ (one_le_pow₀ hl1v)
      _ = l1Norm v ^ (k + 1) := (pow_succ _ _).symm
  have heupow : euclideanNorm v ≤
      euclideanNorm v ^ Fintype.card {f // f ∈ C} := by
    rw [hcard]
    calc
      euclideanNorm v = 1 * euclideanNorm v := by simp
      _ ≤ euclideanNorm v ^ k * euclideanNorm v :=
        mul_le_mul_of_nonneg_right (one_le_pow₀ heuv) (norm_nonneg _)
      _ = euclideanNorm v ^ (k + 1) := (pow_succ _ _).symm
  have hprod_l1 : (∏ f ∈ C, l1Norm f) =
      ∏ f : {f // f ∈ C}, Int.natAbs (z f) * l1Norm v := by
    rw [Finset.prod_subtype C (fun _ ↦ Iff.rfl)]
    apply Finset.prod_congr rfl
    intro f _
    rw [hz_decomp f, l1Norm_zsmul]
  have hprod_eu : (∏ f ∈ C, euclideanNorm f) =
      ∏ f : {f // f ∈ C},
        (Int.natAbs (z f) : ℝ) * euclideanNorm v := by
    rw [Finset.prod_subtype C (fun _ ↦ Iff.rfl)]
    apply Finset.prod_congr rfl
    intro f _
    rw [hz_decomp f, euclideanNorm_zsmul]
  have hh_ne : (L : ℤ) • v ≠ 0 := by
    intro hh
    have hnorm : l1Norm ((L : ℤ) • v) = 0 := by rw [hh, l1Norm_eq_zero.mpr rfl]
    rw [l1Norm_zsmul] at hnorm
    have hLabs : Int.natAbs (L : ℤ) ≠ 0 := by
      exact Int.natAbs_ne_zero.mpr (by exact_mod_cast hL_ne)
    exact (Nat.mul_ne_zero hLabs (Nat.one_le_iff_ne_zero.mp hl1v)) hnorm
  refine ⟨(L : ℤ) • v, hh_ne, ?_, ?_, ?_⟩
  · intro f hf
    let fs : {f // f ∈ C} := ⟨f, hf⟩
    have hdvd_nat : Int.natAbs (z fs) ∣ L := by
      exact Finset.dvd_lcm (f := fun x : {f // f ∈ C} ↦
        Int.natAbs (z x)) (Finset.mem_univ fs)
    have hdvd_int : z fs ∣ (L : ℤ) := by
      rw [← Int.natAbs_dvd]
      exact Int.natCast_dvd_natCast.mpr hdvd_nat
    obtain ⟨q, hq⟩ := hdvd_int
    have hq_ne : q ≠ 0 := by
      intro hq0
      apply hL_ne
      have hLcast : (L : ℤ) = 0 := by rw [hq, hq0, mul_zero]
      exact_mod_cast hLcast
    refine ⟨q, hq_ne, ?_⟩
    rw [show f = z fs • v by exact hz_decomp fs, hq]
    simp [mul_smul, mul_comm]
  · rw [l1Norm_zsmul, hprod_l1]
    simp only [Int.natAbs_natCast]
    calc
      L * l1Norm v ≤
          (∏ f : {f // f ∈ C}, Int.natAbs (z f)) * l1Norm v :=
        Nat.mul_le_mul_right _ hL_le
      _ ≤ (∏ f : {f // f ∈ C}, Int.natAbs (z f)) *
          l1Norm v ^ Fintype.card {f // f ∈ C} :=
        Nat.mul_le_mul_left _ hl1pow
      _ = ∏ f : {f // f ∈ C}, Int.natAbs (z f) * l1Norm v := by
        simp [Finset.prod_mul_distrib]
  · rw [euclideanNorm_zsmul, hprod_eu]
    simp only [Int.natAbs_natCast]
    have hL_le_real : (L : ℝ) ≤
        ((∏ f : {f // f ∈ C}, Int.natAbs (z f) : ℕ) : ℝ) := by
      exact_mod_cast hL_le
    calc
      (L : ℝ) * euclideanNorm v ≤
          ((∏ f : {f // f ∈ C}, Int.natAbs (z f) : ℕ) : ℝ) *
            euclideanNorm v :=
        mul_le_mul_of_nonneg_right hL_le_real (norm_nonneg _)
      _ = (∏ f : {f // f ∈ C}, (Int.natAbs (z f) : ℝ)) *
          euclideanNorm v := by norm_cast
      _ ≤ (∏ f : {f // f ∈ C}, (Int.natAbs (z f) : ℝ)) *
          euclideanNorm v ^ Fintype.card {f // f ∈ C} :=
        mul_le_mul_of_nonneg_left heupow (Finset.prod_nonneg fun _ _ ↦ by positivity)
      _ = ∏ f : {f // f ∈ C},
          (Int.natAbs (z f) : ℝ) * euclideanNorm v := by
        simp [Finset.prod_mul_distrib]

/--
A primitive planar vector can be sent to the first basis vector by an integral
determinant-one map.
-/
theorem exists_SL2Z_send_primitive_to_e0 {h : Plane}
    (hh : IsPrimitive h) :
    ∃ e : Plane ≃ₗ[ℤ] Plane,
      LinearMap.det e.toLinearMap = 1 ∧ e h = ![1, 0] := by
  obtain ⟨a, ha⟩ := primitive_bezout hh
  have ha2 : a 0 * h 0 + a 1 * h 1 = 1 := by
    simpa [Fin.sum_univ_two] using ha
  let A : Matrix (Fin 2) (Fin 2) ℤ :=
    !![a 0, a 1; -h 1, h 0]
  have hA : A.det = 1 := by
    rw [Matrix.det_fin_two]
    simp [A]
    linear_combination ha2
  let g : Matrix.SpecialLinearGroup (Fin 2) ℤ := ⟨A, hA⟩
  let e : Plane ≃ₗ[ℤ] Plane := Matrix.SpecialLinearGroup.toLin' g
  refine ⟨e, ?_, ?_⟩
  · change LinearMap.det (Matrix.toLin' A) = 1
    rw [LinearMap.det_toLin']
    exact hA
  · rw [show e h = Matrix.toLin' A h by rfl, Matrix.toLin'_apply]
    funext i
    fin_cases i
    · simp [A, Matrix.mulVec, dotProduct, Fin.sum_univ_two, ha2]
    · simp [A, Matrix.mulVec, dotProduct, Fin.sum_univ_two]
      ring

/--
For a finite family of nonzero planar vectors, `avoidanceVector` is nonzero,
incommensurable with every member, and has `ℓ¹` norm at most `m + 1`.
-/
theorem avoidanceVector_spec {m : ℕ} {h : Fin m → Plane}
    (hne : ∀ i, h i ≠ 0) :
    avoidanceVector h ≠ 0 ∧
      (∀ i, ¬ Commensurable (avoidanceVector h) (h i)) ∧
      l1Norm (avoidanceVector h) ≤ m + 1 := by
  classical
  have hex : ∃ t : Fin (m + 1),
      ∀ i, wedge (slopeVector t.val) (h i) ≠ 0 := by
    by_contra hno
    push Not at hno
    let bad : Fin (m + 1) → Fin m := fun t ↦ Classical.choose (hno t)
    have hbad (t : Fin (m + 1)) :
        wedge (slopeVector t.val) (h (bad t)) = 0 :=
      Classical.choose_spec (hno t)
    have hbad_injective : Function.Injective bad := by
      intro t s hts
      have ht := hbad t
      have hs := hbad s
      rw [hts] at ht
      have hcoord0 : h (bad s) 0 ≠ 0 := by
        intro h0
        have h1 : h (bad s) 1 = 0 := by
          simpa [wedge, slopeVector, h0] using hs
        exact hne (bad s) (plane_eq_zero_of_coords h0 h1)
      have hmul : ((t.val : ℤ) - (s.val : ℤ)) * h (bad s) 0 = 0 := by
        simp [wedge, slopeVector] at ht hs
        linear_combination hs - ht
      have hcast : (t.val : ℤ) = (s.val : ℤ) := by
        exact sub_eq_zero.mp ((mul_eq_zero.mp hmul).resolve_right hcoord0)
      exact Fin.ext (Int.ofNat_inj.mp hcast)
    have hcard := Fintype.card_le_of_injective bad hbad_injective
    simp at hcard
  obtain ⟨t, ht⟩ := hex
  have ht_mem : t.val ∈ List.range (m + 1) := List.mem_range.mpr t.isLt
  have ht_bool : avoidsDirections h t.val = true := by
    simpa [avoidsDirections] using ht
  have hsome :
      ((List.range (m + 1)).find? (avoidsDirections h)).isSome = true :=
    List.find?_isSome.mpr ⟨t.val, ht_mem, ht_bool⟩
  obtain ⟨s, hs⟩ := Option.isSome_iff_exists.mp hsome
  have hs_bool : avoidsDirections h s = true := List.find?_some hs
  have hs_good : ∀ i, wedge (slopeVector s) (h i) ≠ 0 := by
    simpa [avoidsDirections] using hs_bool
  have hs_mem : s ∈ List.range (m + 1) := List.mem_of_find?_eq_some hs
  have hs_lt : s < m + 1 := List.mem_range.mp hs_mem
  have hslope : avoidanceSlope h = s := by
    simp [avoidanceSlope, hs]
  have hav_ne : avoidanceVector h ≠ 0 := by
    intro hz
    have hz0 := congr_fun hz 0
    simp [avoidanceVector, hslope, slopeVector] at hz0
  refine ⟨hav_ne, ?_, ?_⟩
  · intro i hcomm
    have hw := (commensurable_iff_wedge_eq_zero hav_ne (hne i)).1 hcomm
    exact hs_good i (by simpa [avoidanceVector, hslope] using hw)
  · simpa [avoidanceVector, hslope, slopeVector, l1Norm, Fin.sum_univ_two,
      Nat.add_comm] using (Nat.succ_le_iff.mpr hs_lt)

/-- The pair-wedge least common multiple is positive for a pairwise-incommensurable family. -/
theorem pairWedgeLCM_pos {m : ℕ} {h : Fin m → Plane}
    (hne : ∀ i, h i ≠ 0) (hpair : PairwiseIncommensurable h) :
    0 < pairWedgeLCM h := by
  rw [Nat.pos_iff_ne_zero]
  intro hzero
  rw [pairWedgeLCM, Finset.lcm_eq_zero_iff] at hzero
  obtain ⟨ij, hij, hw⟩ := hzero
  have hij_ne : ij.1 ≠ ij.2 := by
    have hp : ij.1 ≠ ij.2 ∧ ij.1 < ij.2 := by
      simpa [unorderedPairs] using hij
    exact hp.1
  have hw_ne : wedge (h ij.1) (h ij.2) ≠ 0 := by
    intro hw0
    exact hpair ij.1 ij.2 hij_ne
      ((commensurable_iff_wedge_eq_zero (hne ij.1) (hne ij.2)).2 hw0)
  exact Int.natAbs_ne_zero.mpr hw_ne hw

/--
The scalar lattice at `pairWedgeLCM h` lies in the subgroup generated by any
two distinct members of the family.
-/
theorem pairWedgeLCM_scalarLattice_le {m : ℕ}
    {h : Fin m → Plane} (_hne : ∀ i, h i ≠ 0)
    (_hpair : PairwiseIncommensurable h) {i j : Fin m} (hij : i ≠ j) :
    scalarLattice (pairWedgeLCM h) ≤ generatedPair (h i) (h j) := by
  have hdvd : Int.natAbs (wedge (h i) (h j)) ∣ pairWedgeLCM h := by
    unfold pairWedgeLCM
    rcases lt_or_gt_of_ne hij with hij_lt | hji_lt
    · exact Finset.dvd_lcm (f := fun ij ↦
          Int.natAbs (wedge (h ij.1) (h ij.2)))
        (show (i, j) ∈ unorderedPairs m by
          simp [unorderedPairs, hij, hij_lt])
    · have hdvd' : Int.natAbs (wedge (h j) (h i)) ∣
          (unorderedPairs m).lcm (fun ij : Fin m × Fin m ↦
            Int.natAbs (wedge (h ij.1) (h ij.2))) :=
        Finset.dvd_lcm (f := fun ij : Fin m × Fin m ↦
          Int.natAbs (wedge (h ij.1) (h ij.2)))
        (show (j, i) ∈ unorderedPairs m by
          simp [unorderedPairs, hij.symm, hji_lt])
      calc
        Int.natAbs (wedge (h i) (h j)) =
            Int.natAbs (wedge (h j) (h i)) := by
          rw [wedge_swap (h i) (h j), Int.natAbs_neg]
        _ ∣ (unorderedPairs m).lcm (fun ij : Fin m × Fin m ↦
            Int.natAbs (wedge (h ij.1) (h ij.2))) := hdvd'
  exact le_trans (scalarLattice_mono_dvd hdvd)
    (scalarLattice_natAbs_wedge_le_generatedPair (h i) (h j))

/-- The pair-wedge least common multiple is bounded by the product of the family `ℓ¹` norms. -/
theorem pairWedgeLCM_bound {m : ℕ} {h : Fin m → Plane}
    (hne : ∀ i, h i ≠ 0) (hpair : PairwiseIncommensurable h) :
    pairWedgeLCM h ≤ ∏ i, l1Norm (h i) ^ (m - 1) := by
  classical
  let D : Finset (Fin m × Fin m) := Finset.univ.offDiag
  let E : Finset (Fin m × Fin m) :=
    D.filter fun ij ↦ ij.1 < ij.2
  let F : Finset (Fin m × Fin m) :=
    D.filter fun ij ↦ ij.2 < ij.1
  have hE : E = unorderedPairs m := by rfl
  have hedge_ne (ij : Fin m × Fin m) (hij : ij ∈ E) :
      wedge (h ij.1) (h ij.2) ≠ 0 := by
    have hij_ne : ij.1 ≠ ij.2 := by
      have hp := Finset.mem_filter.mp hij
      exact (Finset.mem_offDiag.mp hp.1).2.2
    intro hw
    exact hpair ij.1 ij.2 hij_ne
      ((commensurable_iff_wedge_eq_zero (hne ij.1) (hne ij.2)).2 hw)
  have hdet_prod_pos :
      0 < ∏ ij ∈ E, Int.natAbs (wedge (h ij.1) (h ij.2)) := by
    apply Finset.prod_pos
    intro ij hij
    exact Int.natAbs_pos.mpr (hedge_ne ij hij)
  have hlcm_prod : pairWedgeLCM h ≤
      ∏ ij ∈ E, Int.natAbs (wedge (h ij.1) (h ij.2)) := by
    apply Nat.le_of_dvd hdet_prod_pos
    rw [pairWedgeLCM, ← hE]
    exact Finset.lcm_dvd_prod E fun ij ↦
      Int.natAbs (wedge (h ij.1) (h ij.2))
  have hdet_norm :
      (∏ ij ∈ E, Int.natAbs (wedge (h ij.1) (h ij.2))) ≤
        ∏ ij ∈ E, l1Norm (h ij.1) * l1Norm (h ij.2) := by
    apply Finset.prod_le_prod
    · intro _ _
      exact Nat.zero_le _
    · intro ij _
      exact natAbs_wedge_le_l1Norm_mul_l1Norm (h ij.1) (h ij.2)
  have hswap : (∏ ij ∈ E, l1Norm (h ij.2)) =
      ∏ ij ∈ F, l1Norm (h ij.1) := by
    apply Finset.prod_bij (fun ij _ ↦ (ij.2, ij.1))
    · intro ij hij
      have hp := Finset.mem_filter.mp hij
      apply Finset.mem_filter.mpr
      refine ⟨?_, hp.2⟩
      have hd := Finset.mem_offDiag.mp hp.1
      exact Finset.mem_offDiag.mpr ⟨hd.2.1, hd.1, hd.2.2.symm⟩
    · intro a₁ ha₁ a₂ ha₂ heq
      exact Prod.swap_injective heq
    · intro ij hij
      refine ⟨(ij.2, ij.1), ?_, ?_⟩
      · have hp := Finset.mem_filter.mp hij
        apply Finset.mem_filter.mpr
        refine ⟨?_, hp.2⟩
        have hd := Finset.mem_offDiag.mp hp.1
        exact Finset.mem_offDiag.mpr ⟨hd.2.1, hd.1, hd.2.2.symm⟩
      · rfl
    · intro _ _
      rfl
  have hdisj : Disjoint E F := by
    rw [Finset.disjoint_left]
    intro ij hijE hijF
    have he := (Finset.mem_filter.mp hijE).2
    have hf := (Finset.mem_filter.mp hijF).2
    exact (not_lt_of_ge (le_of_lt hf)) he
  have hunion : E ∪ F = D := by
    ext ij
    constructor
    · intro hij
      rcases Finset.mem_union.mp hij with hij | hij
      · exact (Finset.mem_filter.mp hij).1
      · exact (Finset.mem_filter.mp hij).1
    · intro hij
      have hij_ne : ij.1 ≠ ij.2 := (Finset.mem_offDiag.mp hij).2.2
      rcases lt_or_gt_of_ne hij_ne with hlt | hgt
      · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨hij, hlt⟩)
      · exact Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨hij, hgt⟩)
  have hfiber_card (i : Fin m) :
      (D.filter fun ij ↦ ij.1 = i).card = m - 1 := by
    calc
      (D.filter fun ij ↦ ij.1 = i).card =
          ((Finset.univ : Finset (Fin m)).erase i).card := by
        apply Finset.card_bij (fun ij _ ↦ ij.2)
        · intro ij hij
          have hp := Finset.mem_filter.mp hij
          have hneij := (Finset.mem_offDiag.mp hp.1).2.2
          rw [Finset.mem_erase]
          exact ⟨fun hji ↦ hneij (hp.2.trans hji.symm), Finset.mem_univ _⟩
        · intro a₁ ha₁ a₂ ha₂ heq
          apply Prod.ext
          · exact (Finset.mem_filter.mp ha₁).2.trans
              (Finset.mem_filter.mp ha₂).2.symm
          · exact heq
        · intro j hj
          have hji : j ≠ i := (Finset.mem_erase.mp hj).1
          refine ⟨(i, j), ?_, rfl⟩
          apply Finset.mem_filter.mpr
          refine ⟨?_, rfl⟩
          exact Finset.mem_offDiag.mpr
            ⟨Finset.mem_univ _, Finset.mem_univ _, hji.symm⟩
      _ = m - 1 := by
        rw [Finset.card_erase_of_mem (Finset.mem_univ i)]
        simp
  have hordered : (∏ ij ∈ D, l1Norm (h ij.1)) =
      ∏ i, l1Norm (h i) ^ (m - 1) := by
    calc
      (∏ ij ∈ D, l1Norm (h ij.1)) =
          ∏ i, ∏ ij ∈ D with ij.1 = i, l1Norm (h ij.1) :=
        (Finset.prod_fiberwise D Prod.fst
          (fun ij ↦ l1Norm (h ij.1))).symm
      _ = ∏ i, l1Norm (h i) ^ (m - 1) := by
        apply Finset.prod_congr rfl
        intro i _
        calc
          (∏ ij ∈ D with ij.1 = i, l1Norm (h ij.1)) =
              l1Norm (h i) ^ (D.filter fun ij ↦ ij.1 = i).card := by
            apply Finset.prod_eq_pow_card
            intro ij hij
            rw [(Finset.mem_filter.mp hij).2]
          _ = l1Norm (h i) ^ (m - 1) := by rw [hfiber_card i]
  have hnorm_product :
      (∏ ij ∈ E, l1Norm (h ij.1) * l1Norm (h ij.2)) =
        ∏ i, l1Norm (h i) ^ (m - 1) := by
    calc
      (∏ ij ∈ E, l1Norm (h ij.1) * l1Norm (h ij.2)) =
          (∏ ij ∈ E, l1Norm (h ij.1)) *
            ∏ ij ∈ E, l1Norm (h ij.2) := by
        rw [Finset.prod_mul_distrib]
      _ = (∏ ij ∈ E, l1Norm (h ij.1)) *
            ∏ ij ∈ F, l1Norm (h ij.1) := by rw [hswap]
      _ = ∏ ij ∈ E ∪ F, l1Norm (h ij.1) :=
        (Finset.prod_union hdisj).symm
      _ = ∏ ij ∈ D, l1Norm (h ij.1) := by rw [hunion]
      _ = ∏ i, l1Norm (h i) ^ (m - 1) := hordered
  exact hlcm_prod.trans (hdet_norm.trans_eq hnorm_product)

end TranslationalTilings
