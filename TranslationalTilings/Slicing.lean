import TranslationalTilings.Dilation.Periodic
import TranslationalTilings.LatticeGeometry

/-!
# Slicing along primitive lattice directions

This file implements the slicing construction used in the periodic-completion
argument.  A tile slice consists of the tile points on one coset of a rank-one
direction subgroup; `slicingLCM` records the nonzero transverse determinants.
-/

set_option relaxedAutoImplicit false
set_option maxSynthPendingDepth 3

open scoped BigOperators Real

namespace TranslationalTilings

/-- The rank-one subgroup generated by a lattice direction. -/
def directionSubgroup (h : Plane) : AddSubgroup Plane :=
  AddSubgroup.zmultiples h

/-- The portion of a tile lying in the affine line through `x` parallel to `h`. -/
noncomputable def tileSlice (F : Finset Plane) (h x : Plane) : Finset Plane := by
  classical
  exact F.filter fun f ↦ f ∈ addCoset (directionSubgroup h) x

/-- Pairs of tile points whose difference is transverse to `h`. -/
def slicingPairs (F : Finset Plane) (h : Plane) :
    Finset (Plane × Plane) :=
  (F ×ˢ F).filter fun ff ↦ wedge h (ff.1 - ff.2) ≠ 0

/-- The least common multiple of the nonzero transverse wedge magnitudes. -/
def slicingLCM (F : Finset Plane) (h : Plane) : ℕ :=
  (slicingPairs F h).lcm fun ff ↦
    Int.natAbs (wedge h (ff.1 - ff.2))

/-- The restriction of a set to a quotient-indexed affine line. -/
def slicePattern (h : Plane)
    (line : Plane ⧸ directionSubgroup h) (A : Set Plane) : Set Plane :=
  A ∩ quotientCoset (directionSubgroup h) line

/-- Two sets are convolution-equivalent for the fixed tile `F`. -/
def convolutionEquivalent {G : Type*} [AddCommGroup G]
    (F : Finset G) (A B : Set G) : Prop :=
  tileConv F (setIndicator A) = tileConv F (setIndicator B)

/-- Characterize when an affine tile slice is empty. -/
theorem tileSlice_eq_empty_iff (F : Finset Plane) (h x : Plane) :
    tileSlice F h x = ∅ ↔ ∀ f ∈ F, f ∉ addCoset (directionSubgroup h) x := by
  classical
  simp [tileSlice]

/-- Translating a tile translates its affine slices. -/
theorem tileSlice_translate (F : Finset Plane) (h x a : Plane) :
    tileSlice (F.image (fun f ↦ f + a)) h (x + a) =
      (tileSlice F h x).image (fun f ↦ f + a) := by
  classical
  ext y
  constructor
  · intro hy
    simp only [tileSlice, Finset.mem_filter, Finset.mem_image] at hy ⊢
    obtain ⟨f, hf, rfl⟩ := hy.1
    refine ⟨f, ⟨hf, ?_⟩, rfl⟩
    simpa only [addCoset, Set.mem_ofPred_eq,
      show f + a - (x + a) = f - x by abel] using hy.2
  · intro hy
    simp only [tileSlice, Finset.mem_filter, Finset.mem_image] at hy ⊢
    obtain ⟨f, ⟨hf, hcoset⟩, rfl⟩ := hy
    refine ⟨⟨f, hf, rfl⟩, ?_⟩
    simpa only [addCoset, Set.mem_ofPred_eq,
      show f + a - (x + a) = f - x by abel] using hcoset

/-- The slicing least common multiple is always positive. -/
theorem slicingLCM_pos (F : Finset Plane) (h : Plane) :
    0 < slicingLCM F h := by
  rw [Nat.pos_iff_ne_zero]
  intro hzero
  rw [slicingLCM, Finset.lcm_eq_zero_iff] at hzero
  obtain ⟨ff, hff, hfactor⟩ := hzero
  have hwedge : wedge h (ff.1 - ff.2) ≠ 0 := by
    exact (Finset.mem_filter.mp hff).2
  exact Int.natAbs_ne_zero.mpr hwedge hfactor

/-- Every transverse wedge magnitude divides the slicing least common multiple. -/
theorem wedge_difference_dvd_slicingLCM
    {f f' : Plane} (hf : f ∈ F) (hf' : f' ∈ F)
    (hwedge : wedge h (f - f') ≠ 0) :
    Int.natAbs (wedge h (f - f')) ∣ slicingLCM F h := by
  unfold slicingLCM
  exact Finset.dvd_lcm (s := slicingPairs F h)
    (f := fun ff : Plane × Plane ↦ Int.natAbs (wedge h (ff.1 - ff.2)))
    (show (f, f') ∈ slicingPairs F h by simp [slicingPairs, hf, hf', hwedge])

private def slicingUnorderedPairs (F : Finset Plane) (h : Plane) :
    Finset (Plane × Plane) :=
  (F ×ˢ F).filter fun ff ↦ 0 < wedge h (ff.1 - ff.2)

private theorem slicingLCM_eq_unorderedLCM (F : Finset Plane) (h : Plane) :
    slicingLCM F h = (slicingUnorderedPairs F h).lcm fun ff ↦
      Int.natAbs (wedge h (ff.1 - ff.2)) := by
  apply Nat.dvd_antisymm
  · rw [slicingLCM, Finset.lcm_dvd_iff]
    intro ff hff
    have hdata := Finset.mem_filter.mp hff
    have hmem : ff.1 ∈ F ∧ ff.2 ∈ F := by simpa using hdata.1
    have hwedge : wedge h (ff.1 - ff.2) ≠ 0 := hdata.2
    have hne : ff.1 ≠ ff.2 := by
      intro heq
      apply hwedge
      simp [heq, wedge]
    rcases lt_or_gt_of_ne hwedge with hneg | hpos
    · have hswap : (ff.2, ff.1) ∈ slicingUnorderedPairs F h := by
        have hwedgeSwap : wedge h (ff.2 - ff.1) ≠ 0 := by
          rw [show ff.2 - ff.1 = -(ff.1 - ff.2) by abel,
            show wedge h (-(ff.1 - ff.2)) = -wedge h (ff.1 - ff.2) by
              rw [← neg_one_smul ℤ (ff.1 - ff.2), wedge_zsmul_right]
              simp]
          exact neg_ne_zero.mpr hwedge
        have hswapValue : wedge h (ff.2 - ff.1) = -wedge h (ff.1 - ff.2) := by
          rw [show ff.2 - ff.1 = -(ff.1 - ff.2) by abel,
            ← neg_one_smul ℤ (ff.1 - ff.2), wedge_zsmul_right]
          simp
        simp [slicingUnorderedPairs, hmem.1, hmem.2, hswapValue, hneg]
      have hdvd := Finset.dvd_lcm (f := fun pp : Plane × Plane ↦
        Int.natAbs (wedge h (pp.1 - pp.2))) hswap
      calc
        Int.natAbs (wedge h (ff.1 - ff.2)) =
            Int.natAbs (wedge h (ff.2 - ff.1)) := by
          rw [show wedge h (ff.2 - ff.1) = -wedge h (ff.1 - ff.2) by
            rw [show ff.2 - ff.1 = -(ff.1 - ff.2) by abel,
              ← neg_one_smul ℤ (ff.1 - ff.2), wedge_zsmul_right]
            simp, Int.natAbs_neg]
        _ ∣ (slicingUnorderedPairs F h).lcm (fun pp ↦
            Int.natAbs (wedge h (pp.1 - pp.2))) := hdvd
    · exact Finset.dvd_lcm (show ff ∈ slicingUnorderedPairs F h by
        simp [slicingUnorderedPairs, hmem.1, hmem.2, hpos])
  · rw [Finset.lcm_dvd_iff]
    intro ff hff
    apply Finset.dvd_lcm
    have hdata := Finset.mem_filter.mp hff
    exact Finset.mem_filter.mpr ⟨hdata.1, ne_of_gt hdata.2⟩

private theorem slicingUnorderedPairs_card_le (F : Finset Plane) (h : Plane) :
    (slicingUnorderedPairs F h).card ≤ F.card * (F.card - 1) / 2 := by
  classical
  let U := slicingUnorderedPairs F h
  let pairSet : Plane × Plane → Finset Plane := fun ff ↦ {ff.1, ff.2}
  have hpairSetMem (ff : Plane × Plane) (hff : ff ∈ U) :
      pairSet ff ∈ F.powersetCard 2 := by
    have hdata := Finset.mem_filter.mp hff
    have hne : ff.1 ≠ ff.2 := by
      intro heq
      have : wedge h (ff.1 - ff.2) = 0 := by simp [heq, wedge]
      omega
    rw [Finset.mem_powersetCard]
    constructor
    · intro y hy
      simp only [pairSet, Finset.mem_insert, Finset.mem_singleton] at hy
      rcases hy with rfl | rfl <;> simp_all
    · exact Finset.card_pair hne
  have hinj : Set.InjOn pairSet U := by
    intro a ha b hb hab
    have haData := Finset.mem_filter.mp ha
    have hbData := Finset.mem_filter.mp hb
    have haFirst : a.1 = b.1 ∨ a.1 = b.2 := by
      have : a.1 ∈ pairSet b := by rw [← hab]; simp [pairSet]
      simpa [pairSet] using this
    have haSecond : a.2 = b.1 ∨ a.2 = b.2 := by
      have : a.2 ∈ pairSet b := by rw [← hab]; simp [pairSet]
      simpa [pairSet] using this
    rcases haFirst with h11 | h12 <;> rcases haSecond with h21 | h22
    · have haeq : a.1 = a.2 := h11.trans h21.symm
      simp [haeq, wedge] at haData
    · exact Prod.ext h11 h22
    · have hswap : wedge h (b.1 - b.2) = -wedge h (a.1 - a.2) := by
        rw [← h21, ← h12]
        rw [show a.2 - a.1 = -(a.1 - a.2) by abel,
          ← neg_one_smul ℤ (a.1 - a.2), wedge_zsmul_right]
        simp
      omega
    · have haeq : a.1 = a.2 := h12.trans h22.symm
      simp [haeq, wedge] at haData
  calc
    U.card = (U.image pairSet).card := (Finset.card_image_iff.mpr hinj).symm
    _ ≤ (F.powersetCard 2).card := Finset.card_le_card (fun s hs ↦ by
      obtain ⟨ff, hff, rfl⟩ := Finset.mem_image.mp hs
      exact hpairSetMem ff hff)
    _ = F.card * (F.card - 1) / 2 := by
      rw [Finset.card_powersetCard, Nat.choose_two_right]

/-- Bound the slicing least common multiple using the tile diameter. -/
theorem slicingLCM_bound
    (F : Finset Plane) {h : Plane} (hprimitive : IsPrimitive h) :
    slicingLCM F h ≤
      (l1Norm h * l1Diameter F) ^ (F.card * (F.card - 1) / 2) := by
  classical
  let U := slicingUnorderedPairs F h
  let B := l1Norm h * l1Diameter F
  have hfactor (ff : Plane × Plane) (hff : ff ∈ U) :
      Int.natAbs (wedge h (ff.1 - ff.2)) ≤ B := by
    have hmem := Finset.mem_filter.mp hff
    have hdiam : l1Norm (ff.1 - ff.2) ≤ l1Diameter F := by
      exact Finset.le_sup (f := fun xy : Plane × Plane ↦ l1Norm (xy.1 - xy.2)) hmem.1
    exact (natAbs_wedge_le_l1Norm_mul_l1Norm h (ff.1 - ff.2)).trans
      (Nat.mul_le_mul_left _ hdiam)
  have hprodBound :
      (∏ ff ∈ U, Int.natAbs (wedge h (ff.1 - ff.2))) ≤ B ^ U.card := by
    rw [← Finset.prod_const]
    exact Finset.prod_le_prod (fun _ _ ↦ Nat.zero_le _) hfactor
  have hUfactorPos (ff : Plane × Plane) (hff : ff ∈ U) :
      0 < Int.natAbs (wedge h (ff.1 - ff.2)) := by
    exact Int.natAbs_pos.mpr (ne_of_gt (Finset.mem_filter.mp hff).2)
  have hlcmProd : slicingLCM F h ≤
      ∏ ff ∈ U, Int.natAbs (wedge h (ff.1 - ff.2)) := by
    rw [slicingLCM_eq_unorderedLCM]
    apply Nat.le_of_dvd
    · exact Finset.prod_pos hUfactorPos
    · exact Finset.lcm_dvd_prod U fun ff ↦
        Int.natAbs (wedge h (ff.1 - ff.2))
  have hcard := slicingUnorderedPairs_card_le F h
  by_cases hU : U.Nonempty
  · obtain ⟨ff, hff⟩ := hU
    have hBpos : 0 < B := (hUfactorPos ff hff).trans_le (hfactor ff hff)
    exact hlcmProd.trans (hprodBound.trans
      (Nat.pow_le_pow_right hBpos (slicingUnorderedPairs_card_le F h)))
  · have hUempty : U = ∅ := Finset.not_nonempty_iff_eq_empty.mp hU
    rw [hUempty] at hlcmProd
    have hrightPos : 0 < B ^ (F.card * (F.card - 1) / 2) := by
      by_cases hcardSmall : F.card ≤ 1
      · rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hcardSmall with hcard | hcard <;>
          simp [hcard]
      · have hFcard : 2 ≤ F.card := by omega
        obtain ⟨f, hf, f', hf', hne⟩ :=
          Finset.one_lt_card.mp (by omega : 1 < F.card)
        have hdiamPos : 0 < l1Diameter F := by
          have hnormPos : 0 < l1Norm (f - f') := by
            rw [Nat.pos_iff_ne_zero]
            intro hnorm
            exact hne (sub_eq_zero.mp (l1Norm_eq_zero.mp hnorm))
          exact hnormPos.trans_le
            (Finset.le_sup (f := fun xy : Plane × Plane ↦ l1Norm (xy.1 - xy.2))
              (show (f, f') ∈ F ×ˢ F by simp [hf, hf']))
        have hhNorm : 0 < l1Norm h :=
          Nat.pos_iff_ne_zero.mpr ((l1Norm_eq_zero).not.mpr hprimitive.1)
        have hBpos : 0 < B := Nat.mul_pos hhNorm hdiamPos
        exact pow_pos hBpos _
    exact hlcmProd.trans (Nat.one_le_iff_ne_zero.mpr hrightPos.ne')

/-- Unfold membership in a quotient-indexed slice pattern. -/
theorem mem_slicePattern
    {h : Plane} {line : Plane ⧸ directionSubgroup h} {A : Set Plane}
    (y : Plane) :
    y ∈ slicePattern h line A ↔
      y ∈ A ∧ QuotientAddGroup.mk' (directionSubgroup h) y = line := by
  rfl

private noncomputable def slicingAverage (q k N : ℕ) (f f₀ : Plane)
    (A : Set Plane) (y : Plane) : ℝ :=
  ((N + 1 : ℕ) : ℝ)⁻¹ * ∑ n ∈ Finset.range (N + 1),
    ((setIndicator A
      (y - f - (((n * q * k : ℕ) : ℤ) • (f - f₀))) : ℤ) : ℝ)

private theorem real_indicator_mem_Icc (A : Set Plane) (x : Plane) :
    ((setIndicator A x : ℤ) : ℝ) ∈ Set.Icc (0 : ℝ) 1 := by
  by_cases hx : x ∈ A <;> simp [setIndicator, hx]

private theorem slicingAverage_mem_Icc (q k N : ℕ) (f f₀ : Plane)
    (A : Set Plane) (y : Plane) :
    slicingAverage q k N f f₀ A y ∈ Set.Icc (0 : ℝ) 1 := by
  have hterm (n : ℕ) :
      ((setIndicator A
        (y - f - (((n * q * k : ℕ) : ℤ) • (f - f₀))) : ℤ) : ℝ) ∈
        Set.Icc (0 : ℝ) 1 := real_indicator_mem_Icc A _
  have hsumNonneg : 0 ≤ ∑ n ∈ Finset.range (N + 1),
      ((setIndicator A
        (y - f - (((n * q * k : ℕ) : ℤ) • (f - f₀))) : ℤ) : ℝ) :=
    Finset.sum_nonneg fun n _ ↦ (hterm n).1
  have hsumUpper : (∑ n ∈ Finset.range (N + 1),
      ((setIndicator A
        (y - f - (((n * q * k : ℕ) : ℤ) • (f - f₀))) : ℤ) : ℝ)) ≤
      (((N + 1 : ℕ) : ℝ)) := by
    simpa using Finset.sum_le_card_nsmul (Finset.range (N + 1))
      (fun n ↦ ((setIndicator A
        (y - f - (((n * q * k : ℕ) : ℤ) • (f - f₀))) : ℤ) : ℝ)) 1
      (fun n _ ↦ (hterm n).2)
  have hdenom : (0 : ℝ) < ((N + 1 : ℕ) : ℝ) := by positivity
  constructor
  · exact mul_nonneg (inv_nonneg.mpr hdenom.le) hsumNonneg
  · rw [slicingAverage]
    calc
      ((N + 1 : ℕ) : ℝ)⁻¹ * ∑ n ∈ Finset.range (N + 1),
          ((setIndicator A
            (y - f - (((n * q * k : ℕ) : ℤ) • (f - f₀))) : ℤ) : ℝ) ≤
          ((N + 1 : ℕ) : ℝ)⁻¹ * ((N + 1 : ℕ) : ℝ) :=
        mul_le_mul_of_nonneg_left hsumUpper (inv_nonneg.mpr hdenom.le)
      _ = 1 := inv_mul_cancel₀ hdenom.ne'

private theorem slicingAverage_sub_shift (q k N : ℕ) (f f₀ : Plane)
    (A : Set Plane) (y : Plane) :
    slicingAverage q k N f f₀ A
        (y + (((q * k : ℕ) : ℤ) • (f - f₀))) -
      slicingAverage q k N f f₀ A y =
      ((N + 1 : ℕ) : ℝ)⁻¹ *
        (((setIndicator A
          (y + (((q * k : ℕ) : ℤ) • (f - f₀)) - f) : ℤ) : ℝ) -
        ((setIndicator A
          (y - f - (((N * q * k : ℕ) : ℤ) • (f - f₀))) : ℤ) : ℝ)) := by
  let d : Plane := (((q * k : ℕ) : ℤ) • (f - f₀))
  have hstep (n : ℕ) :
      y + d - f - ((((n + 1) * q * k : ℕ) : ℤ) • (f - f₀)) =
        y - f - (((n * q * k : ℕ) : ℤ) • (f - f₀)) := by
    dsimp [d]
    module
  rw [slicingAverage, slicingAverage, Finset.sum_range_succ',
    Finset.sum_range_succ]
  have hstep' (n : ℕ) :
      y + (((q * k : ℕ) : ℤ) • (f - f₀)) - f -
          ((((n + 1) * q * k : ℕ) : ℤ) • (f - f₀)) =
        y - f - (((n * q * k : ℕ) : ℤ) • (f - f₀)) := by
    simpa [d] using hstep n
  simp_rw [hstep']
  simp only [Nat.zero_mul, Nat.cast_zero, zero_smul, sub_zero]
  dsimp [d]
  change ((N + 1 : ℕ) : ℝ)⁻¹ *
      ((∑ n ∈ Finset.range N,
          ((setIndicator A
            (y - f - (((n * q * k : ℕ) : ℤ) • (f - f₀))) : ℤ) : ℝ)) +
        ((setIndicator A (y + d - f) : ℤ) : ℝ)) -
      ((N + 1 : ℕ) : ℝ)⁻¹ *
      ((∑ n ∈ Finset.range N,
          ((setIndicator A
            (y - f - (((n * q * k : ℕ) : ℤ) • (f - f₀))) : ℤ) : ℝ)) +
        ((setIndicator A
          (y - f - (((N * q * k : ℕ) : ℤ) • (f - f₀))) : ℤ) : ℝ)) = _
  dsimp [d]
  ring

private theorem slicingAverage_shift_bound (q k N : ℕ) (f f₀ : Plane)
    (A : Set Plane) (y : Plane) :
    |slicingAverage q k N f f₀ A
        (y + (((q * k : ℕ) : ℤ) • (f - f₀))) -
      slicingAverage q k N f f₀ A y| ≤ ((N + 1 : ℕ) : ℝ)⁻¹ := by
  rw [slicingAverage_sub_shift]
  rw [abs_mul, abs_of_nonneg (inv_nonneg.mpr (by positivity))]
  have hfirst := real_indicator_mem_Icc A
    (y + (((q * k : ℕ) : ℤ) • (f - f₀)) - f)
  have hlast := real_indicator_mem_Icc A
    (y - f - (((N * q * k : ℕ) : ℤ) • (f - f₀)))
  have habs : |(((setIndicator A
      (y + (((q * k : ℕ) : ℤ) • (f - f₀)) - f) : ℤ) : ℝ) -
      ((setIndicator A
        (y - f - (((N * q * k : ℕ) : ℤ) • (f - f₀))) : ℤ) : ℝ))| ≤ 1 := by
    rw [abs_le]
    constructor <;> linarith [hfirst.1, hfirst.2, hlast.1, hlast.2]
  simpa only [mul_one] using mul_le_mul_of_nonneg_left habs
    (inv_nonneg.mpr (show (0 : ℝ) ≤ ((N + 1 : ℕ) : ℝ) by positivity))

private theorem tileConv_dilate_apply_slicing (r : ℕ) (hr : 0 < r)
    (F : Finset Plane) (g : Plane → ℤ) (x : Plane) :
    tileConv (dilate r F) g x = ∑ f ∈ F, g (x - (r : ℤ) • f) := by
  unfold tileConv dilate
  rw [Finset.sum_image]
  intro a _ b _ hab
  apply_fun fun z i ↦ z i at hab
  funext i
  have hrz : (r : ℤ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hr)
  exact mul_left_cancel₀ hrz (congrFun hab i)

private theorem scalar_smul_mem_generated_of_wedge_dvd
    {ell q k s : ℕ} {h d : Plane} (hellq : ell ∣ q)
    (_hwedge : wedge h d ≠ 0) (hdiv : Int.natAbs (wedge h d) ∣ s)
    (z : Plane) :
    (((q * k * s : ℕ) : ℤ) • z) ∈
      generatedPair ((((ell * k : ℕ) : ℤ) • h))
        ((((q * k : ℕ) : ℤ) • d)) := by
  obtain ⟨a, rfl⟩ := hellq
  obtain ⟨c, rfl⟩ := hdiv
  let sign : ℤ := if 0 ≤ wedge h d then 1 else -1
  have habs : (Int.natAbs (wedge h d) : ℤ) = sign * wedge h d := by
    rw [Int.natCast_natAbs]
    by_cases hw : 0 ≤ wedge h d
    · simp [sign, hw, abs_of_nonneg hw]
    · have hw' : wedge h d ≤ 0 := le_of_not_ge hw
      simp [sign, hw, abs_of_nonpos hw']
  have hcramer := cramer_identity h d z
  have hhmem : (((ell * k : ℕ) : ℤ) • h) ∈
      generatedPair ((((ell * k : ℕ) : ℤ) • h))
        (((ell * a * k : ℕ) : ℤ) • d) :=
    AddSubgroup.subset_closure (by simp)
  have hdmem : (((ell * a * k : ℕ) : ℤ) • d) ∈
      generatedPair ((((ell * k : ℕ) : ℤ) • h))
        (((ell * a * k : ℕ) : ℤ) • d) :=
    AddSubgroup.subset_closure (by simp)
  have hcomb := (generatedPair ((((ell * k : ℕ) : ℤ) • h))
      (((ell * a * k : ℕ) : ℤ) • d)).add_mem
    ((generatedPair ((((ell * k : ℕ) : ℤ) • h))
      (((ell * a * k : ℕ) : ℤ) • d)).zsmul_mem hhmem
        (a * sign * c * wedge z d))
    ((generatedPair ((((ell * k : ℕ) : ℤ) • h))
      (((ell * a * k : ℕ) : ℤ) • d)).zsmul_mem hdmem
        (sign * c * wedge h z))
  convert hcomb using 1
  funext i
  have hc := congrFun hcramer i
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul] at hc ⊢
  push_cast at *
  rw [habs]
  linear_combination (ell * a * k * sign * c) * hc

private theorem mem_directionSubgroup_of_wedge_eq_zero {h d : Plane}
    (hh : IsPrimitive h) (hwedge : wedge h d = 0) : d ∈ directionSubgroup h := by
  have hgcd : Int.gcd (h 0) (h 1) = 1 := by
    have hcontent := hh.2
    rw [vectorContent,
      show (Finset.univ : Finset (Fin 2)) = {0, 1} by decide] at hcontent
    simp only [Finset.gcd_insert, Finset.gcd_singleton, normalize_eq,
      gcd_eq_nat_gcd] at hcontent
    simpa only [Nat.gcd_zero_left, Int.gcd_eq_natAbs] using hcontent
  have hbezout : (1 : ℤ) =
      h 0 * Int.gcdA (h 0) (h 1) + h 1 * Int.gcdB (h 0) (h 1) := by
    rw [← Int.gcd_eq_gcd_ab, hgcd]
    norm_num
  let c : ℤ := d 0 * Int.gcdA (h 0) (h 1) +
    d 1 * Int.gcdB (h 0) (h 1)
  rw [directionSubgroup, AddSubgroup.mem_zmultiples_iff]
  refine ⟨c, ?_⟩
  funext i
  fin_cases i
  · simp only [Pi.smul_apply, smul_eq_mul]
    dsimp [c]
    simp [wedge] at hwedge
    linear_combination -d 0 * hbezout + Int.gcdB (h 0) (h 1) * hwedge
  · simp only [Pi.smul_apply, smul_eq_mul]
    dsimp [c]
    simp [wedge] at hwedge
    linear_combination -d 1 * hbezout - Int.gcdA (h 0) (h 1) * hwedge

/-- Greenfeld--Tao, Lemma 5.1. -/
theorem slicing_lemma
    {F : Finset Plane} {A : Set Plane} {ell k : ℕ} {h x : Plane}
    (hell : 0 < ell) (hk : 0 < k) (hh : IsPrimitive h)
    (hAperiod : Function.Periodic (setIndicator A)
      (((ell * k : ℕ) : ℤ) • h))
    (hconvperiod : ScalarPeriodic ell (tileConv F (setIndicator A))) :
    ScalarPeriodic
      (indicatorDilationModulus ell F.card * k * slicingLCM F h)
      (tileConv (tileSlice F h x) (setIndicator A)) := by
  classical
  let S := tileSlice F h x
  by_cases hS : S.Nonempty
  · obtain ⟨f₀, hf₀⟩ := hS
    have hf₀F : f₀ ∈ F := (Finset.mem_filter.mp hf₀).1
    let q := indicatorDilationModulus ell F.card
    let s := slicingLCM F h
    have hqpos : 0 < q := dilationModulus_pos hell
    have hspos : 0 < s := slicingLCM_pos F h
    have hellq : ell ∣ q := ell_dvd_dilationModulus ell 1 F.card
    obtain ⟨a, hqa⟩ := hellq
    have hsample (n : ℕ) (y : Plane) :
        (∑ f ∈ F, ((setIndicator A
          (y - f - (((n * q * k : ℕ) : ℤ) • (f - f₀))) : ℤ) : ℝ)) =
        ((tileConv F (setIndicator A) y : ℤ) : ℝ) := by
      let r : ℕ := 1 + n * q * k
      have hr : 0 < r := by positivity
      have hrmod : Nat.ModEq q r 1 := by
        simpa [r, Nat.mul_assoc, Nat.mul_left_comm, Nat.mul_comm] using
          (Nat.ModEq.modulus_mul_add (m := q) (a := n * k) (b := 1))
      have hdilate := congrFun
        (dilation_indicator_periodic hell hconvperiod hr hrmod)
        (y + (((n * q * k : ℕ) : ℤ) • f₀))
      rw [tileConv_dilate_apply_slicing r hr] at hdilate
      have hright : tileConv F (setIndicator A)
          (y + (((n * q * k : ℕ) : ℤ) • f₀)) =
          tileConv F (setIndicator A) y := by
        have hp := hconvperiod y (((n * a * k : ℕ) : ℤ) • f₀)
        have hshift : (((n * q * k : ℕ) : ℤ) • f₀) =
            ((ell : ℕ) : ℤ) • (((n * a * k : ℕ) : ℤ) • f₀) := by
          rw [hqa]
          push_cast
          module
        rw [hshift]
        exact hp
      rw [hright] at hdilate
      have hleft : (∑ f ∈ F, setIndicator A
          (y + (((n * q * k : ℕ) : ℤ) • f₀) - (r : ℤ) • f)) =
          ∑ f ∈ F, setIndicator A
          (y - f - (((n * q * k : ℕ) : ℤ) • (f - f₀))) := by
        apply Finset.sum_congr rfl
        intro f _
        congr 1
        dsimp [r]
        module
      rw [hleft] at hdilate
      exact_mod_cast hdilate
    have haverageIdentity (N : ℕ) (y : Plane) :
        (∑ f ∈ F, slicingAverage q k N f f₀ A y) =
          ((tileConv F (setIndicator A) y : ℤ) : ℝ) := by
      rw [show (∑ f ∈ F, slicingAverage q k N f f₀ A y) =
          ((N + 1 : ℕ) : ℝ)⁻¹ * ∑ n ∈ Finset.range (N + 1),
            ∑ f ∈ F, ((setIndicator A
              (y - f - (((n * q * k : ℕ) : ℤ) • (f - f₀))) : ℤ) : ℝ) by
        unfold slicingAverage
        rw [← Finset.mul_sum]
        congr 1
        exact Finset.sum_comm]
      simp_rw [hsample]
      simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
      field_simp
    let averageState : ℕ → (f : ↥F) → Plane → Set.Icc (0 : ℝ) 1 :=
      fun N f y ↦ ⟨slicingAverage q k N f f₀ A y,
        slicingAverage_mem_Icc q k N f f₀ A y⟩
    obtain ⟨limit, _, subsequence, hsubsequence, hlimit⟩ :=
      (SeqCompactSpace.isSeqCompact_univ.subseq_of_frequently_in
        (x := averageState) (Filter.Frequently.of_forall fun _ ↦ Set.mem_univ _))
    let φ : ↥F → Plane → ℝ := fun f y ↦ limit f y
    have havgTend (f : ↥F) (y : Plane) :
        Filter.Tendsto
          (fun N ↦ slicingAverage q k (subsequence N) f f₀ A y)
          Filter.atTop (nhds (φ f y)) := by
      have hpoint := (hlimit.apply_nhds f).apply_nhds y
      have hval := (continuous_subtype_val.tendsto (limit f y)).comp hpoint
      simpa [averageState, φ, Function.comp_def] using hval
    have hinvTend : Filter.Tendsto
        (fun N ↦ (((subsequence N + 1 : ℕ) : ℝ))⁻¹)
        Filter.atTop (nhds 0) := by
      have hsucc : Filter.Tendsto (fun N ↦ subsequence N + 1)
          Filter.atTop Filter.atTop := by
        have hstrict : StrictMono (fun N : ℕ ↦ subsequence N + 1) :=
          fun _ _ hlt ↦ Nat.add_lt_add_right (hsubsequence hlt) 1
        exact hstrict.tendsto_atTop
      exact tendsto_inv_atTop_zero.comp
        (tendsto_natCast_atTop_atTop.comp hsucc)
    have hφdirection (f : ↥F) :
        Function.Periodic (φ f)
          (((q * k : ℕ) : ℤ) • ((f : Plane) - f₀)) := by
      intro y
      have hdiffLimit := (havgTend f
        (y + (((q * k : ℕ) : ℤ) • ((f : Plane) - f₀)))).sub (havgTend f y)
      have hdiffZero : Filter.Tendsto
          (fun N ↦ slicingAverage q k (subsequence N) f f₀ A
              (y + (((q * k : ℕ) : ℤ) • ((f : Plane) - f₀))) -
            slicingAverage q k (subsequence N) f f₀ A y)
          Filter.atTop (nhds 0) := by
        rw [tendsto_zero_iff_norm_tendsto_zero]
        apply squeeze_zero
        · exact fun _ ↦ norm_nonneg _
        · intro N
          simpa [Real.norm_eq_abs] using
            slicingAverage_shift_bound q k (subsequence N) (f : Plane) f₀ A y
        · simpa only [Nat.cast_add, Nat.cast_one] using hinvTend
      have hzero := tendsto_nhds_unique hdiffLimit hdiffZero
      exact sub_eq_zero.mp hzero
    have hφlongitudinal (f : ↥F) :
        Function.Periodic (φ f) (((ell * k : ℕ) : ℤ) • h) := by
      intro y
      have havgEq (N : ℕ) : slicingAverage q k N f f₀ A
          (y + (((ell * k : ℕ) : ℤ) • h)) =
          slicingAverage q k N f f₀ A y := by
        unfold slicingAverage
        congr 1
        apply Finset.sum_congr rfl
        intro n _
        have hp := hAperiod
          (y - (f : Plane) - (((n * q * k : ℕ) : ℤ) • ((f : Plane) - f₀)))
        rw [show y + (((ell * k : ℕ) : ℤ) • h) - (f : Plane) -
              (((n * q * k : ℕ) : ℤ) • ((f : Plane) - f₀)) =
            (y - (f : Plane) - (((n * q * k : ℕ) : ℤ) • ((f : Plane) - f₀))) +
              (((ell * k : ℕ) : ℤ) • h) by abel]
        exact_mod_cast hp
      have htend := havgTend f (y + (((ell * k : ℕ) : ℤ) • h))
      rw [funext fun N ↦ havgEq (subsequence N)] at htend
      exact tendsto_nhds_unique htend (havgTend f y)
    have hlimitSum (y : Plane) :
        (∑ f : ↥F, φ f y) = ((tileConv F (setIndicator A) y : ℤ) : ℝ) := by
      have hsumTend : Filter.Tendsto
          (fun N ↦ ∑ f : ↥F,
            slicingAverage q k (subsequence N) f f₀ A y)
          Filter.atTop (nhds (∑ f : ↥F, φ f y)) := by
        exact tendsto_finsetSum Finset.univ fun f _ ↦ havgTend f y
      have hseq (N : ℕ) : (∑ f : ↥F,
          slicingAverage q k (subsequence N) f f₀ A y) =
          ((tileConv F (setIndicator A) y : ℤ) : ℝ) := by
        rw [← haverageIdentity (subsequence N) y]
        simpa [Finset.univ_eq_attach F] using
          (Finset.sum_attach F (fun f ↦ slicingAverage q k (subsequence N) f f₀ A y))
      have hconst : Filter.Tendsto
          (fun _N : ℕ ↦ ((tileConv F (setIndicator A) y : ℤ) : ℝ))
          Filter.atTop (nhds ((tileConv F (setIndicator A) y : ℤ) : ℝ)) :=
        tendsto_const_nhds
      rw [funext hseq] at hsumTend
      exact tendsto_nhds_unique hsumTend hconst
    have hφslice (f : ↥F) (hfS : (f : Plane) ∈ S) (y : Plane) :
        φ f y = ((setIndicator A (y - (f : Plane)) : ℤ) : ℝ) := by
      have hfCoset := (Finset.mem_filter.mp hfS).2
      have hf₀Coset := (Finset.mem_filter.mp hf₀).2
      have hdiffMem : (f : Plane) - f₀ ∈ directionSubgroup h := by
        have := (directionSubgroup h).sub_mem hfCoset hf₀Coset
        rw [show ((f : Plane) - x) - (f₀ - x) =
            (f : Plane) - f₀ by abel] at this
        exact this
      obtain ⟨c, hc⟩ := AddSubgroup.mem_zmultiples_iff.mp hdiffMem
      have havgConst (N : ℕ) : slicingAverage q k N f f₀ A y =
          ((setIndicator A (y - (f : Plane)) : ℤ) : ℝ) := by
        unfold slicingAverage
        have hterm (n : ℕ) : setIndicator A
            (y - (f : Plane) -
              (((n * q * k : ℕ) : ℤ) • ((f : Plane) - f₀))) =
            setIndicator A (y - (f : Plane)) := by
          have hp := (hAperiod.zsmul (-(n * a * c)))
          have hshift : (((n * q * k : ℕ) : ℤ) • ((f : Plane) - f₀)) =
              (n * a * c) • (((ell * k : ℕ) : ℤ) • h) := by
            rw [← hc, hqa]
            push_cast
            module
          rw [hshift]
          simpa [sub_eq_add_neg] using hp (y - (f : Plane))
        simp_rw [hterm]
        simp only [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
        field_simp
      have htend := havgTend f y
      rw [funext fun N ↦ havgConst (subsequence N)] at htend
      exact tendsto_nhds_unique htend tendsto_const_nhds
    have hwedgeOutside (f : ↥F) (hfS : (f : Plane) ∉ S) :
        wedge h ((f : Plane) - f₀) ≠ 0 := by
      intro hwedge
      have hdiffMem := mem_directionSubgroup_of_wedge_eq_zero hh hwedge
      apply hfS
      apply Finset.mem_filter.mpr
      refine ⟨f.property, ?_⟩
      have hf₀Coset := (Finset.mem_filter.mp hf₀).2
      have hmem := (directionSubgroup h).add_mem hdiffMem hf₀Coset
      change (f : Plane) - x ∈ directionSubgroup h
      rw [show ((f : Plane) - f₀) + (f₀ - x) =
          (f : Plane) - x by abel] at hmem
      exact hmem
    let M : ℕ := q * k * s
    have hφscalar (f : ↥F) (hfS : (f : Plane) ∉ S) :
        ScalarPeriodic M (φ f) := by
      intro y z
      have hwedge := hwedgeOutside f hfS
      have hdiv : Int.natAbs (wedge h ((f : Plane) - f₀)) ∣ s := by
        apply wedge_difference_dvd_slicingLCM f.property hf₀F hwedge
      have hmem := scalar_smul_mem_generated_of_wedge_dvd
        (ell := ell) (q := q) (k := k) (s := s) (h := h)
        (d := (f : Plane) - f₀) (by simp [hqa]) hwedge hdiv z
      let periods : AddSubgroup Plane := {
        carrier := {p | Function.Periodic (φ f) p}
        zero_mem' := Function.periodic_with_period_zero (φ f)
        add_mem' hp hp' := hp.add_period hp'
        neg_mem' hp := hp.neg
      }
      have hgenerated : generatedPair (((ell * k : ℕ) : ℤ) • h)
          (((q * k : ℕ) : ℤ) • ((f : Plane) - f₀)) ≤ periods := by
        rw [generatedPair, AddSubgroup.closure_le]
        intro p hp
        rcases hp with (rfl | rfl)
        · exact hφlongitudinal f
        · exact hφdirection f
      exact hgenerated hmem y
    let outside : Finset ↥F := Finset.univ.filter fun f ↦ (f : Plane) ∉ S
    let outsideSum : Plane → ℝ := fun y ↦ ∑ f ∈ outside, φ f y
    have houtsidePeriod : ScalarPeriodic M outsideSum := by
      intro y z
      unfold outsideSum
      apply Finset.sum_congr rfl
      intro f hf
      exact hφscalar f (by simpa [outside] using hf) y z
    have htotalPeriod : ScalarPeriodic M
        (fun y ↦ ((tileConv F (setIndicator A) y : ℤ) : ℝ)) := by
      intro y z
      have hp := hconvperiod y (((a * k * s : ℕ) : ℤ) • z)
      change ((tileConv F (setIndicator A)
        (y + ((M : ℕ) : ℤ) • z) : ℤ) : ℝ) = _
      apply congrArg (fun t : ℤ ↦ (t : ℝ))
      have hshift : ((M : ℕ) : ℤ) • z =
          ((ell : ℕ) : ℤ) • (((a * k * s : ℕ) : ℤ) • z) := by
        dsimp [M]
        rw [hqa]
        push_cast
        module
      rw [hshift]
      exact hp
    have hsliceRelation (y : Plane) :
        ((tileConv S (setIndicator A) y : ℤ) : ℝ) =
          ((tileConv F (setIndicator A) y : ℤ) : ℝ) - outsideSum y := by
      rw [← hlimitSum y]
      unfold tileConv outsideSum outside
      push_cast
      have hpartition := Finset.sum_filter_add_sum_filter_not
        (Finset.univ : Finset ↥F) (fun f : ↥F ↦ (f : Plane) ∈ S) (fun f ↦ φ f y)
      rw [← hpartition, add_sub_cancel_right]
      apply Finset.sum_bij
          (fun f hf ↦ (⟨f, (Finset.mem_filter.mp hf).1⟩ : ↥F))
      · intro f hf
        simp only [Finset.mem_filter, Finset.mem_univ, true_and]
        exact hf
      · intro f₁ hf₁ f₂ hf₂ heq
        exact congrArg Subtype.val heq
      · intro f hf
        refine ⟨(f : Plane), ?_, ?_⟩
        · exact (Finset.mem_filter.mp hf).2
        · rfl
      · intro f hf
        exact (hφslice ⟨f, (Finset.mem_filter.mp hf).1⟩ hf y).symm
    intro y z
    apply (Int.cast_injective (α := ℝ))
    change ((tileConv S (setIndicator A)
      (y + ((M : ℕ) : ℤ) • z) : ℤ) : ℝ) = _
    rw [hsliceRelation, hsliceRelation]
    have ht := htotalPeriod y z
    have ho := houtsidePeriod y z
    change ((tileConv F (setIndicator A) (y + ((M : ℕ) : ℤ) • z) : ℤ) : ℝ) =
      ((tileConv F (setIndicator A) y : ℤ) : ℝ) at ht
    change outsideSum (y + ((M : ℕ) : ℤ) • z) = outsideSum y at ho
    rw [ht, ho]
  · have hSempt : S = ∅ := Finset.not_nonempty_iff_eq_empty.mp hS
    rw [show tileSlice F h x = ∅ by simpa [S] using hSempt]
    intro y z
    simp [tileConv]

private def lineQuotientMap (h : Plane) :
    Plane →+ Plane ⧸ directionSubgroup h :=
  QuotientAddGroup.mk' (directionSubgroup h)

private def lineShiftSubgroup (M : ℕ) (h : Plane) :
    AddSubgroup (Plane ⧸ directionSubgroup h) :=
  (scalarLattice M).map (lineQuotientMap h)

private noncomputable def lineOrbitBaseOfClass (M : ℕ) (h : Plane)
    (c : (Plane ⧸ directionSubgroup h) ⧸ lineShiftSubgroup M h) :
    Plane ⧸ directionSubgroup h :=
  Classical.choose (QuotientAddGroup.mk'_surjective (lineShiftSubgroup M h) c)

private noncomputable def lineOrbitBase (M : ℕ) (h : Plane)
    (line : Plane ⧸ directionSubgroup h) : Plane ⧸ directionSubgroup h :=
  lineOrbitBaseOfClass M h
    (QuotientAddGroup.mk' (lineShiftSubgroup M h) line)

private theorem lineOrbitBase_spec (M : ℕ) (h : Plane)
    (line : Plane ⧸ directionSubgroup h) :
    QuotientAddGroup.mk' (lineShiftSubgroup M h) (lineOrbitBase M h line) =
      QuotientAddGroup.mk' (lineShiftSubgroup M h) line :=
  Classical.choose_spec (QuotientAddGroup.mk'_surjective (lineShiftSubgroup M h)
    (QuotientAddGroup.mk' (lineShiftSubgroup M h) line))

private theorem exists_lineShift (M : ℕ) (h : Plane)
    (line : Plane ⧸ directionSubgroup h) :
    ∃ t : Plane, t ∈ scalarLattice M ∧
      lineQuotientMap h t = line - lineOrbitBase M h line := by
  have hmem : line - lineOrbitBase M h line ∈ lineShiftSubgroup M h := by
    exact QuotientAddGroup.eq_iff_sub_mem.mp (lineOrbitBase_spec M h line).symm
  exact AddSubgroup.mem_map.mp (by simpa [lineShiftSubgroup] using hmem)

private noncomputable def lineShift (M : ℕ) (h : Plane)
    (line : Plane ⧸ directionSubgroup h) : Plane :=
  Classical.choose (exists_lineShift M h line)

private theorem lineShift_mem_scalarLattice (M : ℕ) (h : Plane)
    (line : Plane ⧸ directionSubgroup h) :
    lineShift M h line ∈ scalarLattice M :=
  (Classical.choose_spec (exists_lineShift M h line)).1

private theorem lineShift_spec (M : ℕ) (h : Plane)
    (line : Plane ⧸ directionSubgroup h) :
    lineQuotientMap h (lineShift M h line) =
      line - lineOrbitBase M h line :=
  (Classical.choose_spec (exists_lineShift M h line)).2

private theorem scalar_direction_intersection {M : ℕ} {h t : Plane}
    (hh : IsPrimitive h) (htScalar : t ∈ scalarLattice M)
    (htDirection : t ∈ directionSubgroup h) :
    ∃ c : ℤ, t = c • (((M : ℕ) : ℤ) • h) := by
  obtain ⟨z, hz⟩ := htScalar
  obtain ⟨c, hc⟩ := AddSubgroup.mem_zmultiples_iff.mp htDirection
  have hgcd : Int.gcd (h 0) (h 1) = 1 := by
    have hcontent := hh.2
    rw [vectorContent,
      show (Finset.univ : Finset (Fin 2)) = {0, 1} by decide] at hcontent
    simp only [Finset.gcd_insert, Finset.gcd_singleton, normalize_eq,
      gcd_eq_nat_gcd] at hcontent
    simpa only [Nat.gcd_zero_left, Int.gcd_eq_natAbs] using hcontent
  have hbezout : (1 : ℤ) =
      h 0 * Int.gcdA (h 0) (h 1) + h 1 * Int.gcdB (h 0) (h 1) := by
    rw [← Int.gcd_eq_gcd_ab, hgcd]
    norm_num
  let b : ℤ := z 0 * Int.gcdA (h 0) (h 1) +
    z 1 * Int.gcdB (h 0) (h 1)
  refine ⟨b, ?_⟩
  rw [← hc] at hz ⊢
  have hz0 := congrFun hz 0
  have hz1 := congrFun hz 1
  change (M : ℤ) * z 0 = c * h 0 at hz0
  change (M : ℤ) * z 1 = c * h 1 at hz1
  have hcb : c = (M : ℤ) * b := by
    dsimp [b]
    linear_combination c * hbezout -
      Int.gcdA (h 0) (h 1) * hz0 - Int.gcdB (h 0) (h 1) * hz1
  rw [hcb]
  module

private noncomputable def improvedSet (M : ℕ) (h : Plane) (A : Set Plane) : Set Plane :=
  {y | y - lineShift M h (lineQuotientMap h y) ∈ A}

private noncomputable def lineRepresentative (h : Plane)
    (line : Plane ⧸ directionSubgroup h) : Plane :=
  Classical.choose (QuotientAddGroup.mk'_surjective (directionSubgroup h) line)

private theorem lineRepresentative_spec (h : Plane)
    (line : Plane ⧸ directionSubgroup h) :
    lineQuotientMap h (lineRepresentative h line) = line :=
  Classical.choose_spec (QuotientAddGroup.mk'_surjective (directionSubgroup h) line)

private theorem setIndicator_eq_iff_membership {G : Type*} (A : Set G) (u v : G) :
    setIndicator A u = setIndicator A v ↔ (u ∈ A ↔ v ∈ A) := by
  by_cases hu : u ∈ A <;> by_cases hv : v ∈ A <;>
    simp [setIndicator, hu, hv]

/-- Greenfeld--Tao, Corollary 5.3. -/
theorem improve_onePeriodic
    {F : Finset Plane} {A : Set Plane} {ell k : ℕ} {h : Plane}
    (hell : 0 < ell) (hk : 0 < k) (hh : IsPrimitive h)
    (hAperiod : Function.Periodic (setIndicator A)
      (((ell * k : ℕ) : ℤ) • h))
    (hconvperiod : ScalarPeriodic ell (tileConv F (setIndicator A))) :
    ∃ A' : Set Plane,
      SetScalarPeriodic
        (indicatorDilationModulus ell F.card * k * slicingLCM F h) A' ∧
      convolutionEquivalent F A A' ∧
      ∀ line : Plane ⧸ directionSubgroup h,
        convolutionEquivalent F (slicePattern h line A)
          (slicePattern h line A') := by
  classical
  let q := indicatorDilationModulus ell F.card
  let s := slicingLCM F h
  let M := q * k * s
  have hellq : ell ∣ q := ell_dvd_dilationModulus ell 1 F.card
  obtain ⟨a, hqa⟩ := hellq
  let A' := improvedSet M h A
  have hA'scalar : SetScalarPeriodic M A' := by
    intro y z
    let t : Plane := ((M : ℕ) : ℤ) • z
    let line₀ := lineQuotientMap h y
    let line₁ := lineQuotientMap h (y + t)
    have htScalar : t ∈ scalarLattice M := ⟨z, rfl⟩
    have hlineSub : line₁ - line₀ = lineQuotientMap h t := by
      simp [line₀, line₁, map_add]
    have hlineMapMem : lineQuotientMap h t ∈ lineShiftSubgroup M h := by
      exact AddSubgroup.mem_map.mpr ⟨t, htScalar, rfl⟩
    have horbitEq : QuotientAddGroup.mk' (lineShiftSubgroup M h) line₁ =
        QuotientAddGroup.mk' (lineShiftSubgroup M h) line₀ := by
      apply QuotientAddGroup.eq_iff_sub_mem.mpr
      rw [hlineSub]
      exact hlineMapMem
    have hbaseEq : lineOrbitBase M h line₁ = lineOrbitBase M h line₀ := by
      exact congrArg (lineOrbitBaseOfClass M h) horbitEq
    let shift₀ := lineShift M h line₀
    let shift₁ := lineShift M h line₁
    let δ : Plane := shift₁ - shift₀ - t
    have hδScalar : δ ∈ scalarLattice M := by
      exact (scalarLattice M).sub_mem
        ((scalarLattice M).sub_mem
          (lineShift_mem_scalarLattice M h line₁)
          (lineShift_mem_scalarLattice M h line₀)) htScalar
    have hδDirection : δ ∈ directionSubgroup h := by
      rw [← QuotientAddGroup.eq_zero_iff]
      change lineQuotientMap h δ = 0
      simp only [δ, map_sub]
      rw [lineShift_spec, lineShift_spec, hbaseEq, ← hlineSub]
      abel
    obtain ⟨c, hδ⟩ := scalar_direction_intersection hh hδScalar hδDirection
    have hMperiod : ((M : ℕ) : ℤ) • h =
        (a * s : ℤ) • (((ell * k : ℕ) : ℤ) • h) := by
      dsimp [M]
      rw [hqa]
      push_cast
      module
    have hδperiod : Function.Periodic (setIndicator A) δ := by
      rw [hδ, hMperiod]
      simpa only [mul_smul] using hAperiod.zsmul (c * (a * s))
    change y + ((M : ℕ) : ℤ) • z ∈ A' ↔ y ∈ A'
    change y + t - shift₁ ∈ A ↔ y - shift₀ ∈ A
    have harg : y + t - shift₁ = (y - shift₀) - δ := by
      dsimp [δ]
      abel
    rw [harg]
    exact (setIndicator_eq_iff_membership A _ _).mp
      (hδperiod.sub_eq (y - shift₀))
  have hsliceEquivalent (line : Plane ⧸ directionSubgroup h) :
      convolutionEquivalent F (slicePattern h line A) (slicePattern h line A') := by
    funext y
    let selected : Finset Plane := F.filter fun f ↦ lineQuotientMap h (y - f) = line
    let representative := lineRepresentative h line
    have hselectedTile : selected = tileSlice F h (y - representative) := by
      ext f
      simp only [selected, Finset.mem_filter, tileSlice]
      constructor
      · rintro ⟨hf, hline⟩
        refine ⟨hf, ?_⟩
        change f - (y - representative) ∈ directionSubgroup h
        have hquot : lineQuotientMap h (y - f) =
            lineQuotientMap h representative := by
          rw [hline, lineRepresentative_spec]
        have hmem := QuotientAddGroup.eq_iff_sub_mem.mp hquot
        have hneg := (directionSubgroup h).neg_mem hmem
        simpa only [show f - (y - representative) =
            -(y - f - representative) by abel] using hneg
      · intro hf
        obtain ⟨hfF, hfCoset⟩ := hf
        refine ⟨hfF, ?_⟩
        rw [← lineRepresentative_spec h line]
        apply QuotientAddGroup.eq_iff_sub_mem.mpr
        change (y - f) - representative ∈ directionSubgroup h
        have hneg := (directionSubgroup h).neg_mem hfCoset
        simpa only [show (y - f) - representative =
            -(f - (y - representative)) by abel] using hneg
    have hleft : tileConv F (setIndicator (slicePattern h line A)) y =
        tileConv selected (setIndicator A) y := by
      unfold tileConv
      dsimp only [selected]
      rw [Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro f hf
      by_cases hline : lineQuotientMap h (y - f) = line
      · rw [if_pos hline]
        by_cases hmem : y - f ∈ A
        · have hslice : y - f ∈ slicePattern h line A :=
            (mem_slicePattern (y - f)).2 ⟨hmem, hline⟩
          simp only [setIndicator, Set.indicator_of_mem hmem,
            Set.indicator_of_mem hslice]
        · have hslice : y - f ∉ slicePattern h line A := fun hy ↦
            hmem ((mem_slicePattern (y - f)).1 hy).1
          simp only [setIndicator, Set.indicator_of_notMem hmem,
            Set.indicator_of_notMem hslice]
      · rw [if_neg hline]
        have hslice : y - f ∉ slicePattern h line A := fun hy ↦
          hline ((mem_slicePattern (y - f)).1 hy).2
        simp only [setIndicator, Set.indicator_of_notMem hslice]
    let t := lineShift M h line
    have htScalar := lineShift_mem_scalarLattice M h line
    obtain ⟨zt, hzt⟩ := htScalar
    have hterm (f : Plane) (hf : f ∈ selected) :
        setIndicator A' (y - f) = setIndicator A (y - t - f) := by
      have hline : lineQuotientMap h (y - f) = line :=
        (Finset.mem_filter.mp hf).2
      unfold A' improvedSet
      apply (setIndicator_eq_iff_membership A _ _).2
      change y - f - lineShift M h (lineQuotientMap h (y - f)) ∈ A ↔
        y - t - f ∈ A
      rw [hline]
      dsimp [t]
      abel_nf
    have hright : tileConv F (setIndicator (slicePattern h line A')) y =
        tileConv selected (setIndicator A) (y - t) := by
      unfold tileConv
      dsimp only [selected]
      rw [Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro f hf
      by_cases hline : lineQuotientMap h (y - f) = line
      · have hfSelected : f ∈ selected := Finset.mem_filter.mpr ⟨hf, hline⟩
        rw [if_pos hline]
        have hsliceIndicator :
            setIndicator (slicePattern h line A') (y - f) =
              setIndicator A' (y - f) := by
          by_cases hmem : y - f ∈ A'
          · have hslice : y - f ∈ slicePattern h line A' :=
              (mem_slicePattern (y - f)).2 ⟨hmem, hline⟩
            simp only [setIndicator, Set.indicator_of_mem hmem,
              Set.indicator_of_mem hslice]
          · have hslice : y - f ∉ slicePattern h line A' := fun hy ↦
              hmem ((mem_slicePattern (y - f)).1 hy).1
            simp only [setIndicator, Set.indicator_of_notMem hmem,
              Set.indicator_of_notMem hslice]
        exact hsliceIndicator.trans (hterm f hfSelected)
      · rw [if_neg hline]
        have hslice : y - f ∉ slicePattern h line A' := fun hy ↦
          hline ((mem_slicePattern (y - f)).1 hy).2
        simp only [setIndicator, Set.indicator_of_notMem hslice]
    have hselectedPeriod : ScalarPeriodic M
        (tileConv selected (setIndicator A)) := by
      rw [hselectedTile]
      exact slicing_lemma hell hk hh hAperiod hconvperiod
    have hp := hselectedPeriod (y - t) zt
    have ht : ((M : ℕ) : ℤ) • zt = t := hzt
    rw [ht, sub_add_cancel] at hp
    rw [hleft, hright, hp]
  have hwholeEquivalent : convolutionEquivalent F A A' := by
    funext y
    let lines : Finset (Plane ⧸ directionSubgroup h) :=
      F.image fun f ↦ lineQuotientMap h (y - f)
    have hsumSlices (B : Set Plane) : tileConv F (setIndicator B) y =
        ∑ line ∈ lines, tileConv F (setIndicator (slicePattern h line B)) y := by
      unfold tileConv
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro f hf
      rw [Finset.sum_eq_single (lineQuotientMap h (y - f))]
      · have hsliceIndicator :
            setIndicator (slicePattern h (lineQuotientMap h (y - f)) B) (y - f) =
              setIndicator B (y - f) := by
          by_cases hmem : y - f ∈ B
          · have hslice : y - f ∈
                slicePattern h (lineQuotientMap h (y - f)) B :=
              (mem_slicePattern (y - f)).2 ⟨hmem, rfl⟩
            simp only [setIndicator, Set.indicator_of_mem hmem,
              Set.indicator_of_mem hslice]
          · have hslice : y - f ∉
                slicePattern h (lineQuotientMap h (y - f)) B := fun hy ↦
              hmem ((mem_slicePattern (y - f)).1 hy).1
            simp only [setIndicator, Set.indicator_of_notMem hmem,
              Set.indicator_of_notMem hslice]
        exact hsliceIndicator.symm
      · intro line hline hne
        have hnotSlice : y - f ∉ slicePattern h line B := fun hy ↦
          hne ((mem_slicePattern (y - f)).1 hy).2.symm
        simp only [setIndicator, Set.indicator_of_notMem hnotSlice]
      · intro hnot
        exact (hnot (Finset.mem_image.mpr ⟨f, hf, rfl⟩)).elim
    rw [hsumSlices A, hsumSlices A']
    apply Finset.sum_congr rfl
    intro line _
    exact congrFun (hsliceEquivalent line) y
  refine ⟨A', ?_, hwholeEquivalent, hsliceEquivalent⟩
  simpa [M, q, s] using hA'scalar

/-- A periodic Boolean pattern on a one-dimensional residue cycle. -/
abbrev LinePattern (period : ℕ) := Fin period → Bool

/-- The integer set encoded by a positive-period Boolean line pattern. -/
def linePatternSetOfPos (period : ℕ) (hperiod : 0 < period)
    (P : LinePattern period) : Set ℤ :=
  {n | P ⟨n.natMod period, Int.natMod_lt hperiod.ne'⟩}

end TranslationalTilings
